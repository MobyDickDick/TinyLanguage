// Demonstration of product and sum types with match expressions
type Point = product { x: Number; y: Number; }
type Shape = sum {
  def unused1 = Circle(radius: Number);
  def unused2 = Rect(width: Number, height: Number);
  Unit;
}

fn describe(shape) {
  return match(shape) {
    case Circle(r) => 3 * r * r;
    case Rect(w, h) => w * h;
    case _ => 0;
  };
}

def p = Point(3, 4);
def s1 = Circle(2);
def s2 = Rect(2, 5);
def s3 = Unit();

print(p.x);
print(describe(s1));
print(describe(s2));
print(describe(s3));
