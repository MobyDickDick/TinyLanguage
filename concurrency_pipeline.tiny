// Demonstrates how to poll spawned work without blocking the main loop
// by using the timeout-enabled join API.

fn uppercase(text) {
    define i = 0;
    while (i < 20000) { i = i + 1; }
    return String.upper(text);
}

fn token_count(text) {
    define i = 0;
    while (i < 20000) { i = i + 1; }
    return len(String.split(text, " "));
}

// Kick off independent tasks.
define headline = "Tiny language concurrency demo";
define upper_task = spawn uppercase(headline);
define count_task = spawn token_count(headline);

// Non-blocking check for the first task.
define status = join(upper_task, 0);
print("uppercase ready?", status.done, status.cancelled);

// Await both tasks.
define upper = join(upper_task);
define words = join(count_task);
print("results", upper, words);

// Output:
// uppercase ready? false false
// results TINY LANGUAGE CONCURRENCY DEMO 4
