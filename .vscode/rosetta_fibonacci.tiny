// Rosetta Code: Fibonacci sequence
// Prints the first 10 Fibonacci numbers.

define n = 10;
define i = 0;
define a = 0;
define b = 1;

while (i < n) {
    print(a);
    define e = fflush();
    if(e != Null){
        define next = a + b;
        a = b;
        b = next;
        i = i + 1;
    }else{
        i = n;
    }
}
