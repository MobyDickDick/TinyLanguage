// Rosetta Code: word frequency counter ported from Python to TinyLanguage
// Demonstrates String.split, String.lower, Map.new/get/set, and heap iteration.
// Run with: python src/tiny_language.py src_tiny/rosetta_word_count.tiny

fn word_counts(text) {
    def normalized = String.lower(text);
    def words = String.split(normalized, " ");
    def counts = Map.new();

    def index = 0;
    def total = len(words);
    while (index < total) {
        def word = heap_get(words, index);
        def seen = Map.get(counts, word, 0);
        Map.set(counts, word, seen + 1);
        index = index + 1;
    }

    return counts;
}

def counts = word_counts("To be or not to be");
print("unique words", Map.len(counts));

def keys = Map.keys(counts);

def i = 0;
while (i < len(keys)) {
    def word = heap_get(keys, i);
    def freq = Map.get(counts, word, 0);
    print(word, freq);
    i = i + 1;
}
