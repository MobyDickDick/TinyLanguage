// structured_concurrency_demo.tiny - task scopes + cancellation tokens.

fn busy_wait(steps) {
    def i = 0;
    while (i < steps) {
        i = i + 1;
    }
}

async fn async_work(label, steps) {
    busy_wait(steps);
    return label + ":async";
}

fn run_work(label, steps) {
    busy_wait(steps);
    return label + ":complete";
}

fn spin_until_cancel(token, label, limit) {
    def i = 0;
    while (i < limit) {
        if (Async.is_cancelled(token)) {
            def reason = Async.reason(token);
            if (reason == Null) {
                reason = "no-reason";
            }
            return label + ":cancelled:" + reason;
        }
        i = i + 1;
    }
    return label + ":complete";
}

fn fail_fast() {
    // Trigger a join error to showcase error metadata in JoinStatus.
    return join(Null);
}

fn send_value(chan, value) {
    return Async.send(chan, value);
}

fn recv_value(chan) {
    return Async.recv(chan);
}

fn print_status(label, status) {
    print(
        label,
        status.__tag__,
        "done",
        status.done,
        "cancelled",
        status.cancelled,
        "error",
        status.error,
        "result",
        status.result,
    );
}

fn cancel_handle(handle) {
    def cancelled = cancel(handle);
    print("manual cancel", cancelled);
    return cancelled;
}

// Task blocks automatically join outstanding handles on scope exit with a
// timeout (see TINYLANG_TASK_SCOPE_TIMEOUT_MS). Join also supports a
// cancel-on-timeout flag for scoped status checks. The status map includes
// metadata fields (done/cancelled/error/result + __tag__).
// This demo links spawned handles to a token and cancels it explicitly, plus
// it leaves one long-running handle unlinked so the scope auto-join path can
// cancel it on timeout.

print("structured concurrency demo");

def scoped_handle = Null;
def scope_timeout_handle = Null;

task {
    def token = Async.token();
    def chan = Async.channel(1);

    def short_task = spawn spin_until_cancel(token, "short", 20000);
    def long_task = spawn spin_until_cancel(token, "long", 2000000);
    def fail_task = spawn fail_fast();
    // Leave this handle unlinked to show that task scopes track all spawned
    // handles, not just those linked to a cancellation token.
    def scope_timeout_task = spawn run_work("scope-timeout", 4000000);
    def send_task = spawn send_value(chan, "ping");
    def recv_task = spawn recv_value(chan);
    def manual_task = spawn spin_until_cancel(token, "manual", 5000000);

    def short_linked = Async.link(token, short_task);
    def long_linked = Async.link(token, long_task);
    def short_linked_again = Async.link(token, short_task);
    print("links", short_linked, long_linked, short_linked_again);

    busy_wait(50000);

    def short_status = join(short_task, 0);
    print_status("short status", short_status);

    def short_done = join(short_task);
    print_status("short done", short_done);

    def long_status = join(long_task, 1);
    print_status("long status", long_status);

    def long_cancel = join(long_task, 1, true);
    print_status("long cancel", long_cancel);

    def manual_cancelled = cancel_handle(manual_task);
    print("manual cancel state", manual_cancelled);
    def manual_status = join(manual_task, 10);
    print_status("manual status", manual_status);

    def fail_status = join(fail_task, 10);
    print_status("fail status", fail_status);

    def send_status = join(send_task, 10);
    print_status("channel send", send_status);

    def recv_status = join(recv_task, 10);
    print_status("channel recv", recv_status);

    def channel_closed = Async.close(chan);
    def channel_closed_again = Async.close(chan);
    print("channel closed", channel_closed, channel_closed_again, Async.recv(chan));

    def async_handle = async_work("async", 20000);
    def async_snapshot = join(async_handle, 0);
    print_status("async snapshot", async_snapshot);
    def async_result = await async_handle;
    print("async result", async_result);

    def cancelled = Async.cancel(token, "demo scope exit");
    def cancelled_again = Async.cancel(token, "ignored");
    print("token", cancelled, cancelled_again, Async.is_cancelled(token), Async.reason(token));

    def late_task = spawn spin_until_cancel(token, "late", 20000);
    def late_linked = Async.link(token, late_task);
    print("late link", late_linked);
    def late_status = join(late_task, 10);
    print_status("late status", late_status);

    def long_final = join(long_task, 50);
    print_status("long final", long_final);

    def short_final = join(short_task, 50);
    print_status("short final", short_final);

    scoped_handle = spawn spin_until_cancel(token, "scope", 5000000);
    def _unused3 = Async.link(token, scoped_handle);
    def scoped_status = join(scoped_handle, 0);
    print_status("scope snapshot", scoped_status);

    scope_timeout_handle = scope_timeout_task;
    def scope_timeout_snapshot = join(scope_timeout_task, 0);
    print_status("scope timeout snapshot", scope_timeout_snapshot);
}

def scope_exit_status = join(scoped_handle, 0);
print_status("scope exit", scope_exit_status);

def scope_timeout_status = join(scope_timeout_handle, 50);
print_status("scope timeout exit", scope_timeout_status);
