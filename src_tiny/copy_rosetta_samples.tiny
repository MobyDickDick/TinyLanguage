// TinyLanguage translation of examples/rosetta/copy_rosetta_samples.py
// Run with: python src/tiny_language.py src_tiny/from_python/copy_rosetta_samples.tiny DEST [--source DIR] [--limit N] [--delay SECONDS]

// Python helpers
def os = Python.import_module("os", new["makedirs"]);
def os_path = Python.import_module("os.path", new["abspath", "join", "exists", "basename", "splitext"]);
def glob = Python.import_module("glob", new["glob"]);
def shutil = Python.import_module("shutil", new["copy2"]);
def time = Python.import_module("time", new["sleep"]);
def sys = Python.import_module("sys", new["argv"]);
def builtins = Python.import_module("builtins", new["list", "set", "sorted", "len", "int", "float"]);
def import_refs = new[shutil, time, os, os_path, glob]; // mark Python helpers as used for the linter

fn list_missing(source_dir, dest_dir) {
    def source_files = builtins.list(glob.glob(os_path.join(source_dir, "*.py")));
    def dest_files = builtins.list(glob.glob(os_path.join(dest_dir, "*.py")));
    def dest_stems = Set.new();

    def i = 0;
    while (i < builtins.len(dest_files)) {
        def path = heap_get(dest_files, i);
        def stem = heap_get(os_path.splitext(os_path.basename(path)), 0);
        def added_dest = Set.add(dest_stems, stem);
        i = i + 1;
    }

    def missing = builtins.list();
    i = 0;
    while (i < builtins.len(source_files)) {
        def path = heap_get(source_files, i);
        def stem = heap_get(os_path.splitext(os_path.basename(path)), 0);
        if (!Set.has(dest_stems, stem)) {
            Collections.push(missing, path);
        }
        i = i + 1;
    }

    return builtins.sorted(missing);
}

fn copy_batch(files, dest_dir, limit, delay) {
    def total = builtins.len(files);
    def end = limit;
    if (end > total) { end = total; }

    def copied = builtins.list();
    def idx = 0;
    while (idx < end) {
        def source_path = heap_get(files, idx);
        def destination = os_path.join(dest_dir, os_path.basename(source_path));
        def copy_result = shutil.copy2(source_path, destination);
        print("copied", os_path.basename(source_path), "->", destination);
        Collections.push(copied, source_path);

        if (idx + 1 < end) { def unused2 = time.sleep(delay); }
        idx = idx + 1;
    }

    return copied;
}

fn parse_args() {
    def argv = sys.argv;
    def argc = builtins.len(argv);

    if (argc < 2) {
        print("Usage: copy_rosetta_samples.tiny DEST [--source DIR] [--limit N] [--delay SECONDS]");
        return Map.new();
    }

    def root = os_path.abspath(".");
    def defaults = Map.from_entries(new[
        new["source", os_path.join(root, "examples", "rosetta", "python")],
        new["limit", 10],
        new["delay", 10.0]
    ]);

    def options = Map.new();
    def set_dest = Map.set(options, "dest", os_path.abspath(heap_get(argv, 1)));
    def set_source = Map.set(options, "source", Map.get(defaults, "source"));
    def set_limit = Map.set(options, "limit", Map.get(defaults, "limit"));
    def set_delay = Map.set(options, "delay", Map.get(defaults, "delay"));

    def index = 2;
    while (index < argc) {
        def flag = heap_get(argv, index);
        if (flag == "--source" && index + 1 < argc) {
            def updated_source = Map.set(options, "source", os_path.abspath(heap_get(argv, index + 1)));
            index = index + 2;
        } else {
            if (flag == "--limit" && index + 1 < argc) {
                def updated_limit = Map.set(options, "limit", builtins.int(heap_get(argv, index + 1)));
                index = index + 2;
            } else {
                if (flag == "--delay" && index + 1 < argc) {
                    def updated_delay = Map.set(options, "delay", builtins.float(heap_get(argv, index + 1)));
                    index = index + 2;
                } else {
                    print("Ignoring unknown or incomplete flag:", flag);
                    index = index + 1;
                }
            }
        }
    }

    return options;
}

fn main() {
    def args = parse_args();
    if (Map.len(args) == 0) { return 1; }

    def dest = Map.get(args, "dest");
    def source = Map.get(args, "source");
    def limit = Map.get(args, "limit");
    def delay = Map.get(args, "delay");

    if (!os_path.exists(source)) {
        print("source directory does not exist:", source);
        return 1;
    }

    if (!os_path.exists(dest)) { def created_dest = os.makedirs(dest); }
    def missing = list_missing(source, dest);

    if (builtins.len(missing) == 0) {
        print("No missing Python scripts detected; nothing to copy.");
        return 0;
    }

    def copied = copy_batch(missing, dest, limit, delay);
    def remaining = builtins.len(missing) - builtins.len(copied);
    print("Copied", builtins.len(copied), "file(s);", remaining, "still missing.");
    return 0;
}

def unused7 = main();
