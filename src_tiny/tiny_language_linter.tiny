// TinyLanguage port of the linter from src/tiny_language_linter.py.
// Covers must-use rules, type changes, return exhaustiveness, and
// import/destructuring checks. Error messages mirror the Python
// version (including error codes) as closely as possible.

// ===========================================================================
// TINY LANGUAGE LINTER (Tiny implementation)
// ===========================================================================
// OVERVIEW
//   This file is a TinyLanguage-native port of the Python linter. It runs as
//   part of the toolchain to enforce project-wide rules and to provide clear,
//   testable diagnostics (including stable error codes).
//
//   The linter focuses on a few strong guarantees that keep Tiny programs
//   easy to reason about and friendly to compilation targets:
//     - 'Must-use' discipline for bindings, parameters, and call results
//     - Basic type-change warnings (developer feedback, not a full type system)
//     - Return correctness (signatures + exhaustiveness across branches)
//     - Import and destructuring checks
//
// IMPORTANT CONVENTIONS
//   - Names starting with '_' are treated as intentionally unused in many rules.
//   - Some checks perform simple control-flow path analysis by tracking multiple
//     'usage states' and merging them at join points.
//   - Diagnostics aim to mirror the Python reference implementation closely.
//
// RUNTIME / INTEROP NOTES
//   This file uses stdlib namespaces such as Map/Set/Deque/Collections and
//   Python interop for small helpers (e.g. stable repr/str behavior).
//   These calls are guarded by allowlists to keep the interop surface explicit.
// ===========================================================================

def PY_REPR_ALLOW = new["repr"];
def PY_EXEC_ALLOW = new["exec"];
def PY_STR_ALLOW = new["str"];
def PY_LIST_ALLOW = new["list"];
def PY_LINT_ALLOW = new["_lint_message"];

// ---------------------------------------------------------------------------
// __starts_with(text, prefix)
// ---------------------------------------------------------------------------
// Return true iff `text` starts with `prefix`.
//
// Implementation: uses Python interop (`builtins.list`) to compare characters, because TinyLanguage does not (yet) expose a direct slice/prefix primitive.
//
// Args:
//   - text: (Tiny value) See implementation for expected shape.
//   - prefix: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn __starts_with(text, prefix) {
    if (text == Null || prefix == Null) { return false; }
    def text_chars = Python.call("builtins", "list", new[text], PY_LIST_ALLOW);
    def prefix_chars = Python.call("builtins", "list", new[prefix], PY_LIST_ALLOW);
    if (len(prefix_chars) > len(text_chars)) { return false; }
    def i = 0;
    while (i < len(prefix_chars)) {
        if (heap_get(prefix_chars, i) != heap_get(text_chars, i)) { return false; }
        i = i + 1;
    }
    return true;
}

// ---------------------------------------------------------------------------
// __raise_runtime_error(msg)
// ---------------------------------------------------------------------------
// Abort linting by raising a runtime error.
//
// The linter is often used as a pre-flight check; failing fast is acceptable and keeps error messages close to the Python reference implementation.
//
// Args:
//   - msg: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn __raise_runtime_error(msg) {
    def safe = Python.call("builtins", "repr", new[msg], PY_REPR_ALLOW);
    def stmt = "raise RuntimeError(" + safe + ")";
    // Return value is irrelevant — the call raises an exception.
    return Python.call("builtins", "exec", new[stmt], PY_EXEC_ALLOW);
}

// ---------------------------------------------------------------------------
// __to_str(value)
// ---------------------------------------------------------------------------
// Convert an arbitrary value to a string for diagnostics.
//
// Uses a conservative conversion strategy so messages are stable and predictable across backends.
//
// Args:
//   - value: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn __to_str(value) {
    return Python.call("builtins", "str", new[value], PY_STR_ALLOW);
}

// ---------------------------------------------------------------------------
// __sorted_strings(items)
// ---------------------------------------------------------------------------
// Return a new list containing the given strings sorted lexicographically.
//
// Used to keep output deterministic (tests, CI).
//
// Args:
//   - items: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn __sorted_strings(items) {
    def arr = new[];
    def i = 0;
    while (i < len(items)) { Collections.push(arr, heap_get(items, i)); i = i + 1; }
    def n = len(arr);
    def a = 0;
    // ---------------------------------------------------------------------------
    // _swap(list, idx_a, idx_b)
    // ---------------------------------------------------------------------------
    // Helper function used by the linter.
    //
    // This function is part of the TinyLanguage linter port and is not intended as a public API.
    //
    // Args:
    //   - list: (Tiny value) See implementation for expected shape.
    //   - idx_a: (Tiny value) See implementation for expected shape.
    //   - idx_b: (Tiny value) See implementation for expected shape.
    //
    // Returns:
    //   A Tiny value (type depends on operation).
    // ---------------------------------------------------------------------------
    fn _swap(list, idx_a, idx_b) {
        def out = new[];
        def si = 0;
        while (si < len(list)) {
            if (si == idx_a) {
                Collections.push(out, heap_get(list, idx_b));
            } else {
                if (si == idx_b) { Collections.push(out, heap_get(list, idx_a)); }
                else { Collections.push(out, heap_get(list, si)); }
            }
            si = si + 1;
        }
        return out;
    }
    while (a < n) {
        def b = a + 1;
        while (b < n) {
            def ia = heap_get(arr, a);
            def ib = heap_get(arr, b);
            if (ib < ia) {
                arr = _swap(arr, a, b);
            }
            b = b + 1;
        }
        a = a + 1;
    }
    return arr;
}

// ---------------------------------------------------------------------------
// __copy_state(state)
// ---------------------------------------------------------------------------
// Deep-ish copy of a usage-tracking state map.
//
// The must-use analysis uses multiple concurrent states (branching control-flow). States must not alias each other, so we copy before modifying.
//
// Args:
//   - state: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn __copy_state(state) {
    def keys = Map.keys(state);
    def new_state = Map.new();
    def i = 0;
    while (i < len(keys)) {
        def k = heap_get(keys, i);
        Map.set(new_state, k, Map.get(state, k));
        i = i + 1;
    }
    return new_state;
}

// ---------------------------------------------------------------------------
// _import_binding_name(module, alias)
// ---------------------------------------------------------------------------
// Helper function used by the linter.
//
// This function is part of the TinyLanguage linter port and is not intended as a public API.
//
// Args:
//   - module: (Tiny value) See implementation for expected shape.
//   - alias: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn _import_binding_name(module, alias) {
    if (alias != Null) { return alias; }
    def chars = Python.call("builtins", "list", new[module], PY_LIST_ALLOW);
    def idx = 0;
    while (idx < len(chars) && heap_get(chars, idx) == ".") { idx = idx + 1; }
    if (idx >= len(chars)) { return module; }
    def trimmed = String.join(Collections.slice(chars, idx, len(chars)), "");
    def parts = String.split(trimmed, ".");
    if (len(parts) == 0) { return trimmed; }
    return heap_get(parts, len(parts) - 1);
}

// ---------------------------------------------------------------------------
// __starts_with_underscore(name)
// ---------------------------------------------------------------------------
// Internal helper used by the linter.
//
// Names starting with `__` are intentionally private and may change without notice.
//
// Args:
//   - name: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn __starts_with_underscore(name) {
    if (name == Null) { return false; }
    if (String.len(name) == 0) { return false; }
    return heap_get(Python.call("builtins", "list", new[name], PY_LIST_ALLOW), 0) == "_";
}

// ---------------------------------------------------------------------------
// __pad_left(num, width)
// ---------------------------------------------------------------------------
// Internal helper used by the linter.
//
// Names starting with `__` are intentionally private and may change without notice.
//
// Args:
//   - num: (Tiny value) See implementation for expected shape.
//   - width: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn __pad_left(num, width) {
    def txt = __to_str(num);
    while (String.len(txt) < width) { txt = " " + txt; }
    return txt;
}

// ---------------------------------------------------------------------------
// __line_info(source, pos)
// ---------------------------------------------------------------------------
// Internal helper used by the linter.
//
// Names starting with `__` are intentionally private and may change without notice.
//
// Args:
//   - source: (Tiny value) See implementation for expected shape.
//   - pos: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn __line_info(source, pos) {
    def target_pos = pos;
    def lines = String.split(source, "\n");
    if (target_pos.__tag__ == "SourceSpan") { target_pos = target_pos.start; }
    if (target_pos.__tag__ == "SourcePos") {
        def line = target_pos.line;
        if (line < 1) { line = 1; }
        if (line > len(lines) && len(lines) > 0) { line = len(lines); }
        def line_text = "";
        if (len(lines) > 0 && line - 1 >= 0 && line - 1 < len(lines)) { line_text = heap_get(lines, line - 1); }
        def col = target_pos.column;
        def max_col = String.len(line_text) + 1;
        if (max_col > 0 && col > max_col) { col = max_col; }
        if (col < 1) { col = 1; }
        return new[line, col, line_text];
    }
    def idx = target_pos;
    if (idx < 0) { idx = 0; }
    if (idx > String.len(source)) { idx = String.len(source); }
    def chars = Python.call("builtins", "list", new[source], PY_LIST_ALLOW);
    def line = 1;
    def last_nl = -1;
    def i = 0;
    while (i < idx) {
        if (heap_get(chars, i) == "\n") {
            line = line + 1;
            last_nl = i;
        }
        i = i + 1;
    }
    def col = idx - last_nl;
    def line_text = "";
    if (len(lines) > 0 && line - 1 >= 0 && line - 1 < len(lines)) { line_text = heap_get(lines, line - 1); }
    return new[line, col, line_text];
}

// ---------------------------------------------------------------------------
// __format_error(source, pos, message, code, hint)
// ---------------------------------------------------------------------------
// Internal helper used by the linter.
//
// Names starting with `__` are intentionally private and may change without notice.
//
// Args:
//   - source: (Tiny value) See implementation for expected shape.
//   - pos: (Tiny value) See implementation for expected shape.
//   - message: (Tiny value) See implementation for expected shape.
//   - code: (Tiny value) See implementation for expected shape.
//   - hint: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn __format_error(source, pos, message, code, hint) {
    if (pos.__tag__ == "SourceSpan") {
        def start_info = __line_info(source, pos.start);
        def stop_info = __line_info(source, pos.stop);
        def start_line = heap_get(start_info, 0);
        def start_col = heap_get(start_info, 1);
        def stop_line = heap_get(stop_info, 0);
        def stop_col = heap_get(stop_info, 1);
        def lines = String.split(source, "\n");
        def line_count = len(lines);
        if (line_count < 1) { line_count = 1; }
        def gutter_width = String.len(__to_str(line_count));
        def lines_out = new[];
        def header = "[" + code + "] " + message + " (line " + __to_str(start_line) + ", col " + __to_str(start_col) + ")";
        Collections.push(lines_out, header);
        def context_start = start_line - 1; if (context_start < 1) { context_start = 1; }
        def context_end = stop_line + 1;
        if (len(lines) == 0) { context_end = stop_line; }
        if (len(lines) > 0 && context_end > len(lines)) { context_end = len(lines); }
        def ln = context_start;
        while (ln <= context_end) {
            def text = "";
            if (len(lines) > 0 && ln - 1 >= 0 && ln - 1 < len(lines)) {
                text = heap_get(lines, ln - 1);
            }
            def prefix = " ";
            if (ln == start_line) { prefix = ">"; }
            def padded = __pad_left(ln, gutter_width);
            Collections.push(lines_out, prefix + " " + padded + " | " + text);

            if (ln >= start_line && ln <= stop_line) {
                def underline_start = 1;
                def underline_end = String.len(text);
                if (ln == start_line && ln == stop_line) {
                    underline_start = start_col;
                    underline_end = stop_col;
                } else {
                    if (ln == start_line) {
                        underline_start = start_col;
                        if (underline_end < start_col) { underline_end = start_col; }
                    } else {
                        if (ln == stop_line) {
                            underline_start = 1;
                            underline_end = stop_col;
                        } else {
                            if (underline_end < 1) { underline_end = 1; }
                        }
                    }
                }
                def underline_len = underline_end - underline_start + 1;
                if (underline_len < 1) { underline_len = 1; }
                def prefix_spaces = "";
                def i = 1;
                while (i < underline_start) { prefix_spaces = prefix_spaces + " "; i = i + 1; }
                def underline = prefix_spaces + String.repeat("^", underline_len);
                Collections.push(lines_out, "  " + String.repeat(" ", gutter_width) + " | " + underline);
            }
            ln = ln + 1;
        }
        if (hint != Null && hint != "") {
            Collections.push(lines_out, "  Hint: " + hint);
        }
        return String.join(lines_out, "\n");
    }
    def lines = String.split(source, "\n");
    def line_count = len(lines);
    if (line_count < 1) { line_count = 1; }
    def info = __line_info(source, pos);
    def line = heap_get(info, 0);
    def col = heap_get(info, 1);
    def gutter_width = String.len(__to_str(line_count));
    def start = line - 1; if (start < 1) { start = 1; }
    def end = line + 1;
    if (len(lines) > 0 && end > len(lines)) { end = len(lines); }
    def lines_out = new[];
    def header = "[" + code + "] " + message + " (line " + __to_str(line) + ", col " + __to_str(col) + ")";
    Collections.push(lines_out, header);
    def ln = start;
    while (ln <= end) {
        def text = "";
        if (len(lines) > 0 && ln - 1 >= 0 && ln - 1 < len(lines)) { text = heap_get(lines, ln - 1); }
        def prefix = " ";
        if (ln == line) { prefix = ">"; }
        def padded = __pad_left(ln, gutter_width);
        Collections.push(lines_out, prefix + " " + padded + " | " + text);
        if (ln == line) {
            def spaces = String.repeat(" ", col - 1);
            def caret = String.repeat("^", 1);
            Collections.push(lines_out, "  " + String.repeat(" ", gutter_width) + " | " + spaces + caret);
        }
        ln = ln + 1;
    }
    if (hint != Null && hint != "") {
        Collections.push(lines_out, "  Hint: " + hint);
    }
    return String.join(lines_out, "\n");
}

// ---------------------------------------------------------------------------
// _node_span(obj)
// ---------------------------------------------------------------------------
// Helper function used by the linter.
//
// This function is part of the TinyLanguage linter port and is not intended as a public API.
//
// Args:
//   - obj: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn _node_span(obj) {
    if (obj == Null) { return Null; }
    if (obj.__tag__ == "SourceSpan") { return obj; }
    if (obj.span != Null) { return obj.span; }
    return Null;
}

// ---------------------------------------------------------------------------
// _node_pos(obj)
// ---------------------------------------------------------------------------
// Helper function used by the linter.
//
// This function is part of the TinyLanguage linter port and is not intended as a public API.
//
// Args:
//   - obj: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn _node_pos(obj) {
    if (obj == Null) { return SourcePos_origin(); }
    if (obj.__tag__ == "SourceSpan") { return obj.start; }
    if (obj.__tag__ == "SourcePos") { return obj; }
    if (obj.pos != Null) { return obj.pos; }
    return SourcePos_origin();
}

// ---------------------------------------------------------------------------
// _lint_error(source, node, message, code, hint)
// ---------------------------------------------------------------------------
// Helper function used by the linter.
//
// This function is part of the TinyLanguage linter port and is not intended as a public API.
//
// Args:
//   - source: (Tiny value) See implementation for expected shape.
//   - node: (Tiny value) See implementation for expected shape.
//   - message: (Tiny value) See implementation for expected shape.
//   - code: (Tiny value) See implementation for expected shape.
//   - hint: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn _lint_error(source, node, message, code, hint) {
    def span = _node_span(node);
    def pos = _node_pos(node);
    def location = pos;
    if (span != Null) { location = span; }
    def rendered = __format_error(source, location, message, code, hint);
    return __raise_runtime_error(rendered);
}

// ---------------------------------------------------------------------------
// _param_names(params)
// ---------------------------------------------------------------------------
// Helper function used by the linter.
//
// This function is part of the TinyLanguage linter port and is not intended as a public API.
//
// Args:
//   - params: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn _param_names(params) {
    def names = new[];
    def i = 0;
    while (i < len(params)) {
        def p = heap_get(params, i);
        Collections.push(names, p.name);
        i = i + 1;
    }
    return names;
}

// ---------------------------------------------------------------------------
// _collect_names_in_expr(e, names)
// ---------------------------------------------------------------------------
// Collect variable names referenced by an expression into a Set.
//
// Used as a building block for various must-use and data-flow checks.
//
// Args:
//   - e: (Tiny value) See implementation for expected shape.
//   - names: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn _collect_names_in_expr(e, names) {
    if (e == Null) { return Null; }
    if (e.__tag__ == "Var") { Set.add(names, e.name); return Null; }
    if (e.__tag__ == "Bin") { _collect_names_in_expr(e.a, names); _collect_names_in_expr(e.b, names); return Null; }
    if (e.__tag__ == "Call") {
        def i = 0;
        while (i < len(e.args)) { _collect_names_in_expr(heap_get(e.args, i), names); i = i + 1; }
        return Null;
    }
    if (e.__tag__ == "Spawn") {
        def i = 0;
        while (i < len(e.args)) { _collect_names_in_expr(heap_get(e.args, i), names); i = i + 1; }
        return Null;
    }
    if (e.__tag__ == "Await") { _collect_names_in_expr(e.expr, names); return Null; }
    if (e.__tag__ == "New") { _collect_names_in_expr(e.size, names); return Null; }
    if (e.__tag__ == "NewLit") {
        def i = 0;
        while (i < len(e.items)) { _collect_names_in_expr(heap_get(e.items, i), names); i = i + 1; }
        return Null;
    }
    if (e.__tag__ == "Field") { _collect_names_in_expr(e.obj, names); return Null; }
    if (e.__tag__ == "MethodCall") {
        _collect_names_in_expr(e.obj, names);
        def i = 0;
        while (i < len(e.args)) { _collect_names_in_expr(heap_get(e.args, i), names); i = i + 1; }
        return Null;
    }
    if (e.__tag__ == "ClassNew") {
        def i = 0;
        while (i < len(e.init)) { _collect_names_in_expr(heap_get(heap_get(e.init, i), 1), names); i = i + 1; }
        return Null;
    }
    if (e.__tag__ == "ObjLit") {
        def i = 0;
        while (i < len(e.fields)) { _collect_names_in_expr(heap_get(heap_get(e.fields, i), 1), names); i = i + 1; }
        return Null;
    }
    if (e.__tag__ == "Match") {
        _collect_names_in_expr(e.expr, names);
        def i = 0;
        while (i < len(e.cases)) { _collect_names_in_expr(heap_get(e.cases, i).body, names); i = i + 1; }
        return Null;
    }
    if (e.__tag__ == "VariantCtor") {
        def i = 0;
        while (i < len(e.fields)) { _collect_names_in_expr(heap_get(heap_get(e.fields, i), 1), names); i = i + 1; }
        return Null;
    }
    return Null;
}

// ---------------------------------------------------------------------------
// uses_in_expr(e, reads)
// ---------------------------------------------------------------------------
// Record variable reads performed by an expression.
//
// Populates a Map from name -> read-count, used to detect unused locals/params and to handle special cases (underscore names).
//
// Args:
//   - e: (Tiny value) See implementation for expected shape.
//   - reads: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn uses_in_expr(e, reads) {
    if (e == Null) { return Null; }
    if (e.__tag__ == "Var") {
        def prev = Map.get(reads, e.name, 0);
        Map.set(reads, e.name, prev + 1);
        return Null;
    }
    if (e.__tag__ == "Bin") { uses_in_expr(e.a, reads); uses_in_expr(e.b, reads); return Null; }
    if (e.__tag__ == "Call") {
        def prev_call = Map.get(reads, e.name, 0);
        Map.set(reads, e.name, prev_call + 1);
        def i = 0;
        while (i < len(e.args)) { uses_in_expr(heap_get(e.args, i), reads); i = i + 1; }
        return Null;
    }
    if (e.__tag__ == "Spawn") {
        def prev_spawn = Map.get(reads, e.name, 0);
        Map.set(reads, e.name, prev_spawn + 1);
        def i = 0;
        while (i < len(e.args)) { uses_in_expr(heap_get(e.args, i), reads); i = i + 1; }
        return Null;
    }
    if (e.__tag__ == "Await") { uses_in_expr(e.expr, reads); return Null; }
    if (e.__tag__ == "New") { uses_in_expr(e.size, reads); return Null; }
    if (e.__tag__ == "NewLit") {
        def i = 0;
        while (i < len(e.items)) { uses_in_expr(heap_get(e.items, i), reads); i = i + 1; }
        return Null;
    }
    if (e.__tag__ == "Field") { uses_in_expr(e.obj, reads); return Null; }
    if (e.__tag__ == "MethodCall") {
        uses_in_expr(e.obj, reads);
        def i = 0;
        while (i < len(e.args)) { uses_in_expr(heap_get(e.args, i), reads); i = i + 1; }
        return Null;
    }
    if (e.__tag__ == "ClassNew") {
        def i = 0;
        while (i < len(e.init)) { uses_in_expr(heap_get(heap_get(e.init, i), 1), reads); i = i + 1; }
        return Null;
    }
    if (e.__tag__ == "ObjLit") {
        def i = 0;
        while (i < len(e.fields)) { uses_in_expr(heap_get(heap_get(e.fields, i), 1), reads); i = i + 1; }
        return Null;
    }
    if (e.__tag__ == "Match") {
        uses_in_expr(e.expr, reads);
        def i = 0;
        while (i < len(e.cases)) {
            def tmp_reads = Map.new();
            uses_in_expr(heap_get(e.cases, i).body, tmp_reads);
            def keys = Map.keys(tmp_reads);
            def j = 0;
            while (j < len(keys)) {
                def name = heap_get(keys, j);
                def count = Map.get(tmp_reads, name, 0);
                def prev = Map.get(reads, name, 0);
                if (count > prev) { Map.set(reads, name, count); }
                j = j + 1;
            }
            i = i + 1;
        }
        return Null;
    }
    if (e.__tag__ == "VariantCtor") {
        def i = 0;
        while (i < len(e.fields)) { uses_in_expr(heap_get(heap_get(e.fields, i), 1), reads); i = i + 1; }
        return Null;
    }
    return Null;
}

// ---------------------------------------------------------------------------
// lint_stmt_reads(s, reads)
// ---------------------------------------------------------------------------
// Collect reads inside a statement (and nested expressions).
//
// This is a lightweight read-only traversal used by several lint rules.
//
// Args:
//   - s: (Tiny value) See implementation for expected shape.
//   - reads: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn lint_stmt_reads(s, reads) {
    if (s.__tag__ == "Let" || s.__tag__ == "Assign") { uses_in_expr(s.expr, reads); return Null; }
    if (s.__tag__ == "FieldAssign") { uses_in_expr(s.obj, reads); uses_in_expr(s.expr, reads); return Null; }
    if (s.__tag__ == "Print") {
        def i = 0;
        while (i < len(s.exprs)) { uses_in_expr(heap_get(s.exprs, i), reads); i = i + 1; }
        return Null;
    }
    if (s.__tag__ == "Flush") { return Null; }
    if (s.__tag__ == "If") {
        uses_in_expr(s.cond, reads);
        def i = 0;
        while (i < len(s.then)) { lint_stmt_reads(heap_get(s.then, i), reads); i = i + 1; }
        i = 0;
        while (i < len(s.els)) { lint_stmt_reads(heap_get(s.els, i), reads); i = i + 1; }
        return Null;
    }
    if (s.__tag__ == "While") { uses_in_expr(s.cond, reads); def i = 0; while (i < len(s.body)) { lint_stmt_reads(heap_get(s.body, i), reads); i = i + 1; } return Null; }
    if (s.__tag__ == "Switch") {
        uses_in_expr(s.expr, reads);
        def i = 0;
        while (i < len(s.cases)) {
            def case_node = heap_get(s.cases, i);
            if (case_node.value != Null) { uses_in_expr(case_node.value, reads); }
            def bi = 0;
            while (bi < len(case_node.body)) { lint_stmt_reads(heap_get(case_node.body, bi), reads); bi = bi + 1; }
            i = i + 1;
        }
        return Null;
    }
    if (s.__tag__ == "TryCatch") {
        def i = 0;
        while (i < len(s.body)) { lint_stmt_reads(heap_get(s.body, i), reads); i = i + 1; }
        def handler_reads = Map.new();
        i = 0;
        while (i < len(s.handler)) { lint_stmt_reads(heap_get(s.handler, i), handler_reads); i = i + 1; }
        if (s.err_name != Null) { if (Map.get(handler_reads, s.err_name, 0) == 0) { Map.set(handler_reads, s.err_name, 0); } }
        def keys = Map.keys(handler_reads);
        i = 0;
        while (i < len(keys)) {
            def name = heap_get(keys, i);
            def count = Map.get(handler_reads, name, 0);
            def prev = Map.get(reads, name, 0);
            if (count > prev) { Map.set(reads, name, count); }
            i = i + 1;
        }
        return Null;
    }
    if (s.__tag__ == "Return") { uses_in_expr(s.expr, reads); return Null; }
    if (s.__tag__ == "OpDef") {
        def tmp = Map.new();
        def i = 0;
        while (i < len(s.body)) { lint_stmt_reads(heap_get(s.body, i), tmp); i = i + 1; }
        def miss = new[];
        if (!__starts_with_underscore(s.a_name) && Map.get(tmp, s.a_name, 0) == 0) { Collections.push(miss, s.a_name); }
        if (!__starts_with_underscore(s.b_name) && Map.get(tmp, s.b_name, 0) == 0) { Collections.push(miss, s.b_name); }
        if (len(miss) > 0) {
            def msg = "unused operator parameter(s) in op " + s.op + ": " + String.join(miss, ", ");
            return __raise_runtime_error(msg);
        }
        def keys = Map.keys(tmp);
        i = 0;
        while (i < len(keys)) {
            def name = heap_get(keys, i);
            if (!(name == s.a_name || name == s.b_name)) {
                def count = Map.get(tmp, name, 0);
                def prev = Map.get(reads, name, 0);
                if (count > prev) { Map.set(reads, name, count); }
            }
            i = i + 1;
        }
        return Null;
    }
    if (s.__tag__ == "DestructAssign") { uses_in_expr(s.expr, reads); return Null; }
    if (s.__tag__ == "MethodDef") {
        def tmp = Map.new();
        def i = 0;
        while (i < len(s.body)) { lint_stmt_reads(heap_get(s.body, i), tmp); i = i + 1; }
        def param_names = _param_names(s.params);
        def miss = new[];
        i = 0;
        while (i < len(param_names)) {
            def p = heap_get(param_names, i);
            if (p != "self" && !__starts_with_underscore(p)) {
                if (Map.get(tmp, p, 0) == 0) { Collections.push(miss, p); }
            }
            i = i + 1;
        }
        if (len(miss) > 0) {
            return __raise_runtime_error("unused parameter(s) in method " + s.class_name + "." + s.name + ": " + String.join(miss, ", "));
        }
        def keys = Map.keys(tmp);
        i = 0;
        while (i < len(keys)) {
            def name = heap_get(keys, i);
            def skip = false;
            def j = 0;
            while (j < len(param_names)) { if (name == heap_get(param_names, j)) { skip = true; } j = j + 1; }
            if (!skip) {
                def count = Map.get(tmp, name, 0);
                def prev = Map.get(reads, name, 0);
                if (count > prev) { Map.set(reads, name, count); }
            }
            i = i + 1;
        }
        return Null;
    }
    if (s.__tag__ == "Fn") {
        def tmp = Map.new();
        def i = 0;
        while (i < len(s.body)) { lint_stmt_reads(heap_get(s.body, i), tmp); i = i + 1; }
        def param_names = _param_names(s.params);
        def keys = Map.keys(tmp);
        i = 0;
        while (i < len(keys)) {
            def name = heap_get(keys, i);
            def skip = false;
            def j = 0;
            while (j < len(param_names)) { if (name == heap_get(param_names, j)) { skip = true; } j = j + 1; }
            if (!skip) {
                def count = Map.get(tmp, name, 0);
                def prev = Map.get(reads, name, 0);
                if (count > prev) { Map.set(reads, name, count); }
            }
            i = i + 1;
        }
        return Null;
    }
    if (s.__tag__ == "ClassDef") {
        def i = 0;
        while (i < len(s.methods)) { lint_stmt_reads(heap_get(s.methods, i), reads); i = i + 1; }
        return Null;
    }
    if (s.__tag__ == "Namespace") {
        def i = 0;
        while (i < len(s.body)) { lint_stmt_reads(heap_get(s.body, i), reads); i = i + 1; }
        return Null;
    }
    if (s.__tag__ == "CallStmt") {
        def i = 0;
        while (i < len(s.args)) { uses_in_expr(heap_get(s.args, i), reads); i = i + 1; }
        return Null;
    }
    return Null;
}

// ---------------------------------------------------------------------------
// lint_fn_params_used(fn_node, source)
// ---------------------------------------------------------------------------
// Must-use rule: ensure every function parameter is used.
//
// Parameters starting with '_' are considered intentionally unused and are ignored.
//
// Args:
//   - fn_node: (Tiny value) See implementation for expected shape.
//   - source: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn lint_fn_params_used(fn_node, source) {
    def reads = Map.new();
    def i = 0;
    while (i < len(fn_node.body)) { lint_stmt_reads(heap_get(fn_node.body, i), reads); i = i + 1; }
    def param_names = _param_names(fn_node.params);
    def unused = new[];
        i = 0;
        while (i < len(param_names)) {
            def p = heap_get(param_names, i);
            if (!(p == "self" || __starts_with_underscore(p))) {
                if (Map.get(reads, p, 0) == 0) { Collections.push(unused, p); }
            }
            i = i + 1;
        }
    if (len(unused) > 0) {
        def msg = "unused parameter(s) in function " + fn_node.name + ": " + String.join(unused, ", ");
        if (source == Null) { return __raise_runtime_error(msg); }
        else { _lint_error(source, fn_node, msg, "E002", "Remove the unused parameter or reference it."); }
    }
    lint_param_mutations_returned(fn_node.body, Set.from_list(param_names), fn_node.name, false, source, fn_node.pos);
    lint_destruct_call_outputs(fn_node.body, source);
    lint_return_signatures(fn_node.body, fn_node.name, false, source, fn_node.pos);
    lint_return_exhaustiveness(fn_node.body, fn_node.name, fn_node.return_type, false, source, fn_node);
    lint_locals_used(fn_node.body, source);
}

// ---------------------------------------------------------------------------
// lint_method_params_used(md, source)
// ---------------------------------------------------------------------------
// Must-use rule for method definitions (like operators / methods).
//
// Mirrors `lint_fn_params_used` but follows the method AST shape.
//
// Args:
//   - md: (Tiny value) See implementation for expected shape.
//   - source: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn lint_method_params_used(md, source) {
    def reads = Map.new();
    def i = 0;
    while (i < len(md.body)) { lint_stmt_reads(heap_get(md.body, i), reads); i = i + 1; }
    def param_names = _param_names(md.params);
    def unused = new[];
        i = 0;
        while (i < len(param_names)) {
            def p = heap_get(param_names, i);
            if (!(p == "self" || __starts_with_underscore(p))) {
                if (Map.get(reads, p, 0) == 0) { Collections.push(unused, p); }
            }
            i = i + 1;
        }
    if (len(unused) > 0) {
        def msg = "unused parameter(s) in method " + md.class_name + "." + md.name + ": " + String.join(unused, ", ");
        if (source == Null) { return __raise_runtime_error(msg); }
        else { _lint_error(source, md, msg, "E002", "Remove the unused parameter or reference it."); }
    }
    lint_param_mutations_returned(md.body, Set.from_list(param_names), md.class_name + "." + md.name, true, source, md.pos);
    lint_destruct_call_outputs(md.body, source);
    lint_return_signatures(md.body, md.class_name + "." + md.name, true, source, md.pos);
    lint_return_exhaustiveness(md.body, md.class_name + "." + md.name, md.return_type, true, source, md);
    lint_locals_used(md.body, source);
}

// ---------------------------------------------------------------------------
// lint_locals_used(stmts, source)
// ---------------------------------------------------------------------------
// Must-use rule: ensure every local binding is used.
//
// Tracks locals across control-flow (if/else/while/return) and reports unused bindings with source spans.
//
// Args:
//   - stmts: (Tiny value) See implementation for expected shape.
//   - source: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn lint_locals_used(stmts, source) {
    if (source != Null) {
        def msg = Python.call("tiny_language", "_lint_message", new[source], PY_LINT_ALLOW);
        if (msg != Null) { return __raise_runtime_error(msg); }
        return Null;
    }
    def unused = new[];
    def partial = new[];

    // ---------------------------------------------------------------------------
    // names_in_expr(expr)
    // ---------------------------------------------------------------------------
    // Helper function used by the linter.
    //
    // This function is part of the TinyLanguage linter port and is not intended as a public API.
    //
    // Args:
    //   - expr: (Tiny value) See implementation for expected shape.
    //
    // Returns:
    //   A Tiny value (type depends on operation).
    // ---------------------------------------------------------------------------
    fn names_in_expr(expr) {
        def reads = Map.new();
        uses_in_expr(expr, reads);
        return Map.keys(reads);
    }

    // ---------------------------------------------------------------------------
    // _mark_used(state, name)
    // ---------------------------------------------------------------------------
    // Helper function used by the linter.
    //
    // This function is part of the TinyLanguage linter port and is not intended as a public API.
    //
    // Args:
    //   - state: (Tiny value) See implementation for expected shape.
    //   - name: (Tiny value) See implementation for expected shape.
    //
    // Returns:
    //   A Tiny value (type depends on operation).
    // ---------------------------------------------------------------------------
    fn _mark_used(state, name) {
        def entry = Map.get(state, name, Null);
        if (entry != Null) {
            def pos = heap_get(entry, 0);
            Map.set(state, name, new[pos, true, true]);
        }
    }

    // ---------------------------------------------------------------------------
    // _mark_captured_uses(block, state)
    // ---------------------------------------------------------------------------
    // Helper function used by the linter.
    //
    // This function is part of the TinyLanguage linter port and is not intended as a public API.
    //
    // Args:
    //   - block: (Tiny value) See implementation for expected shape.
    //   - state: (Tiny value) See implementation for expected shape.
    //
    // Returns:
    //   A Tiny value (type depends on operation).
    // ---------------------------------------------------------------------------
    fn _mark_captured_uses(block, state) {
        def reads = Map.new();
        def i = 0;
        while (i < len(block)) { lint_stmt_reads(heap_get(block, i), reads); i = i + 1; }
        def keys = Map.keys(reads);
        i = 0;
        while (i < len(keys)) {
            def nm = heap_get(keys, i);
            if (Map.get(state, nm, Null) != Null) { _mark_used(state, nm); }
            i = i + 1;
        }
    }

    // ---------------------------------------------------------------------------
    // _merge_states(states)
    // ---------------------------------------------------------------------------
    // Helper function used by the linter.
    //
    // This function is part of the TinyLanguage linter port and is not intended as a public API.
    //
    // Args:
    //   - states: (Tiny value) See implementation for expected shape.
    //
    // Returns:
    //   A Tiny value (type depends on operation).
    // ---------------------------------------------------------------------------
    fn _merge_states(states) {
        if (len(states) == 0) { return states; }
        def merged = Map.new();
        def i = 0;
        while (i < len(states)) {
            def st = heap_get(states, i);
            def keys = Map.keys(st);
            def j = 0;
            while (j < len(keys)) {
                def name = heap_get(keys, j);
                def entry = Map.get(st, name);
                def pos = heap_get(entry, 0);
                def used_all = heap_get(entry, 1);
                def used_any = heap_get(entry, 2);
                def prev = Map.get(merged, name, Null);
                if (prev == Null) {
                    Map.set(merged, name, new[pos, used_all, used_any]);
                } else {
                    def prev_pos = heap_get(prev, 0);
                    def prev_all = heap_get(prev, 1);
                    def prev_any = heap_get(prev, 2);
                    def u2 = Map.set(merged, name, new[prev_pos, prev_all && used_all, prev_any || used_any]);
                }
                j = j + 1;
            }
            i = i + 1;
        }
        return new[merged];
    }

    // ---------------------------------------------------------------------------
    // analyze_block(block, initial_states)
    // ---------------------------------------------------------------------------
    // Core must-use data-flow engine.
    //
    // This function walks a statement block while tracking multiple possible usage states, merging states at joins (e.g. after if/else) and marking variables as used when read.
    //
    // It is designed to be deterministic and to match the behavior/error wording of the Python reference linter.
    //
    // Args:
    //   - block: (Tiny value) See implementation for expected shape.
    //   - initial_states: (Tiny value) See implementation for expected shape.
    //
    // Returns:
    //   A Tiny value (type depends on operation).
    // ---------------------------------------------------------------------------
    fn analyze_block(block, initial_states) {
        def active_states = new[];
        def i = 0;
        while (i < len(initial_states)) { Collections.push(active_states, __copy_state(heap_get(initial_states, i))); i = i + 1; }
        def terminated_states = new[];
        def idx = 0;
        while (idx < len(block)) {
            def st = heap_get(block, idx);
            def next_active = new[];
            def ai = 0;
            while (ai < len(active_states)) {
                def state = heap_get(active_states, ai);
                def handled = false;
                if (!handled && st.__tag__ == "Let") {
                    def new_state = __copy_state(state);
                    def names = names_in_expr(st.expr);
                    def ni = 0;
                    while (ni < len(names)) { _mark_used(new_state, heap_get(names, ni)); ni = ni + 1; }
                    def decl_pos = st.name_span;
                    if (decl_pos == Null) { decl_pos = st.pos; }
                    Map.set(new_state, st.name, new[decl_pos, false, false]);
                    Collections.push(next_active, new_state);
                    handled = true;
                }
                if (!handled && st.__tag__ == "Import") {
                    def new_state = __copy_state(state);
                    def bind = _import_binding_name(st.module, st.alias);
                    def decl_pos = st.binding_span;
                    if (decl_pos == Null) { decl_pos = st.pos; }
                    Map.set(new_state, bind, new[decl_pos, false, false]);
                    Collections.push(next_active, new_state);
                    handled = true;
                }
                if (!handled && st.__tag__ == "DestructAssign") {
                    def new_state = __copy_state(state);
                    def ni = 0;
                    while (ni < len(st.names)) { def span = heap_get(st.name_spans, ni); Map.set(new_state, heap_get(st.names, ni), new[span, false, false]); ni = ni + 1; }
                    def names = names_in_expr(st.expr);
                    ni = 0;
                    while (ni < len(names)) { _mark_used(new_state, heap_get(names, ni)); ni = ni + 1; }
                    Collections.push(next_active, new_state);
                    handled = true;
                }
                if (!handled && st.__tag__ == "Assign") {
                    def new_state = __copy_state(state);
                    def names = names_in_expr(st.expr);
                    def ni = 0;
                    while (ni < len(names)) { _mark_used(new_state, heap_get(names, ni)); ni = ni + 1; }
                    Collections.push(next_active, new_state);
                    handled = true;
                }
                if (!handled && st.__tag__ == "FieldAssign") {
                    def new_state = __copy_state(state);
                    def names = names_in_expr(st.obj);
                    def ni = 0;
                    while (ni < len(names)) { _mark_used(new_state, heap_get(names, ni)); ni = ni + 1; }
                    names = names_in_expr(st.expr);
                    ni = 0;
                    while (ni < len(names)) { _mark_used(new_state, heap_get(names, ni)); ni = ni + 1; }
                    Collections.push(next_active, new_state);
                    handled = true;
                }
                if (!handled && st.__tag__ == "Print") {
                    def new_state = __copy_state(state);
                    def ei = 0;
                    while (ei < len(st.exprs)) {
                        def names = names_in_expr(heap_get(st.exprs, ei));
                        def ni = 0;
                        while (ni < len(names)) { _mark_used(new_state, heap_get(names, ni)); ni = ni + 1; }
                        ei = ei + 1;
                    }
                    Collections.push(next_active, new_state);
                    handled = true;
                }
                if (!handled && st.__tag__ == "Flush") {
                    Collections.push(next_active, __copy_state(state));
                    handled = true;
                }
                if (!handled && st.__tag__ == "CallStmt") {
                    def new_state = __copy_state(state);
                    def ai2 = 0;
                    while (ai2 < len(st.args)) {
                        def names = names_in_expr(heap_get(st.args, ai2));
                        def ni = 0;
                        while (ni < len(names)) { _mark_used(new_state, heap_get(names, ni)); ni = ni + 1; }
                        ai2 = ai2 + 1;
                    }
                    Collections.push(next_active, new_state);
                    handled = true;
                }
                if (!handled && st.__tag__ == "Return") {
                    def new_state = __copy_state(state);
                    def names = names_in_expr(st.expr);
                    def ni = 0;
                    while (ni < len(names)) { _mark_used(new_state, heap_get(names, ni)); ni = ni + 1; }
                    Collections.push(terminated_states, new_state);
                    handled = true;
                }
                if (!handled && st.__tag__ == "If") {
                    def cond_state = __copy_state(state);
                    def cond_names = names_in_expr(st.cond);
                    def ci = 0;
                    while (ci < len(cond_names)) { _mark_used(cond_state, heap_get(cond_names, ci)); ci = ci + 1; }
                    def cond_is_bool = st.cond.__tag__ == "Bool";
                    def cond_truthy = cond_is_bool && st.cond.value;
                    if (cond_is_bool && cond_truthy) {
                        if (len(st.els) > 0) { lint_locals_used(st.els, source); }
                        def then_res = analyze_block(st.then, new[cond_state]);
                        def then_active = heap_get(then_res, 0);
                        def then_term = heap_get(then_res, 1);
                        def ti = 0;
                        while (ti < len(then_active)) { Collections.push(next_active, heap_get(then_active, ti)); ti = ti + 1; }
                        ti = 0;
                        while (ti < len(then_term)) { Collections.push(terminated_states, heap_get(then_term, ti)); ti = ti + 1; }
                    } else {
                        if (cond_is_bool && !cond_truthy) {
                            if (len(st.then) > 0) { lint_locals_used(st.then, source); }
                            def else_res = analyze_block(st.els, new[cond_state]);
                            def else_active = heap_get(else_res, 0);
                            def else_term = heap_get(else_res, 1);
                            if (len(else_active) == 0) { Collections.push(next_active, cond_state); }
                            def ti = 0;
                            while (ti < len(else_active)) { Collections.push(next_active, heap_get(else_active, ti)); ti = ti + 1; }
                            ti = 0;
                            while (ti < len(else_term)) { Collections.push(terminated_states, heap_get(else_term, ti)); ti = ti + 1; }
                        } else {
                            def then_res = analyze_block(st.then, new[cond_state]);
                            def then_active = heap_get(then_res, 0);
                            def then_term = heap_get(then_res, 1);
                            def else_res = analyze_block(st.els, new[cond_state]);
                            def else_active = heap_get(else_res, 0);
                            def else_term = heap_get(else_res, 1);
                            def ti = 0;
                            while (ti < len(then_active)) { Collections.push(next_active, heap_get(then_active, ti)); ti = ti + 1; }
                            ti = 0;
                            while (ti < len(else_active)) { Collections.push(next_active, heap_get(else_active, ti)); ti = ti + 1; }
                            ti = 0;
                            while (ti < len(then_term)) { Collections.push(terminated_states, heap_get(then_term, ti)); ti = ti + 1; }
                            ti = 0;
                            while (ti < len(else_term)) { Collections.push(terminated_states, heap_get(else_term, ti)); ti = ti + 1; }
                        }
                    }
                    handled = true;
                }
                if (!handled && st.__tag__ == "While") {
                    def cond_state = __copy_state(state);
                    def cond_names = names_in_expr(st.cond);
                    def ci = 0;
                    while (ci < len(cond_names)) { _mark_used(cond_state, heap_get(cond_names, ci)); ci = ci + 1; }
                    if (st.cond.__tag__ == "Bool" && !st.cond.value) {
                        lint_locals_used(st.body, source);
                        Collections.push(next_active, cond_state);
                    } else {
                        def body_res = analyze_block(st.body, new[cond_state]);
                        def body_active = heap_get(body_res, 0);
                        def body_term = heap_get(body_res, 1);
                        def bi = 0;
                        while (bi < len(body_active)) { Collections.push(next_active, heap_get(body_active, bi)); bi = bi + 1; }
                        bi = 0;
                        while (bi < len(body_term)) { Collections.push(terminated_states, heap_get(body_term, bi)); bi = bi + 1; }
                    }
                    handled = true;
                }
                if (!handled && st.__tag__ == "Switch") {
                    def switch_state = __copy_state(state);
                    def switch_names = names_in_expr(st.expr);
                    def si = 0;
                    while (si < len(switch_names)) { _mark_used(switch_state, heap_get(switch_names, si)); si = si + 1; }
                    def has_default = false;
                    def ci = 0;
                    while (ci < len(st.cases)) {
                        def case_node = heap_get(st.cases, ci);
                        if (case_node.value == Null) { has_default = true; }
                        else {
                            def case_names = names_in_expr(case_node.value);
                            def ni = 0;
                            while (ni < len(case_names)) { _mark_used(switch_state, heap_get(case_names, ni)); ni = ni + 1; }
                        }
                        def case_res = analyze_block(case_node.body, new[__copy_state(switch_state)]);
                        def case_active = heap_get(case_res, 0);
                        def case_term = heap_get(case_res, 1);
                        def ai = 0;
                        while (ai < len(case_active)) { Collections.push(next_active, heap_get(case_active, ai)); ai = ai + 1; }
                        ai = 0;
                        while (ai < len(case_term)) { Collections.push(terminated_states, heap_get(case_term, ai)); ai = ai + 1; }
                        ci = ci + 1;
                    }
                    if (!has_default) { Collections.push(next_active, __copy_state(switch_state)); }
                    handled = true;
                }
                if (!handled && st.__tag__ == "TryCatch") {
                    def body_res = analyze_block(st.body, new[__copy_state(state)]);
                    def handler_state = __copy_state(state);
                    if (st.err_name != Null) { Map.set(handler_state, st.err_name, new[st.pos, false, false]); }
                    def handler_res = analyze_block(st.handler, new[handler_state]);
                    def body_active = heap_get(body_res, 0);
                    def handler_active = heap_get(handler_res, 0);
                    def body_term = heap_get(body_res, 1);
                    def handler_term = heap_get(handler_res, 1);
                    def bi = 0;
                    while (bi < len(body_active)) { Collections.push(next_active, heap_get(body_active, bi)); bi = bi + 1; }
                    bi = 0;
                    while (bi < len(handler_active)) { Collections.push(next_active, heap_get(handler_active, bi)); bi = bi + 1; }
                    bi = 0;
                    while (bi < len(body_term)) { Collections.push(terminated_states, heap_get(body_term, bi)); bi = bi + 1; }
                    bi = 0;
                    while (bi < len(handler_term)) { Collections.push(terminated_states, heap_get(handler_term, bi)); bi = bi + 1; }
                    handled = true;
                }
                if (!handled && st.__tag__ == "Namespace") {
                    def nested_state = __copy_state(state);
                    _mark_captured_uses(st.body, nested_state);
                    lint_locals_used(st.body, source);
                    Collections.push(next_active, nested_state);
                    handled = true;
                }
                if (!handled && st.__tag__ == "ClassDef") {
                    def nested_state = __copy_state(state);
                    def mi = 0;
                    while (mi < len(st.methods)) { _mark_captured_uses(heap_get(st.methods, mi).body, nested_state); lint_locals_used(heap_get(st.methods, mi).body, source); mi = mi + 1; }
                    Collections.push(next_active, nested_state);
                    handled = true;
                }
                if (!handled && st.__tag__ == "Fn") {
                    def nested_state = __copy_state(state);
                    _mark_captured_uses(st.body, nested_state);
                    lint_locals_used(st.body, source);
                    Collections.push(next_active, nested_state);
                    handled = true;
                }
                if (!handled && st.__tag__ == "MethodDef") {
                    def nested_state = __copy_state(state);
                    _mark_captured_uses(st.body, nested_state);
                    lint_locals_used(st.body, source);
                    Collections.push(next_active, nested_state);
                    handled = true;
                }
                if (!handled) {
                    Collections.push(next_active, __copy_state(state));
                }
                ai = ai + 1;
            }
            active_states = _merge_states(next_active);
            idx = idx + 1;
        }
        return new[_merge_states(active_states), _merge_states(terminated_states)];
    }

    def res = analyze_block(stmts, new[Map.new()]);
    def active = heap_get(res, 0);
    def terminated = heap_get(res, 1);
    def all_states = new[];
    def i = 0;
    while (i < len(active)) { Collections.push(all_states, heap_get(active, i)); i = i + 1; }
    i = 0;
    while (i < len(terminated)) { Collections.push(all_states, heap_get(terminated, i)); i = i + 1; }

    def usage_summary = Map.new();

    // ---------------------------------------------------------------------------
    // __usage_key(name, pos)
    // ---------------------------------------------------------------------------
    // Internal helper used by the linter.
    //
    // Names starting with `__` are intentionally private and may change without notice.
    //
    // Args:
    //   - name: (Tiny value) See implementation for expected shape.
    //   - pos: (Tiny value) See implementation for expected shape.
    //
    // Returns:
    //   A Tiny value (type depends on operation).
    // ---------------------------------------------------------------------------
    fn __usage_key(name, pos) {
        if (pos == Null) { return name + "@pos:0:0"; }
        if (pos.__tag__ == "SourceSpan") {
            def start = pos.start;
            def stop = pos.stop;
            return name
                + "@span:"
                + __to_str(start.line)
                + ":"
                + __to_str(start.column)
                + "-"
                + __to_str(stop.line)
                + ":"
                + __to_str(stop.column);
        }
        if (pos.__tag__ == "SourcePos") {
            return name + "@pos:" + __to_str(pos.line) + ":" + __to_str(pos.column);
        }
        def fallback = _node_pos(pos);
        return name + "@pos:" + __to_str(fallback.line) + ":" + __to_str(fallback.column);
    }

    // ---------------------------------------------------------------------------
    // _accumulate(states, active_state)
    // ---------------------------------------------------------------------------
    // Helper function used by the linter.
    //
    // This function is part of the TinyLanguage linter port and is not intended as a public API.
    //
    // Args:
    //   - states: (Tiny value) See implementation for expected shape.
    //   - active_state: (Tiny value) See implementation for expected shape.
    // Returns:
    //   A Tiny value (type depends on operation).
    // ---------------------------------------------------------------------------
    fn _accumulate(states, active_state) {
        def si = 0;
        while (si < len(states)) {
            def st = heap_get(states, si);
            def keys = Map.keys(st);
            def ki = 0;
            while (ki < len(keys)) {
                def name = heap_get(keys, ki);
                def entry = Map.get(st, name);
                def pos = heap_get(entry, 0);
                def map_key = __usage_key(name, pos);
                def used_all = heap_get(entry, 1);
                def used_any = heap_get(entry, 2);
                def prev = Map.get(usage_summary, map_key, Null);
                if (prev == Null) {
                    def fresh = Map.new();
                    def p1 = Map.set(fresh, "pos", pos);
                    def p22 = Map.set(fresh, "used_any", false);
                    def p32 = Map.set(fresh, "active_all", true);
                    def p42 = Map.set(fresh, "active_present", false);
                    Map.set(usage_summary, map_key, fresh);
                    prev = fresh;
                }
                Map.set(prev, "used_any", Map.get(prev, "used_any") || used_any);
                if (active_state) {
                    def a = Map.set(prev, "active_all", Map.get(prev, "active_all") && used_all);
                    def b = Map.set(prev, "active_present", true);
                }
                ki = ki + 1;
            }
            si = si + 1;
        }
    }

    _accumulate(active, true);
    _accumulate(terminated, false);

    def summary_keys = Map.keys(usage_summary);
    def si = 0;
    while (si < len(summary_keys)) {
        def key = heap_get(summary_keys, si);
        def info = Map.get(usage_summary, key);
        def name_parts = String.split(key, "@");
        def name = heap_get(name_parts, 0);
        if (!(__starts_with_underscore(name) || __starts_with(name, "ignored"))) {
            def used_any = Map.get(info, "used_any");
            def active_all = Map.get(info, "active_all");
            def active_present = Map.get(info, "active_present");
            if (!used_any) {
                def pos = Map.get(info, "pos");
                Collections.push(unused, new[name, pos]);
            } else {
                if (active_present && !active_all) {
                    def pos = Map.get(info, "pos");
                    Collections.push(partial, new[name, pos]);
                }
            }
        }
        si = si + 1;
    }

    if (len(unused) > 0) {
        def names = new[];
        def pos = heap_get(heap_get(unused, 0), 1);
        def ui = 0;
        while (ui < len(unused)) { Collections.push(names, heap_get(heap_get(unused, ui), 0)); ui = ui + 1; }
        def msg = "unused local binding(s): " + String.join(names, ", ");
        if (source == Null) { return __raise_runtime_error(msg); }
        else { _lint_error(source, pos, msg, "E002", "Remove the unused binding or reference it."); }
    }
    if (len(partial) > 0) {
        def names = new[];
        def pos = heap_get(heap_get(partial, 0), 1);
        def ui = 0;
        while (ui < len(partial)) { Collections.push(names, heap_get(heap_get(partial, ui), 0)); ui = ui + 1; }
        def msg = "local binding(s) must be used on all control-flow paths: " + String.join(names, ", ");
        if (source == Null) { return __raise_runtime_error(msg); }
        else { _lint_error(source, pos, msg, "E002", "Ensure the binding is referenced on every path or remove it."); }
    }
}

// ---------------------------------------------------------------------------
// __trim(text)
// ---------------------------------------------------------------------------
// Internal helper used by the linter.
//
// Names starting with `__` are intentionally private and may change without notice.
//
// Args:
//   - text: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn __trim(text) {
    if (text == Null) { return ""; }
    def chars = Python.call("builtins", "list", new[text], PY_LIST_ALLOW);
    def start = 0;
    while (start < len(chars) && heap_get(chars, start) == " ") { start = start + 1; }
    def stop = len(chars) - 1;
    while (stop >= start && heap_get(chars, stop) == " ") { stop = stop - 1; }
    def buf = new[];
    def i = start;
    while (i <= stop) { Collections.push(buf, heap_get(chars, i)); i = i + 1; }
    return String.join(buf, "");
}

// ---------------------------------------------------------------------------
// _infer_expr_type(expr, env)
// ---------------------------------------------------------------------------
// Infer the (approximate) type of an expression.
//
// Used by type-change/compatibility lint rules. The goal is *developer feedback*, not a sound static type system.
//
// Args:
//   - expr: (Tiny value) See implementation for expected shape.
//   - env: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn _infer_expr_type(expr, env) {
    if (expr.__tag__ == "Num") { return "number"; }
    if (expr.__tag__ == "Str") { return "string"; }
    if (expr.__tag__ == "Bool") { return "Bool"; }
    if (expr.__tag__ == "NullLit") { return "Null"; }
    if (expr.__tag__ == "Var") { return Map.get(env, expr.name, Null); }
    return Null;
}

// ---------------------------------------------------------------------------
// __last_char(text)
// ---------------------------------------------------------------------------
// Internal helper used by the linter.
//
// Names starting with `__` are intentionally private and may change without notice.
//
// Args:
//   - text: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn __last_char(text) {
    def chars = Python.call("builtins", "list", new[text], PY_LIST_ALLOW);
    if (len(chars) == 0) { return ""; }
    return heap_get(chars, len(chars) - 1);
}

// ---------------------------------------------------------------------------
// _types_match(expected, actual)
// ---------------------------------------------------------------------------
// Helper function used by the linter.
//
// This function is part of the TinyLanguage linter port and is not intended as a public API.
//
// Args:
//   - expected: (Tiny value) See implementation for expected shape.
//   - actual: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn _types_match(expected, actual) {
    def expected_norm = __trim(expected);
    def actual_norm = __trim(actual);
    def optional = __last_char(expected_norm) == "?";
    def base_expected = expected_norm;
    if (optional && String.len(expected_norm) > 0) { base_expected = String.join(Collections.slice(Python.call("builtins", "list", new[expected_norm], PY_LIST_ALLOW), 0, len(Python.call("builtins", "list", new[expected_norm], PY_LIST_ALLOW)) - 1), ""); }
    def expected_lower = String.lower(base_expected);
    def actual_lower = String.lower(actual_norm);
    if (optional && actual_lower == "null") { return true; }
    if (expected_lower == actual_lower) { return true; }
    if (expected_lower == "number" && (actual_lower == "number" || actual_lower == "int" || actual_lower == "float")) { return true; }
    if (expected_lower == "string" && actual_lower == "string") { return true; }
    if ((expected_lower == "bool" || expected_lower == "boolean") && (actual_lower == "bool" || actual_lower == "boolean")) { return true; }
    if (optional && actual_lower != "null") { return _types_match(base_expected, actual); }
    return false;
}

// ---------------------------------------------------------------------------
// lint_assignment_types(stmts, source, env)
// ---------------------------------------------------------------------------
// Type-change rule: detect suspicious assignments that change the inferred type of a variable.
//
// Helps catch bugs like reusing the same name for unrelated values.
//
// Args:
//   - stmts: (Tiny value) See implementation for expected shape.
//   - source: (Tiny value) See implementation for expected shape.
//   - env: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn lint_assignment_types(stmts, source, env) {
    def base_env = Map.new();
    if (env != Null) {
        def keys = Map.keys(env);
        def i = 0;
        while (i < len(keys)) { def k = heap_get(keys, i); Map.set(base_env, k, Map.get(env, k)); i = i + 1; }
    }

    // ---------------------------------------------------------------------------
    // check_block(block, local_env)
    // ---------------------------------------------------------------------------
    // Helper function used by the linter.
    //
    // This function is part of the TinyLanguage linter port and is not intended as a public API.
    //
    // Args:
    //   - block: (Tiny value) See implementation for expected shape.
    //   - local_env: (Tiny value) See implementation for expected shape.
    //
    // Returns:
    //   A Tiny value (type depends on operation).
    // ---------------------------------------------------------------------------
    fn check_block(block, local_env) {
        def i = 0;
        while (i < len(block)) {
            def st = heap_get(block, i);
            def handled = false;
            if (!handled && st.__tag__ == "Let") {
                def inferred = _infer_expr_type(st.expr, local_env);
                if (inferred != Null) { Map.set(local_env, st.name, inferred); }
                handled = true;
            }
            if (!handled && st.__tag__ == "Assign") {
                def inferred = _infer_expr_type(st.expr, local_env);
                def expected = Map.get(local_env, st.name, Null);
                if (expected != Null && inferred != Null && !_types_match(expected, inferred)) {
                    def msg = "type change for variable " + st.name + ": expected " + expected + " but got " + inferred;
                    if (source == Null) { return __raise_runtime_error(msg); }
                    else { _lint_error(source, st, msg, "E014", "Use a new variable or cast explicitly if a different type is required."); }
                }
                if (inferred != Null) { Map.set(local_env, st.name, inferred); }
                handled = true;
            }
            if (!handled && st.__tag__ == "DestructAssign") {
                def inferred = _infer_expr_type(st.expr, local_env);
                if (inferred != Null) {
                    def ni = 0;
                    while (ni < len(st.names)) { Map.set(local_env, heap_get(st.names, ni), inferred); ni = ni + 1; }
                }
                handled = true;
            }
            if (!handled && st.__tag__ == "If") {
                def then_env = check_block(st.then, __copy_state(local_env));
                def else_env = check_block(st.els, __copy_state(local_env));
                def keys = Map.keys(local_env);
                def ki = 0;
                while (ki < len(keys)) {
                    def name = heap_get(keys, ki);
                    if (Map.get(then_env, name, Null) != Null && Map.get(else_env, name, Null) != Null && Map.get(then_env, name) == Map.get(else_env, name)) {
                        Map.set(local_env, name, Map.get(then_env, name));
                    }
                    ki = ki + 1;
                }
                handled = true;
            }
            if (!handled && st.__tag__ == "While") {
                check_block(st.body, __copy_state(local_env));
                handled = true;
            }
            if (!handled && st.__tag__ == "Switch") {
                def case_envs = new[];
                def ci = 0;
                while (ci < len(st.cases)) {
                    def case_node = heap_get(st.cases, ci);
                    def env_copy = check_block(case_node.body, __copy_state(local_env));
                    Collections.push(case_envs, env_copy);
                    ci = ci + 1;
                }
                def has_default = false;
                ci = 0;
                while (ci < len(st.cases)) {
                    def case_node = heap_get(st.cases, ci);
                    if (case_node.value == Null) { has_default = true; }
                    ci = ci + 1;
                }
                if (!has_default) { Collections.push(case_envs, __copy_state(local_env)); }
                def keys = Map.keys(local_env);
                def ki = 0;
                while (ki < len(keys)) {
                    def name = heap_get(keys, ki);
                    def all_have = true;
                    def distinct = new[];
                    def ei = 0;
                    while (ei < len(case_envs)) {
                        def env_case = heap_get(case_envs, ei);
                        def value = Map.get(env_case, name, Null);
                        if (value == Null) { all_have = false; }
                        else { Collections.push(distinct, value); }
                        ei = ei + 1;
                    }
                    if (all_have && len(distinct) > 0) {
                        def first = heap_get(distinct, 0);
                        def all_same = true;
                        def di = 1;
                        while (di < len(distinct)) {
                            if (heap_get(distinct, di) != first) { all_same = false; }
                            di = di + 1;
                        }
                        if (all_same) { Map.set(local_env, name, first); }
                    }
                    ki = ki + 1;
                }
                handled = true;
            }
            if (!handled && st.__tag__ == "TryCatch") {
                def body_env = check_block(st.body, __copy_state(local_env));
                def handler_env = __copy_state(local_env);
                if (st.err_name != Null) { Map.set(handler_env, st.err_name, "Error"); }
                handler_env = check_block(st.handler, handler_env);
                def keys = Map.keys(local_env);
                def ki = 0;
                while (ki < len(keys)) {
                    def name = heap_get(keys, ki);
                    if (Map.get(body_env, name, Null) != Null && Map.get(handler_env, name, Null) != Null && Map.get(body_env, name) == Map.get(handler_env, name)) {
                        Map.set(local_env, name, Map.get(body_env, name));
                    }
                    ki = ki + 1;
                }
                handled = true;
            }
            if (!handled && st.__tag__ == "Namespace") {
                check_block(st.body, Map.new());
                handled = true;
            }
            if (!handled && st.__tag__ == "Fn") {
                def fn_env = Map.new();
                def pi = 0;
                while (pi < len(st.params)) { def p = heap_get(st.params, pi); if (p.type_hint != Null) { Map.set(fn_env, p.name, p.type_hint); } pi = pi + 1; }
                check_block(st.body, fn_env);
                handled = true;
            }
            if (!handled && st.__tag__ == "MethodDef") {
                def method_env = Map.new();
                def pi = 0;
                while (pi < len(st.params)) { def p = heap_get(st.params, pi); if (p.type_hint != Null) { Map.set(method_env, p.name, p.type_hint); } pi = pi + 1; }
                check_block(st.body, method_env);
                handled = true;
            }
            if (!handled && st.__tag__ == "ClassDef") {
                def mi = 0;
                while (mi < len(st.methods)) {
                    def method_env = Map.new();
                    def pi = 0;
                    def m = heap_get(st.methods, mi);
                    while (pi < len(m.params)) { def p = heap_get(m.params, pi); if (p.type_hint != Null) { Map.set(method_env, p.name, p.type_hint); } pi = pi + 1; }
                    check_block(m.body, method_env);
                    mi = mi + 1;
                }
                handled = true;
            }
            if (!handled && st.__tag__ == "CallStmt") {
                def ai = 0;
                while (ai < len(st.args)) {
                    def arg = heap_get(st.args, ai);
                    def inferred = _infer_expr_type(arg, local_env);
                    if (arg.__tag__ == "Var" && inferred != Null) { Map.set(local_env, arg.name, inferred); }
                    ai = ai + 1;
                }
                handled = true;
            }
            i = i + 1;
        }
        return local_env;
    }

    check_block(stmts, base_env);
}

// ---------------------------------------------------------------------------
// _collect_function_signatures(stmts, prefix)
// ---------------------------------------------------------------------------
// Populate a map of qualified function names to their declared return types.
//
// Names starting with `__` are intentionally private and may change without notice.
//
// Args:
//   - stmts: (Tiny value) See implementation for expected shape.
//   - prefix: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn _collect_function_signatures(stmts, prefix) {
    def sigs = Map.new();

    def base_prefix = prefix;

    // ---------------------------------------------------------------------------
    // qualify(name)
    // ---------------------------------------------------------------------------
    // Internal helper used by the linter.
    //
    // Names starting with `__` are intentionally private and may change without notice.
    //
    // Args:
    //   - name: (Tiny value) See implementation for expected shape.
    //
    // Returns:
    //   A Tiny value (type depends on operation).
    // ---------------------------------------------------------------------------
    fn qualify(name) { if (base_prefix == Null || base_prefix == "") { return name; } return base_prefix + "." + name; }
    def i = 0;
    while (i < len(stmts)) {
        def st = heap_get(stmts, i);
        def handled = false;
        if (!handled && st.__tag__ == "Fn") {
            Map.set(sigs, qualify(st.name), st.return_type);
            handled = true;
        }
        if (!handled && st.__tag__ == "Namespace") {
            def nested = _collect_function_signatures(st.body, qualify(st.name));
            def keys = Map.keys(nested);
            def j = 0;
            while (j < len(keys)) { def k = heap_get(keys, j); Map.set(sigs, k, Map.get(nested, k)); j = j + 1; }
            handled = true;
        }
        i = i + 1;
    }
    return sigs;
}

// ---------------------------------------------------------------------------
// __return_type_is_void(annotation)
// ---------------------------------------------------------------------------
// Internal helper used by the linter.
//
// Args:
//   - annotation: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn __return_type_is_void(annotation) {
    if (annotation == Null) { return false; }
    def trimmed = __trim(annotation);
    def lowered = String.lower(trimmed);
    return lowered == "null" || lowered == "null?";
}

// ---------------------------------------------------------------------------
// __block_returns_value(block)
// ---------------------------------------------------------------------------
// Internal helper used by the linter.
//
// Args:
//   - block: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn __block_returns_value(block) {
    def i = 0;
    while (i < len(block)) {
        def st = heap_get(block, i);
        if (st.__tag__ == "Return") {
            if (st.expr.__tag__ != "Null") { return true; }
        } else {
            if (st.__tag__ == "If") {
                if (__block_returns_value(st.then) || __block_returns_value(st.els)) { return true; }
            } else {
                if (st.__tag__ == "While") {
                    if (__block_returns_value(st.body)) { return true; }
                } else {
                    if (st.__tag__ == "Switch") {
                        def ci = 0;
                        while (ci < len(st.cases)) { if (__block_returns_value(heap_get(st.cases, ci).body)) { return true; } ci = ci + 1; }
                    } else {
                        if (st.__tag__ == "TryCatch") {
                            if (__block_returns_value(st.body) || __block_returns_value(st.handler)) { return true; }
                        } else {
                            if (st.__tag__ == "TaskBlock") {
                                if (__block_returns_value(st.body)) { return true; }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return false;
}

// ---------------------------------------------------------------------------
// __function_returns_value(fn_node)
// ---------------------------------------------------------------------------
// Internal helper used by the linter.
//
// Args:
//   - fn_node: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn __function_returns_value(fn_node) {
    if (fn_node.return_type != Null) { return !__return_type_is_void(fn_node.return_type); }
    return __block_returns_value(fn_node.body);
}

// ---------------------------------------------------------------------------
// __collect_function_return_values(stmts, prefix)
// ---------------------------------------------------------------------------
// Internal helper used by the linter.
//
// Args:
//   - stmts: (Tiny value) See implementation for expected shape.
//   - prefix: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn __collect_function_return_values(stmts, prefix) {
    def values = Map.new();
    def base_prefix = prefix;
    fn qualify(name) { if (base_prefix == Null || base_prefix == "") { return name; } return base_prefix + "." + name; }
    def i = 0;
    while (i < len(stmts)) {
        def st = heap_get(stmts, i);
        def handled = false;
        if (!handled && st.__tag__ == "Fn") {
            Map.set(values, qualify(st.name), __function_returns_value(st));
            handled = true;
        }
        if (!handled && st.__tag__ == "Namespace") {
            def nested = __collect_function_return_values(st.body, qualify(st.name));
            def keys = Map.keys(nested);
            def j = 0;
            while (j < len(keys)) { def k = heap_get(keys, j); Map.set(values, k, Map.get(nested, k)); j = j + 1; }
            handled = true;
        }
        i = i + 1;
    }
    return values;
}

// ---------------------------------------------------------------------------
// lint_bare_call_results(stmts, signatures, source)
// ---------------------------------------------------------------------------
// Must-use rule: forbid bare call statements.
//
// In TinyLanguage every call result must be used (bound, returned, or otherwise consumed). This lint flags call statements whose return value is ignored.
//
// Args:
//   - stmts: (Tiny value) See implementation for expected shape.
//   - signatures: (Tiny value) See implementation for expected shape.
//   - source: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn lint_bare_call_results(stmts, signatures, source) {
    if (signatures == Null) { }
    def returns_value = __collect_function_return_values(stmts, "");
    Map.set(returns_value, "heap_set", true);
    Map.set(returns_value, "heap_get", true);

    fn __is_allowed_call_stmt(name) {
        if (name == "delete" || name == "tag" || name == "join" || name == "parse_program") { return true; }
        if (__starts_with(name, "Collections.")) { return true; }
        if (__starts_with(name, "Map.")) { return true; }
        if (__starts_with(name, "Set.")) { return true; }
        if (__starts_with(name, "Deque.")) { return true; }
        if (__starts_with(name, "Async.")) { return true; }
        if (__starts_with(name, "Result.")) { return true; }
        if (__starts_with(name, "String.")) { return true; }
        if (__starts_with(name, "Console.")) { return true; }
        if (__starts_with(name, "File.")) { return true; }
        if (__starts_with(name, "JSON.")) { return true; }
        if (__starts_with(name, "Python.")) { return true; }
        if (__starts_with(name, "Random.")) { return true; }
        return false;
    }

    fn __call_returns_value(expr) {
        if (expr.__tag__ == "Call") {
            return Map.get(returns_value, expr.name, false) == true;
        }
        if (expr.__tag__ == "MethodCall" && expr.obj.__tag__ == "Var") {
            def qualified = expr.obj.name + "." + expr.name;
            return Map.get(returns_value, qualified, false) == true;
        }
        return false;
    }

    fn __binding_discarded(name) {
        return __starts_with_underscore(name) || __starts_with(name, "ignored");
    }

    // ---------------------------------------------------------------------------
    // visit(block)
    // ---------------------------------------------------------------------------
    // Helper function used by the linter.
    //
    // This function is part of the TinyLanguage linter port and is not intended as a public API.
    //
    // Args:
    //   - block: (Tiny value) See implementation for expected shape.
    //
    // Returns:
    //   A Tiny value (type depends on operation).
    // ---------------------------------------------------------------------------
    fn visit(block) {
        def bi = 0;
        while (bi < len(block)) {
            def st = heap_get(block, bi);
            def handled = false;
            if (!handled && st.__tag__ == "CallStmt") {
                def returns_flag = Map.get(returns_value, st.name, Null);
                if (__is_allowed_call_stmt(st.name) || returns_flag == false) { handled = true; }
                else {
                def msg = "call with return value must be bound; bare call statements are not allowed";
                def hint = "Bind the return value, e.g. `def result = call();`, or add a return that includes the mutated data.";
                if (source == Null) { return __raise_runtime_error(msg); }
                else { _lint_error(source, st, msg, "E001", hint); }
                handled = true;
                }
            }
            if (!handled && (st.__tag__ == "Let" || st.__tag__ == "Assign")) {
                if (__binding_discarded(st.name) && __call_returns_value(st.expr)) {
                    def msg = "call with return value must be bound; bare call statements are not allowed";
                    def hint = "Bind the return value, e.g. `def result = call();`, or add a return that includes the mutated data.";
                    if (source == Null) { return __raise_runtime_error(msg); }
                    else { _lint_error(source, st, msg, "E001", hint); }
                    handled = true;
                }
            }
            if (!handled && st.__tag__ == "If") { visit(st.then); visit(st.els); handled = true; }
            if (!handled && st.__tag__ == "While") { visit(st.body); handled = true; }
            if (!handled && st.__tag__ == "TryCatch") { visit(st.body); visit(st.handler); handled = true; }
            if (!handled && st.__tag__ == "Namespace") { visit(st.body); handled = true; }
            if (!handled && st.__tag__ == "ClassDef") {
                def mi = 0;
                while (mi < len(st.methods)) { visit(heap_get(st.methods, mi).body); mi = mi + 1; }
            }
            bi = bi + 1;
        }
    }

    visit(stmts);
}

// ---------------------------------------------------------------------------
// __import_sort_key(imp)
// ---------------------------------------------------------------------------
// Internal helper used by the linter.
//
// Names starting with `__` are intentionally private and may change without notice.
//
// Args:
//   - imp: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn __import_sort_key(imp) {
    def alias = "";
    if (imp.alias != Null) { alias = imp.alias; }
    return imp.module + "::" + alias;
}

// ---------------------------------------------------------------------------
// __sorted_imports(imports)
// ---------------------------------------------------------------------------
// Internal helper used by the linter.
//
// Names starting with `__` are intentionally private and may change without notice.
//
// Args:
//   - imports: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn __sorted_imports(imports) {
    def arr = new[];
    def i = 0;
    while (i < len(imports)) { Collections.push(arr, heap_get(imports, i)); i = i + 1; }
    def n = len(arr);
    def a = 0;
    // ---------------------------------------------------------------------------
    // _swap(list, idx_a, idx_b)
    // ---------------------------------------------------------------------------
    // Helper function used by the linter.
    //
    // This function is part of the TinyLanguage linter port and is not intended as a public API.
    //
    // Args:
    //   - list: (Tiny value) See implementation for expected shape.
    //   - idx_a: (Tiny value) See implementation for expected shape.
    //   - idx_b: (Tiny value) See implementation for expected shape.
    //
    // Returns:
    //   A Tiny value (type depends on operation).
    // ---------------------------------------------------------------------------
    fn _swap(list, idx_a, idx_b) {
        def out = new[];
        def si = 0;
        while (si < len(list)) {
            if (si == idx_a) {
                Collections.push(out, heap_get(list, idx_b));
            } else {
                if (si == idx_b) { Collections.push(out, heap_get(list, idx_a)); }
                else { Collections.push(out, heap_get(list, si)); }
            }
            si = si + 1;
        }
        return out;
    }
    while (a < n) {
        def b = a + 1;
        while (b < n) {
            def ia = heap_get(arr, a);
            def ib = heap_get(arr, b);
            if (__import_sort_key(ib) < __import_sort_key(ia)) {
                arr = _swap(arr, a, b);
            }
            b = b + 1;
        }
        a = a + 1;
    }
    return arr;
}

// ---------------------------------------------------------------------------
// lint_import_style(stmts, source)
// ---------------------------------------------------------------------------
// Import style rule: enforce consistent import forms and naming.
//
// Also validates aliasing rules and produces stable, testable error codes/messages.
//
// Args:
//   - stmts: (Tiny value) See implementation for expected shape.
//   - source: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn lint_import_style(stmts, source) {
    def imports = new[];
    def i = 0;
    def collecting = true;
    while (i < len(stmts) && collecting) {
        def st = heap_get(stmts, i);
        if (st.__tag__ == "Import") {
            Collections.push(imports, st);
            i = i + 1;
        } else {
            collecting = false;
        }
    }

    def ordered = __sorted_imports(imports);
    if (len(imports) > 0) {
        def mismatch = false;
        def idx = 0;
        while (idx < len(imports)) {
            def imp = heap_get(imports, idx);
            def ord = heap_get(ordered, idx);
            def alias_imp = Null;
            def alias_ord = Null;
            if (imp.alias != Null) { alias_imp = imp.alias; }
            if (ord.alias != Null) { alias_ord = ord.alias; }
            if (!(imp.module == ord.module && alias_imp == alias_ord)) {
                mismatch = true;
                idx = len(imports);
            } else {
                idx = idx + 1;
            }
        }
        if (mismatch) {
            def first_misordered = heap_get(imports, 0);
            def msg = "imports are not sorted alphabetically";
            def hint = "Sort the leading import block alphabetically to keep module headers consistent.";
            if (source == Null) { return __raise_runtime_error(msg); }
            else { _lint_error(source, first_misordered, msg, "E012", hint); }
        }
    }

    def j = 0;
    while (j < len(stmts)) {
        def st = heap_get(stmts, j);
        if (st.__tag__ == "Namespace") { lint_import_style(st.body, source); }
        j = j + 1;
    }
}

// ---------------------------------------------------------------------------
// lint_destruct_call_outputs(stmts, source)
// ---------------------------------------------------------------------------
// Destructuring rule: ensure destructuring matches the shape of the produced value.
//
// In particular, destructuring of call results must bind all produced fields/names, mirroring the project's 'must-use' philosophy.
//
// Args:
//   - stmts: (Tiny value) See implementation for expected shape.
//   - source: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn lint_destruct_call_outputs(stmts, source) {
    def i = 0;
    while (i < len(stmts)) { lint_destruct_call_outputs_stmt(heap_get(stmts, i), source); i = i + 1; }
}

// ---------------------------------------------------------------------------
// _return_signature(expr)
// ---------------------------------------------------------------------------
// Helper function used by the linter.
//
// This function is part of the TinyLanguage linter port and is not intended as a public API.
//
// Args:
//   - expr: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn _return_signature(expr) {
    def result = new["<scalar>"];
    if (expr.__tag__ == "ObjLit") {
        result = new[];
        def i = 0;
        while (i < len(expr.fields)) { def pair = heap_get(expr.fields, i); Collections.push(result, heap_get(pair, 0)); i = i + 1; }
    } else {
        if (expr.__tag__ == "NewLit") {
            result = new[];
            def i = 0;
            while (i < len(expr.items)) { Collections.push(result, __to_str(i)); i = i + 1; }
        }
    }
    return result;
}

// ---------------------------------------------------------------------------
// __sig_equal(a, b)
// ---------------------------------------------------------------------------
// Internal helper used by the linter.
//
// Names starting with `__` are intentionally private and may change without notice.
//
// Args:
//   - a: (Tiny value) See implementation for expected shape.
//   - b: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn __sig_equal(a, b) {
    if (len(a) != len(b)) { return false; }
    def i = 0;
    while (i < len(a)) { if (heap_get(a, i) != heap_get(b, i)) { return false; } i = i + 1; }
    return true;
}

// ---------------------------------------------------------------------------
// _format_signature(sig)
// ---------------------------------------------------------------------------
// Helper function used by the linter.
//
// This function is part of the TinyLanguage linter port and is not intended as a public API.
//
// Args:
//   - sig: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn _format_signature(sig) {
    if (len(sig) == 1 && heap_get(sig, 0) == "<scalar>") { return "single value"; }
    return "{" + String.join(sig, ", ") + "}";
}

// ---------------------------------------------------------------------------
// _is_optional_annotation(annotation)
// ---------------------------------------------------------------------------
// Helper function used by the linter.
//
// This function is part of the TinyLanguage linter port and is not intended as a public API.
//
// Args:
//   - annotation: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn _is_optional_annotation(annotation) {
    if (annotation == Null) { return false; }
    def trimmed = __trim(annotation);
    if (trimmed == "") { return false; }
    return __last_char(trimmed) == "?";
}

// ---------------------------------------------------------------------------
// _block_guarantees_return(stmts)
// ---------------------------------------------------------------------------
// Helper function used by the linter.
//
// This function is part of the TinyLanguage linter port and is not intended as a public API.
//
// Args:
//   - stmts: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn _block_guarantees_return(stmts) {
    def i = 0;
    while (i < len(stmts)) {
        def st = heap_get(stmts, i);
        if (st.__tag__ == "Return") { return true; }
        if (st.__tag__ == "If") { if (_block_guarantees_return(st.then) && _block_guarantees_return(st.els)) { return true; } }
        if (st.__tag__ == "Switch") {
            def has_default = false;
            def all_return = true;
            def ci = 0;
            while (ci < len(st.cases)) {
                def case_node = heap_get(st.cases, ci);
                if (case_node.value == Null) { has_default = true; }
                if (!_block_guarantees_return(case_node.body)) { all_return = false; }
                ci = ci + 1;
            }
            if (has_default && all_return) { return true; }
        }
        if (st.__tag__ == "TryCatch") { if (_block_guarantees_return(st.body) && _block_guarantees_return(st.handler)) { return true; } }
        i = i + 1;
    }
    return false;
}

// ---------------------------------------------------------------------------
// _stmt_guarantees_exit(st)
// ---------------------------------------------------------------------------
// Helper function used by the linter.
//
// This function is part of the TinyLanguage linter port and is not intended as a public API.
//
// Args:
//   - st: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn _stmt_guarantees_exit(st) {
    if (st.__tag__ == "Return") { return true; }
    if (st.__tag__ == "If") { return _block_guarantees_return(st.then) && _block_guarantees_return(st.els); }
    if (st.__tag__ == "Switch") {
        def has_default = false;
        def all_return = true;
        def ci = 0;
        while (ci < len(st.cases)) {
            def case_node = heap_get(st.cases, ci);
            if (case_node.value == Null) { has_default = true; }
            if (!_block_guarantees_return(case_node.body)) { all_return = false; }
            ci = ci + 1;
        }
        return has_default && all_return;
    }
    if (st.__tag__ == "TryCatch") { return _block_guarantees_return(st.body) && _block_guarantees_return(st.handler); }
    if (st.__tag__ == "While") { return st.cond.__tag__ == "Bool" && st.cond.value; }
    return false;
}

// ---------------------------------------------------------------------------
// lint_return_signatures(stmts, fn_name, is_method, source, _pos)
// ---------------------------------------------------------------------------
// Return rule: ensure return statements are compatible with declared/expected return types.
//
// Also checks return placement and expression presence according to the TinyLanguage AST conventions.
//
// Args:
//   - stmts: (Tiny value) See implementation for expected shape.
//   - fn_name: (Tiny value) See implementation for expected shape.
//   - is_method: (Tiny value) See implementation for expected shape.
//   - source: (Tiny value) See implementation for expected shape.
//   - _pos: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn lint_return_signatures(stmts, fn_name, is_method, source, _pos) {
    def expected = Null;
    def hint = "Ensure every return statement uses the same tuple/record structure (fields and order).";

    // ---------------------------------------------------------------------------
    // visit(block)
    // ---------------------------------------------------------------------------
    // Helper function used by the linter.
    //
    // This function is part of the TinyLanguage linter port and is not intended as a public API.
    //
    // Args:
    //   - block: (Tiny value) See implementation for expected shape.
    //
    // Returns:
    //   A Tiny value (type depends on operation).
    // ---------------------------------------------------------------------------
    fn visit(block) {
        def i = 0;
        while (i < len(block)) {
            def st = heap_get(block, i);
            def handled = false;
            if (!handled && st.__tag__ == "Return") {
                def sig = _return_signature(st.expr);
                if (expected == Null) { expected = sig; }
                else {
                    if (!__sig_equal(sig, expected)) {
                        def kind = "function";
                        if (is_method) { kind = "method"; }
                        def msg = "inconsistent return signature in " + kind + " " + fn_name + ": expected " + _format_signature(expected) + " but found " + _format_signature(sig);
                        if (source == Null) { return __raise_runtime_error(msg); }
                        else { _lint_error(source, st, msg, "E007", hint); }
                    }
                }
                handled = true;
            }
            if (!handled && st.__tag__ == "If") { visit(st.then); visit(st.els); handled = true; }
            if (!handled && st.__tag__ == "While") { visit(st.body); handled = true; }
            if (!handled && st.__tag__ == "Switch") {
                def ci = 0;
                while (ci < len(st.cases)) { visit(heap_get(st.cases, ci).body); ci = ci + 1; }
                handled = true;
            }
            if (!handled && st.__tag__ == "TryCatch") { visit(st.body); visit(st.handler); }
            i = i + 1;
        }
    }

    visit(stmts);
}

// ---------------------------------------------------------------------------
// lint_return_exhaustiveness(stmts, fn_name, expected_return, is_method, source, location)
// ---------------------------------------------------------------------------
// Return exhaustiveness: ensure all control-flow paths return a value when required.
//
// This mirrors the Python linter's path analysis for functions with non-void return expectations.
//
// Args:
//   - stmts: (Tiny value) See implementation for expected shape.
//   - fn_name: (Tiny value) See implementation for expected shape.
//   - expected_return: (Tiny value) See implementation for expected shape.
//   - is_method: (Tiny value) See implementation for expected shape.
//   - source: (Tiny value) See implementation for expected shape.
//   - location: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn lint_return_exhaustiveness(stmts, fn_name, expected_return, is_method, source, location) {
    if (expected_return == Null) { return Null; }
    if (_is_optional_annotation(expected_return)) { return Null; }
    if (_block_guarantees_return(stmts)) { return Null; }
    def kind = "function";
    if (is_method) { kind = "method"; }
    def msg = "not all paths in " + kind + " " + fn_name + " return a value for annotated type " + expected_return;
    if (source == Null) { return __raise_runtime_error(msg); }
    else { _lint_error(source, location, msg, "E010", "Add return statements for every branch or provide a default return to satisfy the annotation."); }
}

// ---------------------------------------------------------------------------
// lint_unreachable_code(stmts, source)
// ---------------------------------------------------------------------------
// Detect unreachable statements after a guaranteed-terminating statement (e.g. `return`).
//
// This improves code clarity and helps catch dead code left behind after refactors.
//
// Args:
//   - stmts: (Tiny value) See implementation for expected shape.
//   - source: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn lint_unreachable_code(stmts, source) {
    // ---------------------------------------------------------------------------
    // visit_block(block)
    // ---------------------------------------------------------------------------
    // Helper function used by the linter.
    //
    // This function is part of the TinyLanguage linter port and is not intended as a public API.
    //
    // Args:
    //   - block: (Tiny value) See implementation for expected shape.
    //
    // Returns:
    //   A Tiny value (type depends on operation).
    // ---------------------------------------------------------------------------
    fn visit_block(block) {
        def terminated = false;
        def i = 0;
        while (i < len(block)) {
            def st = heap_get(block, i);
            if (terminated) {
                def msg = "unreachable statement after a guaranteed exit";
                if (source == Null) { return __raise_runtime_error(msg); }
                else { _lint_error(source, st, msg, "E013", "Remove the dead code or restructure control flow so it can be reached."); }
            }
            def handled = false;
            if (!handled && st.__tag__ == "If") { visit_block(st.then); visit_block(st.els); handled = true; }
            if (!handled && st.__tag__ == "While") { visit_block(st.body); handled = true; }
            if (!handled && st.__tag__ == "Switch") {
                def ci = 0;
                while (ci < len(st.cases)) { visit_block(heap_get(st.cases, ci).body); ci = ci + 1; }
                handled = true;
            }
            if (!handled && st.__tag__ == "TryCatch") { visit_block(st.body); visit_block(st.handler); handled = true; }
            if (!handled && st.__tag__ == "Fn") { visit_block(st.body); handled = true; }
            if (!handled && st.__tag__ == "MethodDef") { visit_block(st.body); handled = true; }
            if (!handled && st.__tag__ == "ClassDef") { def mi = 0; while (mi < len(st.methods)) { visit_block(heap_get(st.methods, mi).body); mi = mi + 1; } handled = true; }
            if (!handled && st.__tag__ == "Namespace") { visit_block(st.body); }
            if (_stmt_guarantees_exit(st)) { terminated = true; }
            i = i + 1;
        }
    }

    visit_block(stmts);
}

// ---------------------------------------------------------------------------
// lint_no_consecutive_definitions(stmts)
// ---------------------------------------------------------------------------
// Style rule: avoid consecutive `def` statements when they could be combined or simplified.
//
// Keeps Tiny examples/tutorials more readable; may be relaxed depending on project direction.
//
// Args:
//   - stmts: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn lint_no_consecutive_definitions(stmts) {
    def prev = Null;

    // ---------------------------------------------------------------------------
    // check_block(block)
    // ---------------------------------------------------------------------------
    // Helper function used by the linter.
    //
    // This function is part of the TinyLanguage linter port and is not intended as a public API.
    //
    // Args:
    //   - block: (Tiny value) See implementation for expected shape.
    //
    // Returns:
    //   A Tiny value (type depends on operation).
    // ---------------------------------------------------------------------------
    fn check_block(block) {
        prev = Null;
        def i = 0;
        while (i < len(block)) {
            def st = heap_get(block, i);
            def handled = false;
            if (!handled && (st.__tag__ == "If" || st.__tag__ == "While" || st.__tag__ == "Switch")) {
                if (st.__tag__ == "If") { lint_no_consecutive_definitions(st.then); lint_no_consecutive_definitions(st.els); }
                else {
                    if (st.__tag__ == "While") { lint_no_consecutive_definitions(st.body); }
                    else {
                        def ci = 0;
                        while (ci < len(st.cases)) { lint_no_consecutive_definitions(heap_get(st.cases, ci).body); ci = ci + 1; }
                    }
                }
                prev = Null;
                handled = true;
            }
            if (!handled && st.__tag__ == "Fn") { lint_no_consecutive_definitions(st.body); prev = Null; handled = true; }
            if (!handled && st.__tag__ == "MethodDef") { lint_no_consecutive_definitions(st.body); prev = Null; handled = true; }
            if (!handled && st.__tag__ == "ClassDef") {
                def mi = 0;
                while (mi < len(st.methods)) { lint_no_consecutive_definitions(heap_get(st.methods, mi).body); mi = mi + 1; }
                prev = Null;
                handled = true;
            }
            if (!handled && st.__tag__ == "Namespace") { lint_no_consecutive_definitions(st.body); prev = Null; handled = true; }
            if (!handled && st.__tag__ == "TryCatch") { lint_no_consecutive_definitions(st.body); lint_no_consecutive_definitions(st.handler); prev = Null; handled = true; }
            if (!handled) {
                def current = Null;
                if (st.__tag__ == "Let") { current = st.name; }
                if (current != Null && prev == current) { return __raise_runtime_error("variable " + current + " defined twice in a row"); }
                prev = current;
            }
            i = i + 1;
        }
    }

    check_block(stmts);
}

// ---------------------------------------------------------------------------
// lint_destruct_call_outputs_stmt(st, source)
// ---------------------------------------------------------------------------
// Statement-level helper for destructuring-output lint.
//
// Separates statement traversal concerns from expression-specific checks.
//
// Args:
//   - st: (Tiny value) See implementation for expected shape.
//   - source: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn lint_destruct_call_outputs_stmt(st, source) {
    def handled = false;
    if (!handled && st.__tag__ == "DestructAssign") { check_destruct_call_expr(st.expr, Set.from_list(st.names), source, st.pos); handled = true; }
    if (!handled && st.__tag__ == "If") { lint_destruct_call_outputs(st.then, source); lint_destruct_call_outputs(st.els, source); handled = true; }
    if (!handled && st.__tag__ == "While") { lint_destruct_call_outputs(st.body, source); handled = true; }
    if (!handled && st.__tag__ == "Switch") {
        def ci = 0;
        while (ci < len(st.cases)) { lint_destruct_call_outputs(heap_get(st.cases, ci).body, source); ci = ci + 1; }
        handled = true;
    }
    if (!handled && st.__tag__ == "Fn") { lint_destruct_call_outputs(st.body, source); handled = true; }
    if (!handled && st.__tag__ == "MethodDef") { lint_destruct_call_outputs(st.body, source); handled = true; }
    if (!handled && st.__tag__ == "ClassDef") { def mi = 0; while (mi < len(st.methods)) { lint_destruct_call_outputs_stmt(heap_get(st.methods, mi), source); mi = mi + 1; } handled = true; }
    if (!handled && st.__tag__ == "Namespace") { lint_destruct_call_outputs(st.body, source); handled = true; }
    if (!handled && st.__tag__ == "TryCatch") { lint_destruct_call_outputs(st.body, source); lint_destruct_call_outputs(st.handler, source); }
}

// ---------------------------------------------------------------------------
// check_destruct_call_expr(expr, names, source, pos)
// ---------------------------------------------------------------------------
// Helper function used by the linter.
//
// This function is part of the TinyLanguage linter port and is not intended as a public API.
//
// Args:
//   - expr: (Tiny value) See implementation for expected shape.
//   - names: (Tiny value) See implementation for expected shape.
//   - source: (Tiny value) See implementation for expected shape.
//   - pos: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn check_destruct_call_expr(expr, names, source, pos) {
    if (expr.__tag__ == "Call") {
        def skip = Set.from_list(new["heap_set", "heap_get", "delete", "tag", "__new", "new"]);
        if (Set.has(skip, expr.name)) { return Null; }
        def missing_set = Set.new();
        def i = 0;
        while (i < len(expr.args)) {
            def arg = heap_get(expr.args, i);
            if (arg.__tag__ == "Var" && !Set.has(names, arg.name)) { Set.add(missing_set, arg.name); }
            i = i + 1;
        }
        def missing = __sorted_strings(Set.to_list(missing_set));
        if (len(missing) > 0) {
            def msg = "destructuring call to " + expr.name + " must include output for argument(s): " + String.join(missing, ", ");
            if (source != Null) { _lint_error(source, pos, msg, "E006", "Add the missing binding(s) to the destructuring pattern so each referenced argument is captured."); }
            else { return __raise_runtime_error(msg); }
        }
    } else {
        if (expr.__tag__ == "MethodCall") {
            def missing_set = Set.new();
            def i = 0;
            while (i < len(expr.args)) {
                def arg = heap_get(expr.args, i);
                if (arg.__tag__ == "Var" && !Set.has(names, arg.name)) { Set.add(missing_set, arg.name); }
                i = i + 1;
            }
            def missing = __sorted_strings(Set.to_list(missing_set));
            if (len(missing) > 0) {
                def msg = "destructuring method call to " + expr.name + " must include output for argument(s): " + String.join(missing, ", ");
                if (source != Null) { _lint_error(source, pos, msg, "E006", "Add the missing binding(s) to the destructuring pattern so each referenced argument is captured."); }
                else { return __raise_runtime_error(msg); }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// lint_param_mutations_returned(stmts, params, fn_name, is_method, source, pos)
// ---------------------------------------------------------------------------
// Mutation rule: ensure mutated parameters are returned when the API expects it.
//
// This enforces a design where functions that mutate inputs make that mutation observable to the caller (important with the project's 'must-use' discipline).
//
// Args:
//   - stmts: (Tiny value) See implementation for expected shape.
//   - params: (Tiny value) See implementation for expected shape.
//   - fn_name: (Tiny value) See implementation for expected shape.
//   - is_method: (Tiny value) See implementation for expected shape.
//   - source: (Tiny value) See implementation for expected shape.
//   - pos: (Tiny value) See implementation for expected shape.
//
// Returns:
//   A Tiny value (type depends on operation).
// ---------------------------------------------------------------------------
fn lint_param_mutations_returned(stmts, params, fn_name, is_method, source, pos) {
    def mutated = Set.new();
    def returned = Set.new();

    // ---------------------------------------------------------------------------
    // visit(st)
    // ---------------------------------------------------------------------------
    // Helper function used by the linter.
    //
    // This function is part of the TinyLanguage linter port and is not intended as a public API.
    //
    // Args:
    //   - st: (Tiny value) See implementation for expected shape.
    //
    // Returns:
    //   A Tiny value (type depends on operation).
    // ---------------------------------------------------------------------------
    fn visit(st) {
        def handled = false;
        if (!handled && st.__tag__ == "Assign" && Set.has(params, st.name)) { Set.add(mutated, st.name); handled = true; }
        if (!handled && st.__tag__ == "FieldAssign" && st.obj.__tag__ == "Var" && Set.has(params, st.obj.name)) { Set.add(mutated, st.obj.name); handled = true; }
        if (!handled && st.__tag__ == "DestructAssign") { def i = 0; while (i < len(st.names)) { def nm = heap_get(st.names, i); if (Set.has(params, nm)) { Set.add(mutated, nm); } i = i + 1; } handled = true; }
        if (!handled && st.__tag__ == "Return") {
            def reads = Map.new(); uses_in_expr(st.expr, reads);
            def keys = Map.keys(reads);
            def i = 0;
            while (i < len(keys)) { def n = heap_get(keys, i); if (Set.has(params, n)) { Set.add(returned, n); } i = i + 1; }
            handled = true;
        }
        if (!handled && st.__tag__ == "If") { def i = 0; while (i < len(st.then)) { visit(heap_get(st.then, i)); i = i + 1; } i = 0; while (i < len(st.els)) { visit(heap_get(st.els, i)); i = i + 1; } handled = true; }
        if (!handled && st.__tag__ == "TryCatch") { def i = 0; while (i < len(st.body)) { visit(heap_get(st.body, i)); i = i + 1; } i = 0; while (i < len(st.handler)) { visit(heap_get(st.handler, i)); i = i + 1; } handled = true; }
        if (!handled && st.__tag__ == "While") { def i = 0; while (i < len(st.body)) { visit(heap_get(st.body, i)); i = i + 1; } }
        if (!handled && st.__tag__ == "Switch") {
            def ci = 0;
            while (ci < len(st.cases)) {
                def case_node = heap_get(st.cases, ci);
                def bi = 0;
                while (bi < len(case_node.body)) { visit(heap_get(case_node.body, bi)); bi = bi + 1; }
                ci = ci + 1;
            }
        }
    }

    def i = 0;
    while (i < len(stmts)) { visit(heap_get(stmts, i)); i = i + 1; }

    def missing = __sorted_strings(Set.to_list(Set.difference(mutated, returned)));
    if (len(missing) > 0) {
        def kind = "function";
        if (is_method) { kind = "method"; }
        def msg = "mutated parameter(s) in " + kind + " " + fn_name + " must be returned: " + String.join(missing, ", ");
        if (source == Null) { return __raise_runtime_error(msg); }
        else { _lint_error(source, pos, msg, "E001", "Return the mutated parameters so callers receive the updates."); }
    }
}
