fn total_seconds(days, seconds) {
  def allow = new[
    "datetime_isoformat",
    "date_isoformat",
    "time_isoformat",
    "timedelta_total_seconds"
  ];
  def args = new[days, seconds];
  def result = Python.call(
    "stdlib_datetime",
    "timedelta_total_seconds",
    args,
    { allow: allow }
