                                return __raise_runtime_error("Unsupported statement: " + __to_str(stmt));
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }
        return rendered;
    }

    fn from_source(self, code) {
        def lines = __tokenize_brace_lines(code);
        def functions = new[];
        def body = new[];
        def i = 0;
        while (i < len(lines)) {
            def line = heap_get(lines, i);
            if (__starts_with(line, "auto ")) {
                def signature = __strip_prefix(line, "auto ");
                def open = __find_char(signature, "(");
                def close = __find_char(signature, ")");
                if (open < 0 || close < 0 || close < open) { return __raise_runtime_error("Invalid C++ function signature: " + line); }
                def name = __strip(String.join(Collections.slice(__chars(signature), 0, open), ""));
                def params_text = String.join(Collections.slice(__chars(signature), open + 1, close), "");
                def raw_params = __split_params(params_text);
                def params = new[];
                def pi = 0;
                while (pi < len(raw_params)) {
                    def param = __strip(heap_get(raw_params, pi));
                    if (__starts_with(param, "auto ")) { param = __strip_prefix(param, "auto "); }
                    def _unused88 = Collections.push(params, param);
                    pi = pi + 1;
                }
                def body_start = __block_start_index(lines, i, line, "C++ function");
                def fn_info = __parse_brace_block(lines, body_start, "C++");
                def fn_body = heap_get(fn_info, 0);
                def j = heap_get(fn_info, 1);
                if (j >= len(lines) || heap_get(lines, j) != "}") { return __raise_runtime_error("Unterminated C++ function body"); }
                def _unused89 = Collections.push(functions, FunctionIR(name, params, fn_body));
                i = j + 1;
            } else {
                def block_info = __parse_brace_block(lines, i, "C++");
                def block = heap_get(block_info, 0);
                def j = heap_get(block_info, 1);
                def _ = __extend(body, block);
                i = j;
            }
        }
        return ProgramIR(functions, body);
    }
}

fn CppTranspiler() {
    return new CppTranspiler { indent: "  " };
}

// ----- TinyLanguage -----

class TinyLanguageTranspiler: LanguageTranspiler {
    indent: string;
    unused_counter: number;

    fn _next_unused(self, defined) {
        while (true) {
            self.unused_counter = self.unused_counter + 1;
            def name = "__unused" + __to_str(self.unused_counter);
            if (Map.get(defined, name) == Null) { return name; }
        }
    }

    fn _render_literal(self, value) {
        if (value == true) { return "true"; }
        if (value == false) { return "false"; }
        if (value == Null) { return "null"; }
        if (__is_repr_string(value)) { return __json_dump(value); }
        return __to_repr(value);
    }

    fn to_source(self, program) {
        self.unused_counter = 0;
        def chunks = new[];
        def idx = 0;
        while (idx < len(program.functions)) {
            def _unused91 = Collections.push(chunks, self._render_function(heap_get(program.functions, idx)));
            if (idx < len(program.functions) - 1) { def _blank = Collections.push(chunks, ""); }
            idx = idx + 1;
        }
        if (len(program.body) > 0) {
            if (len(chunks) > 0) { def _blank2 = Collections.push(chunks, ""); }
            def body_lines = self._render_statements(program.body, 0, Map.new());
            def bi = 0;
            while (bi < len(body_lines)) { def _unused92 = Collections.push(chunks, heap_get(body_lines, bi)); bi = bi + 1; }
        }
        return self._lines(chunks);
    }

    fn _render_function(self, fn_ir) {
        def defined = Map.new();
        def i = 0;
        while (i < len(fn_ir.params)) { def _unused93 = Map.set(defined, heap_get(fn_ir.params, i), true); i = i + 1; }
        def header = "fn " + fn_ir.name + "(" + String.join(fn_ir.params, ", ") + ") {";
        def body_lines = self._render_statements(fn_ir.body, 1, defined);
        if (len(body_lines) == 0) { body_lines = new[self.indent + "// no-op"]; }
        def lines = new[header];
        def j = 0;
        while (j < len(body_lines)) { def _unused94 = Collections.push(lines, heap_get(body_lines, j)); j = j + 1; }
        def _unused95 = Collections.push(lines, "}");
        return self._lines(lines);
    }

    fn _render_statements(self, statements, indent_level, defined) {
        def rendered = new[];
        def pad = String.repeat(self.indent, indent_level);
        def i = 0;
        while (i < len(statements)) {
            def stmt = heap_get(statements, i);
            if (stmt.kind == "Assign") {
                def keyword = "";
                if (Map.get(defined, stmt.target) == Null) { keyword = "def "; }
                Collections.push(rendered, pad + keyword + stmt.target + " = " + self._render_expr(stmt.expr) + ";");
                def _set = Map.set(defined, stmt.target, true);
            } else {
                if (stmt.kind == "Return") {
                    Collections.push(rendered, pad + "return " + self._render_expr(stmt.expr) + ";");
                } else {
                    if (stmt.kind == "ExprStmt") {
                        def expr_source = self._render_expr(stmt.expr);
                        if (stmt.expr.kind == "Call") {
                            def unused_name = self._next_unused(defined);
                            if (stmt.expr.func == "print") {
                                Collections.push(rendered, pad + expr_source + ";");
                            } else {
                                Collections.push(rendered, pad + "def " + unused_name + " = " + expr_source + ";");
                                def _set2 = Map.set(defined, unused_name, true);
                            }
                        } else {
                            Collections.push(rendered, pad + expr_source + ";");
                        }
                    } else {
                        if (stmt.kind == "IfElse") {
                            def _unused96 = Collections.push(rendered, pad + "if (" + self._render_expr(stmt.condition) + ") {");
                            def then_body = self._render_statements(stmt.then_body, indent_level + 1, __copy_map(defined));
                            def ti = 0;
                            while (ti < len(then_body)) { def _unused97 = Collections.push(rendered, heap_get(then_body, ti)); ti = ti + 1; }
                            if (len(stmt.else_body) > 0) {
                                def _unused98 = Collections.push(rendered, pad + "} else {");
                                def else_body = self._render_statements(stmt.else_body, indent_level + 1, __copy_map(defined));
                                def ei = 0;
                                while (ei < len(else_body)) { def _unused99 = Collections.push(rendered, heap_get(else_body, ei)); ei = ei + 1; }
                                def _unused100 = Collections.push(rendered, pad + "}");
                            } else {
                                def _unused101 = Collections.push(rendered, pad + "}");
                            }
                        } else {
                            if (stmt.kind == "While") {
                                def _unused102 = Collections.push(rendered, pad + "while (" + self._render_expr(stmt.condition) + ") {");
                                def body = self._render_statements(stmt.body, indent_level + 1, __copy_map(defined));
                                def bi = 0;
                                while (bi < len(body)) { def _unused103 = Collections.push(rendered, heap_get(body, bi)); bi = bi + 1; }
                                def _unused104 = Collections.push(rendered, pad + "}");
                            } else {
                                return __raise_runtime_error("Unsupported statement: " + __to_str(stmt));
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }
        return rendered;
    }

    fn from_source(self, code) {
        return __raise_runtime_error("Parsing TinyLanguage to the shared IR is not implemented yet.");
    }
}

fn TinyLanguageTranspiler() {
    return new TinyLanguageTranspiler { indent: "    " };
}
