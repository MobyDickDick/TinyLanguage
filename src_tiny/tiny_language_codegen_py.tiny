// TinyLanguage wrapper for src/tiny_language_codegen_py.py.
// Exposes the Python code generator via Python interop.

def PY_ALLOW = new["PythonCodeGenerator"];

def PY = Python.import_module("tiny_language_codegen_py", PY_ALLOW);

def PythonCodeGenerator = PY.PythonCodeGenerator;

def exports = new[PythonCodeGenerator];
