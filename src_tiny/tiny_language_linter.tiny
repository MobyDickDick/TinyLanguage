            if (!handled && st.__tag__ == "If") { visit_block(st.then); visit_block(st.els); handled = true; }
            if (!handled && st.__tag__ == "While") { visit_block(st.body); handled = true; }
            if (!handled && st.__tag__ == "Switch") {
                define ci = 0;
                while (ci < len(st.cases)) { visit_block(heap_get(st.cases, ci).body); ci = ci + 1; }
                handled = true;
            }
            if (!handled && st.__tag__ == "TryCatch") { visit_block(st.body); visit_block(st.handler); handled = true; }
            if (!handled && st.__tag__ == "Fn") { visit_block(st.body); handled = true; }
            if (!handled && st.__tag__ == "MethodDef") { visit_block(st.body); handled = true; }
            if (!handled && st.__tag__ == "ClassDef") { define mi = 0; while (mi < len(st.methods)) { visit_block(heap_get(st.methods, mi).body); mi = mi + 1; } handled = true; }
            if (!handled && st.__tag__ == "Namespace") { visit_block(st.body); }
            if (_stmt_guarantees_exit(st)) { terminated = true; }
