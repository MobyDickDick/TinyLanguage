// TinyLanguage-Port von src/tiny_language_ast.py
// Enthält die zentralen AST-Knoten als einfache Klassen mit Konstruktorfunktionen.

class SourcePos {
    line: number;
    column: number;
    fn col(self) { return self.column; }
}
fn SourcePos(line, column) { return new SourcePos { line: line; column: column }; }
fn SourcePos_origin() { return SourcePos(1, 1); }

fn _pos_or_default(pos) {
    if (pos == Null) { return SourcePos_origin(); }
    return pos;
}

class IR { pos: SourcePos; }

class Let {
    name: string;
    expr: IR;
    pos: SourcePos;
}
fn Let(name, expr, pos) { return new Let { name: name; expr: expr; pos: _pos_or_default(pos) }; }

class Assign {
    name: string;
    expr: IR;
    pos: SourcePos;
}
fn Assign(name, expr, pos) { return new Assign { name: name; expr: expr; pos: _pos_or_default(pos) }; }

class FieldAssign {
    obj: IR;
    name: string;
    expr: IR;
    pos: SourcePos;
}
fn FieldAssign(obj, name, expr, pos) { return new FieldAssign { obj: obj; name: name; expr: expr; pos: _pos_or_default(pos) }; }

class Print {
    exprs: Pointer;
    pos: SourcePos;
}
fn Print(exprs, pos) { return new Print { exprs: exprs; pos: _pos_or_default(pos) }; }

class If {
    cond: IR;
    then: Pointer;
    els: Pointer;
    pos: SourcePos;
}
fn If(cond, then, els, pos) { return new If { cond: cond; then: then; els: els; pos: _pos_or_default(pos) }; }

class While {
    cond: IR;
    body: Pointer;
    pos: SourcePos;
}
fn While(cond, body, pos) { return new While { cond: cond; body: body; pos: _pos_or_default(pos) }; }

class TryCatch {
    body: Pointer;
    err_name: string;
    handler: Pointer;
    pos: SourcePos;
}
fn TryCatch(body, err_name, handler, pos) { return new TryCatch { body: body; err_name: err_name; handler: handler; pos: _pos_or_default(pos) }; }

class Param {
    name: string;
    type: string;
}
fn Param(name, type_hint) { return new Param { name: name; type: type_hint }; }

class Fn {
    name: string;
    params: Pointer;
    body: Pointer;
    namespace: string;
    return_type: string;
    inferred_return_type: string;
    is_async: Bool;
    pos: SourcePos;
}
fn Fn(name, params, body, namespace, return_type, inferred_return_type, is_async, pos) {
    return new Fn {
        name: name;
        params: params;
        body: body;
        namespace: namespace;
        return_type: return_type;
        inferred_return_type: inferred_return_type;
        is_async: is_async;
        pos: _pos_or_default(pos)
    };
}

class MethodDef {
    class_name: string;
    name: string;
    params: Pointer;
    body: Pointer;
    return_type: string;
    inferred_return_type: string;
    namespace: string;
    is_async: Bool;
    pos: SourcePos;
}
fn MethodDef(class_name, name, params, body, return_type, inferred_return_type, namespace, is_async, pos) {
    return new MethodDef {
        class_name: class_name;
        name: name;
        params: params;
        body: body;
        return_type: return_type;
        inferred_return_type: inferred_return_type;
        namespace: namespace;
        is_async: is_async;
        pos: _pos_or_default(pos)
    };
}

class Namespace {
    name: string;
    body: Pointer;
    pos: SourcePos;
}
fn Namespace(name, body, pos) { return new Namespace { name: name; body: body; pos: _pos_or_default(pos) }; }

class Return {
    expr: IR;
    pos: SourcePos;
}
fn Return(expr, pos) { return new Return { expr: expr; pos: _pos_or_default(pos) }; }

class Import {
    module: string;
    alias: string;
    pos: SourcePos;
}
fn Import(module, alias, pos) { return new Import { module: module; alias: alias; pos: _pos_or_default(pos) }; }

class CallStmt {
    name: string;
    args: Pointer;
    pos: SourcePos;
}
fn CallStmt(name, args, pos) { return new CallStmt { name: name; args: args; pos: _pos_or_default(pos) }; }

class OpDef {
    op: string;
    params: Pointer;
    body: Pointer;
    pos: SourcePos;
}
fn OpDef(op, params, body, pos) { return new OpDef { op: op; params: params; body: body; pos: _pos_or_default(pos) }; }

class TypeVariant {
    name: string;
    fields: Pointer;
}
fn TypeVariant(name, fields) { return new TypeVariant { name: name; fields: fields }; }

class TypeDef {
    name: string;
    fields: Pointer;
    variants: Pointer;
    pos: SourcePos;
}
fn TypeDef(name, fields, variants, pos) { return new TypeDef { name: name; fields: fields; variants: variants; pos: _pos_or_default(pos) }; }

class ClassDef {
    name: string;
    fields: Pointer;
    methods: Pointer;
    bases: Pointer;
    pos: SourcePos;
}
fn ClassDef(name, fields, methods, bases, pos) { return new ClassDef { name: name; fields: fields; methods: methods; bases: bases; pos: _pos_or_default(pos) }; }

class Num { txt: string; pos: SourcePos; }
fn Num(txt, pos) { return new Num { txt: txt; pos: _pos_or_default(pos) }; }

class Str { txt: string; pos: SourcePos; }
fn Str(txt, pos) { return new Str { txt: txt; pos: _pos_or_default(pos) }; }

class BoolLit { value: Bool; pos: SourcePos; }
fn BoolLit(value, pos) { return new BoolLit { value: value; pos: _pos_or_default(pos) }; }

class NullLit { pos: SourcePos; }
fn NullLit(pos) { return new NullLit { pos: _pos_or_default(pos) }; }

class Var { name: string; pos: SourcePos; }
fn Var(name, pos) { return new Var { name: name; pos: _pos_or_default(pos) }; }

class Call {
    name: string;
    args: Pointer;
    pos: SourcePos;
}
fn Call(name, args, pos) { return new Call { name: name; args: args; pos: _pos_or_default(pos) }; }

class New { size: IR; pos: SourcePos; }
fn New(size, pos) { return new New { size: size; pos: _pos_or_default(pos) }; }

class NewLit { items: Pointer; pos: SourcePos; }
fn NewLit(items, pos) { return new NewLit { items: items; pos: _pos_or_default(pos) }; }

class Bin {
    op: string;
    a: IR;
    b: IR;
    pos: SourcePos;
}
fn Bin(op, a, b, pos) { return new Bin { op: op; a: a; b: b; pos: _pos_or_default(pos) }; }

class ObjLit { fields: Pointer; pos: SourcePos; }
fn ObjLit(fields, pos) { return new ObjLit { fields: fields; pos: _pos_or_default(pos) }; }

class Field {
    obj: IR;
    name: string;
    pos: SourcePos;
}
fn Field(obj, name, pos) { return new Field { obj: obj; name: name; pos: _pos_or_default(pos) }; }

class MethodCall {
    obj: IR;
    name: string;
    args: Pointer;
    pos: SourcePos;
}
fn MethodCall(obj, name, args, pos) { return new MethodCall { obj: obj; name: name; args: args; pos: _pos_or_default(pos) }; }

class ClassNew {
    name: string;
    init: Pointer;
    pos: SourcePos;
}
fn ClassNew(name, init, pos) { return new ClassNew { name: name; init: init; pos: _pos_or_default(pos) }; }

class Await { expr: IR; pos: SourcePos; }
fn Await(expr, pos) { return new Await { expr: expr; pos: _pos_or_default(pos) }; }

class MatchCase {
    pattern: IR;
    body: IR;
    pos: SourcePos;
}
fn MatchCase(pattern, body, pos) { return new MatchCase { pattern: pattern; body: body; pos: _pos_or_default(pos) }; }

class Pattern { pos: SourcePos; }
fn Pattern(pos) { return new Pattern { pos: _pos_or_default(pos) }; }

class VariantPattern {
    variant: string;
    bindings: Map;
    pos: SourcePos;
}
fn VariantPattern(variant, bindings, pos) { return new VariantPattern { variant: variant; bindings: bindings; pos: _pos_or_default(pos) }; }

class WildcardPattern {
    name: string;
    pos: SourcePos;
}
fn WildcardPattern(name, pos) { return new WildcardPattern { name: name; pos: _pos_or_default(pos) }; }

class Match {
    expr: IR;
    cases: Pointer;
    pos: SourcePos;
}
fn Match(expr, cases, pos) { return new Match { expr: expr; cases: cases; pos: _pos_or_default(pos) }; }

class VariantCtor {
    variant: string;
    fields: Pointer;
    type_name: string;
    pos: SourcePos;
}
fn VariantCtor(variant, fields, type_name, pos) {
    return new VariantCtor {
        variant: variant;
        fields: fields;
        type_name: type_name;
        pos: _pos_or_default(pos)
    };
}
