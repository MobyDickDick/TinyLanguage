// TinyLanguage entrypoint for the image composite conversion pipeline.
//
// Delegates to `src/image_composite_converter.py` through Python interop.
//
// Usage:
// TINYLANG_ARGS='["<folder>","<csv>","8","--start","AR0102","--end","AR0104"]' python src/tiny_language.py src_tiny/image_composite_converter.tiny

def os = Python.import_module("os", new["getenv"]);
def builtins = Python.import_module("builtins", new["len", "exit"]);
def converter = Python.import_module("image_composite_converter", new["main"]);

fn __argv_from_env() {
    def raw = os.getenv("TINYLANG_ARGS", "");
    def payload = "[]";
    if (raw != Null && len(raw) > 0) { payload = raw; }
    return JSON.parse(payload);
}

fn run() {
    def argv = __argv_from_env();
    if (builtins.len(argv) < 3) {
        print("Usage: set TINYLANG_ARGS JSON array: [folder, csv, iterations, --start, AR0102, --end, AR0104]");
        return 1;
    }
    return converter.main(argv);
}

def code = run();
if (code == Null) { }
else { def ignored_exit = builtins.exit(code); }
