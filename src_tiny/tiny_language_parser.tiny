// TinyLanguage-Port des Parsers aus src/tiny_language_parser.py
// Konsumiert Tokens aus tiny_language_lexer.tiny und erzeugt AST-Knoten aus tiny_language_ast.tiny.

// Fehlerausgabe via Python-Runtime, damit die Meldungen den Python-Port spiegeln.
def __PARSER_EXEC_ALLOW = new["exec"];
def __PARSER_REPR_ALLOW = new["repr"];
def __PARSER_TYPE_ALLOW = new["type"];
def __PARSER_GETATTR_ALLOW = new["getattr"];
def __PARSER_STR_ALLOW = new["str"];

fn __parser_raise(msg) {
    def safe = Python.call("builtins", "repr", new[msg], __PARSER_REPR_ALLOW);
    def stmt = "raise RuntimeError(" + safe + ")";
    return Python.call("builtins", "exec", new[stmt], __PARSER_EXEC_ALLOW);
}

fn __parser_tag(value) {
    def typ = Python.call("builtins", "type", new[value], __PARSER_TYPE_ALLOW);
    return Python.call("builtins", "getattr", new[typ, "__name__"], __PARSER_GETATTR_ALLOW);
}

fn __keep(param, value) -> any {
    return heap_get(new[value, param], 0);
}

fn __render_parse_error(source, span, message) {
    def pos = span.start;
    def lines = String.split(source, "\n");
    def idx = pos.line - 1;
    def line_txt = Python.call("builtins", "str", new[pos.line], __PARSER_STR_ALLOW);
    def col_txt = Python.call("builtins", "str", new[pos.column], __PARSER_STR_ALLOW);
    def header = message + " (line " + line_txt + ", col " + col_txt + ")";
    if (idx < 0 || idx >= len(lines)) { return header; }
    def line_text = heap_get(lines, idx);
    def start_col = pos.column;
    def end_col = span.stop.column;
    if (end_col < start_col) { end_col = start_col; }
    def prefix = "";
    def i = 1;
    while (i < start_col) {
        prefix = prefix + " ";
        i = i + 1;
    }
    def underline = prefix + String.repeat("^", end_col - start_col + 1);
    return header + "\n" + line_text + "\n" + underline;
}

class Parser {
    tokens: Pointer;
    index: number;
    source: string;
    tok: Token;
    _last_tok: Token;
    _allow_variant_ctor: Bool;

    fn _next_token(self) -> any {
        if (self.index < len(self.tokens)) {
            def tok = heap_get(self.tokens, self.index);
            self.index = self.index + 1;
            self._last_tok = tok;
            return __keep(self, tok);
        }
        if (len(self.tokens) == 0) {
            def pos = SourcePos_origin();
            def fake = Token("EOF", "", pos, pos);
            self._last_tok = fake;
            return __keep(self, fake);
        }
        def last = heap_get(self.tokens, len(self.tokens) - 1);
        self._last_tok = last;
        return __keep(self, last);
    }

    fn _tok_span(self, tok) -> any {
        def _keep_self = self;
        return SourceSpan(tok.start, tok.stop);
    }

    fn _attach_span(self, node, start, stop) -> any {
        def _keep_self = self;
        node.span = SourceSpan(start, stop);
        if (node.pos == Null || (node.pos.line == 1 && node.pos.column == 1)) {
            node.pos = start;
        }
        return node;
    }

    fn _span_cover(self, a, b) -> any {
        def _keep_self = self;
        def start = a.span.start;
        if (start == Null) { start = a.pos; }
        def stop = b.span.stop;
        if (stop == Null) { stop = b.pos; }
        return SourceSpan(start, stop);
    }

    fn _error(self, message, pos, span) -> any {
        def use_span = span;
        if (use_span == Null) { use_span = SourceSpan(pos, pos); }
        def rendered = __render_parse_error(self.source, use_span, message);
        return __parser_raise(rendered);
    }

    fn _eat(self, kind, text) -> any {
        if (!(self.tok.kind == kind && (text == Null || self.tok.text == text))) {
            if (text == Null) {
                return self._error("expected " + kind, self.tok.start, self._tok_span(self.tok));
            } else {
                return self._error("expected " + kind + " " + text, self.tok.start, self._tok_span(self.tok));
            }
        }
        def t = self.tok;
        self.tok = self._next_token();
        return __keep(self, t);
    }

    fn _eat_name_or_kw(self) -> any {
        if (self.tok.kind == "NAME" || self.tok.kind == "KW") {
            def t = self.tok;
            self.tok = self._next_token();
            return __keep(self, t);
        }
        return __keep(self, self._error("expected NAME", self.tok.start, self._tok_span(self.tok)));
    }

    fn _accept(self, kind, text) -> any {
        if (self.tok.kind == kind && (text == Null || self.tok.text == text)) {
            self._last_tok = self.tok;
            self.tok = self._next_token();
            return __keep(self, true);
        }
        return __keep(self, false);
    }

    fn parse(self) -> any {
        def stmts = new[];
        while (!(self.tok.kind == "EOF")) {
            def st = self.parse_stmt();
            def _push = Collections.push(stmts, st);
        }
        return stmts;
    }

    fn parse_block(self) -> any {
        def _open = self._eat("SYM", "{");
        def stmts = new[];
        while (!(self.tok.kind == "SYM" && self.tok.text == "}")) {
            def st = self.parse_stmt();
            def _push = Collections.push(stmts, st);
        }
        def _close = self._eat("SYM", "}");
        return stmts;
    }

    fn parse_stmt(self) -> any {
        if ((self.tok.kind == "KW" || self.tok.kind == "NAME") && (self.tok.text == "def" || self.tok.text == "define")) {
            def kw = self._eat(self.tok.kind, self.tok.text);
            def name_tok = self._eat("NAME", Null);
            def _eq = self._eat("SYM", "=");
            def expr = self.parse_expr();
            def semi = self._eat("SYM", ";");
            def name_span = self._tok_span(name_tok);
            return self._attach_span(Let(name_tok.text, expr, kw.start, Null, name_span), kw.start, semi.stop);
        }
        if (self.tok.kind == "KW" && self.tok.text == "print") {
            def kw = self._eat("KW", "print");
            def _open = self._eat("SYM", "(");
            def exprs = new[];
            if (!(self.tok.kind == "SYM" && self.tok.text == ")")) {
                def first = self.parse_expr();
                def _p1 = Collections.push(exprs, first);
                while (self._accept("SYM", ",", Null)) {
                    def nxt = self.parse_expr();
                    def _p2 = Collections.push(exprs, nxt);
                }
            }
            def _close = self._eat("SYM", ")");
            def semi = self._eat("SYM", ";");
            return self._attach_span(Print(exprs, kw.start, Null), kw.start, semi.stop);
        }
        if (self.tok.kind == "KW" && self.tok.text == "flush") {
            def kw = self._eat("KW", "flush");
            def _open = self._eat("SYM", "(");
            def _close = self._eat("SYM", ")");
            def semi = self._eat("SYM", ";");
            return self._attach_span(Flush(kw.start, Null), kw.start, semi.stop);
        }
        if (self.tok.kind == "KW" && self.tok.text == "if") {
            def kw = self._eat("KW", "if");
            def _open = self._eat("SYM", "(");
            def cond = self.parse_expr();
            def _close = self._eat("SYM", ")");
            def then_block = self.parse_block();
            def els = new[];
            if (self.tok.kind == "KW" && self.tok.text == "else") {
                def _else = self._eat("KW", "else");
                els = self.parse_block();
            }
            return self._attach_span(If(cond, then_block, els, kw.start, Null), kw.start, self._last_tok.stop);
        }
        if (self.tok.kind == "KW" && self.tok.text == "while") {
            def kw = self._eat("KW", "while");
            def _open = self._eat("SYM", "(");
            def cond = self.parse_expr();
            def _close = self._eat("SYM", ")");
            def body = self.parse_block();
            return self._attach_span(While(cond, body, kw.start, Null), kw.start, self._last_tok.stop);
        }
        if (self.tok.kind == "KW" && self.tok.text == "switch") {
            def kw = self._eat("KW", "switch");
            def _open = self._eat("SYM", "(");
            def target = self.parse_expr();
            def _close = self._eat("SYM", ")");
            def _open_block = self._eat("SYM", "{");
            def cases = new[];
            def has_default = false;
            while (!(self.tok.kind == "SYM" && self.tok.text == "}")) {
                if (self.tok.kind == "KW" && self.tok.text == "case") {
                    def case_kw = self._eat("KW", "case");
                    def value = self.parse_expr();
                    def _colon = self._eat("SYM", ":");
                    def body = self.parse_block();
                    def _push_case = Collections.push(
                        cases,
                        self._attach_span(SwitchCase(value, body, case_kw.start, Null), case_kw.start, self._last_tok.stop)
                    );
                } else {
                    if (self.tok.kind == "KW" && self.tok.text == "default") {
                        def default_kw = self._eat("KW", "default");
                        if (has_default) {
                            return self._error("duplicate default case", default_kw.start, self._tok_span(default_kw));
                        }
                        has_default = true;
                        def _colon2 = self._eat("SYM", ":");
                        def body = self.parse_block();
                        def _push_default = Collections.push(
                            cases,
                            self._attach_span(SwitchCase(Null, body, default_kw.start, Null), default_kw.start, self._last_tok.stop)
                        );
                    } else {
                        return self._error("expected case or default", self.tok.start, self._tok_span(self.tok));
                    }
                }
            }
            def _close_block = self._eat("SYM", "}");
            return self._attach_span(Switch(target, cases, kw.start, Null), kw.start, self._last_tok.stop);
        }
        if (self.tok.kind == "KW" && self.tok.text == "try") {
            def kw = self._eat("KW", "try");
            def body = self.parse_block();
            def _catch = self._eat("KW", "catch");
            def err_name = Null;
            if (self._accept("SYM", "(", Null)) {
                def name_tok = self._eat("NAME", Null);
                err_name = name_tok.text;
                def _close_paren = self._eat("SYM", ")");
            } else {
                def name_tok = self._eat("NAME", Null);
                err_name = name_tok.text;
            }
            def handler = self.parse_block();
            return self._attach_span(TryCatch(body, err_name, handler, kw.start, Null), kw.start, self._last_tok.stop);
        }
        if (self.tok.kind == "KW" && self.tok.text == "task") {
            def kw = self._eat("KW", "task");
            def body = self.parse_block();
            return self._attach_span(TaskBlock(body, kw.start, Null), kw.start, self._last_tok.stop);
        }
        if (self.tok.kind == "KW" && self.tok.text == "import") {
            def kw = self._eat("KW", "import");
            def module_data = self.parse_module_path();
            def module = heap_get(module_data, 0);
            def module_span = heap_get(module_data, 1);
            def alias = Null;
            def binding_span = module_span;
            if (self.tok.kind == "KW" && self.tok.text == "as") {
                def _as = self._eat("KW", "as");
                def alias_tok = self._eat("NAME", Null);
                alias = alias_tok.text;
                binding_span = self._tok_span(alias_tok);
            }
            def semi = self._eat("SYM", ";");
            return self._attach_span(Import(module, alias, kw.start, Null, module_span, binding_span), kw.start, semi.stop);
        }
        if (self.tok.kind == "KW" && self.tok.text == "namespace") {
            def kw = self._eat("KW", "namespace");
            def name = self.parse_qualified_name();
            def body = self.parse_block();
            return self._attach_span(Namespace(name, body, kw.start, Null), kw.start, self._last_tok.stop);
        }
        if (self.tok.kind == "KW" && (self.tok.text == "fn" || self.tok.text == "async")) {
            def is_async = false;
            def fn_kw = self._eat("KW", self.tok.text);
            if (fn_kw.text == "async") {
                is_async = true;
                fn_kw = self._eat("KW", "fn");
            }
            def name_tok = self._eat("NAME", Null);
            def params = self.parse_param_list();
            def return_type = Null;
            if (self._accept("OP", "-", Null)) {
                def _gt = self._eat("OP", ">");
                return_type = self.parse_type_annotation();
            }
            def body = self.parse_block();
            def return_params = self._collect_return_param_usage(body, params);
            return self._attach_span(
                Fn(name_tok.text, params, body, return_params, Null, return_type, Null, is_async, fn_kw.start, Null),
                fn_kw.start,
                self._last_tok.stop
            );
        }
        if (self.tok.kind == "KW" && self.tok.text == "return") {
            def kw = self._eat("KW", "return");
            def expr = self.parse_expr();
            def semi = self._eat("SYM", ";");
            return self._attach_span(Return(expr, kw.start, Null), kw.start, semi.stop);
        }
        if (self.tok.kind == "KW" && self.tok.text == "type") {
            def kw = self._eat("KW", "type");
            def name_tok = self._eat("NAME", Null);
            if (self._accept("SYM", "=", Null)) {
                def kind_tok = self._eat_name_or_kw();
                def kind = kind_tok.text;
                if (kind == "product") {
                    def pair = self._parse_product_fields();
                    def fields = heap_get(pair, 0);
                    def semi = heap_get(pair, 1);
                    return self._attach_span(TypeDef(name_tok.text, fields, Null, kw.start, Null), kw.start, semi.stop);
                }
                if (kind == "sum") {
                    def triple = self._parse_sum_variants();
                    def variants = heap_get(triple, 0);
                    def semi = heap_get(triple, 1);
                    def legacy_fields = heap_get(triple, 2);
                    if (legacy_fields != Null) {
                        return self._attach_span(TypeDef(name_tok.text, legacy_fields, Null, kw.start, Null), kw.start, semi.stop);
                    }
                    return self._attach_span(TypeDef(name_tok.text, Null, variants, kw.start, Null), kw.start, self._last_tok.stop);
                }
                return self._error("unknown type kind " + kind, kind_tok.start, self._tok_span(kind_tok));
            }
            def parsed = self._parse_sum_variants();
            def variants = heap_get(parsed, 0);
            def semi = heap_get(parsed, 1);
            def legacy = heap_get(parsed, 2);
            if (legacy != Null) {
                return self._attach_span(TypeDef(name_tok.text, legacy, Null, kw.start, Null), kw.start, semi.stop);
            }
            return self._attach_span(TypeDef(name_tok.text, Null, variants, kw.start, Null), kw.start, self._last_tok.stop);
        }
        if (self.tok.kind == "KW" && self.tok.text == "class") {
            def kw = self._eat("KW", "class");
            def cname_tok = self._eat("NAME", Null);
            def bases = new[];
            if (self._accept("SYM", ":", Null)) {
                def base_tok = self._eat("NAME", Null);
                def _push_base = Collections.push(bases, base_tok.text);
                while (self._accept("SYM", ",", Null)) {
                    def more_base = self._eat("NAME", Null);
                    def _pb = Collections.push(bases, more_base.text);
                }
            }
            def _open_class = self._eat("SYM", "{");
            def fields = new[];
            def methods = new[];
            while (!(self.tok.kind == "SYM" && self.tok.text == "}")) {
                if (self.tok.kind == "KW" && (self.tok.text == "fn" || self.tok.text == "async")) {
                    def is_async = false;
                    def fn_kw = self._eat("KW", self.tok.text);
                    if (fn_kw.text == "async") {
                        is_async = true;
                        fn_kw = self._eat("KW", "fn");
                    }
                    def mname_tok = self._eat_name_or_kw();
                    def params = self.parse_param_list();
                    def return_type = Null;
                    if (self._accept("OP", "-", Null)) {
                        def _gt2 = self._eat("OP", ">");
                        return_type = self.parse_type_annotation();
                    }
                    def body = self.parse_block();
                    def return_params = self._collect_return_param_usage(body, params);
                    def _pm = Collections.push(
                        methods,
                        MethodDef(cname_tok.text, mname_tok.text, params, body, return_params, return_type, Null, cname_tok.text, is_async, fn_kw.start, Null)
                    );
                } else {
                    def fname = self._eat("NAME", Null).text;
                    def _colon = self._eat("SYM", ":");
                    def ftype = self._eat("NAME", Null).text;
                    def _semi = self._eat("SYM", ";");
                    def _pf = Collections.push(fields, new[fname, ftype]);
                }
            }
            def _close_class = self._eat("SYM", "}");
            return self._attach_span(ClassDef(cname_tok.text, fields, methods, bases, kw.start, Null), kw.start, self._last_tok.stop);
        }
        if (self.tok.kind == "KW" && self.tok.text == "operator") {
            def kw = self._eat("KW", "operator");
            def op_tok = self._eat("OP", Null);
            def _open = self._eat("SYM", "(");
            def a_tok = self._eat("NAME", Null);
            def _colon_a = self._eat("SYM", ":");
            def a_type_tok = self._eat("NAME", Null);
            def _comma = self._eat("SYM", ",");
            def b_tok = self._eat("NAME", Null);
            def _colon_b = self._eat("SYM", ":");
            def b_type_tok = self._eat("NAME", Null);
            def _close = self._eat("SYM", ")");
            def _dash = self._eat("OP", "-");
            def _gt = self._eat("OP", ">");
            def _return_type = self._eat("NAME", Null);
            def body = self.parse_block();
            return self._attach_span(OpDef(op_tok.text, a_tok.text, a_type_tok.text, b_tok.text, b_type_tok.text, body, kw.start, Null), kw.start, self._last_tok.stop);
        }
        if (self.tok.kind == "SYM" && self.tok.text == "{") {
            def data = self.parse_destruct_names();
            def names = heap_get(data, 0);
            def start_pos = heap_get(data, 1);
            def name_spans = heap_get(data, 2);
            def _eq = self._eat("SYM", "=");
            def expr = self.parse_expr();
            def semi = self._eat("SYM", ";");
            return self._attach_span(DestructAssign(names, expr, start_pos, Null, name_spans), start_pos, semi.stop);
        }
        if (self.tok.kind == "NAME") {
            def name_tok = self._eat("NAME", Null);
            if (self._accept("SYM", ".", Null)) {
                def field_name = self._eat_name_or_kw().text;
                if (self._accept("SYM", "=", Null)) {
                    def expr = self.parse_expr();
                    def semi = self._eat("SYM", ";");
                    return self._attach_span(FieldAssign(Var(name_tok.text, name_tok.start, Null), field_name, expr, name_tok.start, Null), name_tok.start, semi.stop);
                }
                def args = self.parse_arg_list();
                def semi = self._eat("SYM", ";");
                return self._attach_span(CallStmt(name_tok.text + "." + field_name, args, name_tok.start, Null), name_tok.start, semi.stop);
            }
            if (self._accept("SYM", "=", Null)) {
                def expr = self.parse_expr();
                def semi = self._eat("SYM", ";");
                def name_span = self._tok_span(name_tok);
                return self._attach_span(Assign(name_tok.text, expr, name_tok.start, Null, name_span), name_tok.start, semi.stop);
            }
            if (self.tok.kind == "SYM" && self.tok.text == "(") {
                def args = self.parse_arg_list();
                def semi = self._eat("SYM", ";");
                return self._attach_span(CallStmt(name_tok.text, args, name_tok.start, Null), name_tok.start, semi.stop);
            }
            return self._error("unexpected token after name", name_tok.start, self._tok_span(name_tok));
        }
        return self._error("unexpected token " + self.tok.kind, self.tok.start, self._tok_span(self.tok));
    }

    fn parse_param(self) -> any {
        def name_tok = self._eat("NAME", Null);
        def annotation = Null;
        if (self._accept("SYM", ":", Null)) {
            annotation = self.parse_type_annotation();
        }
        return Param(name_tok.text, annotation);
    }

    fn parse_param_list(self) -> any {
        def _open = self._eat("SYM", "(");
        def params = new[];
        if (!(self.tok.kind == "SYM" && self.tok.text == ")")) {
            def first = self.parse_param();
            def _p = Collections.push(params, first);
            while (self._accept("SYM", ",", Null)) {
                def nxt = self.parse_param();
                def _p2 = Collections.push(params, nxt);
            }
        }
        def _close = self._eat("SYM", ")");
        return params;
    }

    fn _collect_return_param_usage(self, stmts, params) -> any {
        def names_set = Set.new();
        def idx = 0;
        while (idx < len(params)) {
            def p = heap_get(params, idx);
            def _ = Set.add(names_set, p.name);
            idx = idx + 1;
        }
        def used = Set.new();

        fn visit_expr(expr) {
            if (expr == Null) { return Null; }
            if (expr.__tag__ == "Var") {
                if (Set.has(names_set, expr.name)) { def _a = Set.add(used, expr.name); }
                return Null;
            }
            if (expr.__tag__ == "Field") { return visit_expr(expr.obj); }
            if (expr.__tag__ == "MethodCall") {
                def i = 0;
                def _vobj = visit_expr(expr.obj);
                while (i < len(expr.args)) { def _va = visit_expr(heap_get(expr.args, i)); i = i + 1; }
                return Null;
            }
            if (expr.__tag__ == "Call") {
                if (Set.has(names_set, expr.name)) { def _b = Set.add(used, expr.name); }
                def i = 0;
                while (i < len(expr.args)) { def _vc = visit_expr(heap_get(expr.args, i)); i = i + 1; }
                return Null;
            }
            if (expr.__tag__ == "Spawn") {
                def i = 0;
                while (i < len(expr.args)) { def _vd = visit_expr(heap_get(expr.args, i)); i = i + 1; }
                return Null;
            }
            if (expr.__tag__ == "Await") { return visit_expr(expr.expr); }
            if (expr.__tag__ == "Bin") {
                def _va = visit_expr(expr.a);
                def _vb = visit_expr(expr.b);
                return Null;
            }
            if (expr.__tag__ == "ObjLit") {
                def i = 0;
                while (i < len(expr.fields)) {
                    def pair = heap_get(expr.fields, i);
                    def _vf = visit_expr(heap_get(pair, 1));
                    i = i + 1;
                }
                return Null;
            }
            if (expr.__tag__ == "VariantCtor") {
                def i = 0;
                while (i < len(expr.fields)) {
                    def pair = heap_get(expr.fields, i);
                    def _vg = visit_expr(heap_get(pair, 1));
                    i = i + 1;
                }
                return Null;
            }
            if (expr.__tag__ == "ClassNew") {
                def i = 0;
                while (i < len(expr.init)) {
                    def pair = heap_get(expr.init, i);
                    def _vh = visit_expr(heap_get(pair, 1));
                    i = i + 1;
                }
                return Null;
            }
            if (expr.__tag__ == "NewLit") {
                def i = 0;
                while (i < len(expr.items)) {
                    def _vi = visit_expr(heap_get(expr.items, i));
                    i = i + 1;
                }
                return Null;
            }
            if (expr.__tag__ == "Match") {
                def _ve = visit_expr(expr.expr);
                def i = 0;
                while (i < len(expr.cases)) {
                    def mc = heap_get(expr.cases, i);
                    def _vbdy = visit_expr(mc.body);
                    i = i + 1;
                }
                return Null;
            }
            return Null;
        }

        fn visit_stmt(stmt) {
            if (stmt.__tag__ == "Return") { return visit_expr(stmt.expr); }
            if (stmt.__tag__ == "If") {
                def i = 0;
                while (i < len(stmt.then)) { def _vt = visit_stmt(heap_get(stmt.then, i)); i = i + 1; }
                i = 0;
                while (i < len(stmt.els)) { def _ve = visit_stmt(heap_get(stmt.els, i)); i = i + 1; }
                return Null;
            }
            if (stmt.__tag__ == "While") {
                def i = 0;
                while (i < len(stmt.body)) { def _vw = visit_stmt(heap_get(stmt.body, i)); i = i + 1; }
                return Null;
            }
            if (stmt.__tag__ == "TryCatch") {
                def i = 0;
                while (i < len(stmt.body)) { def _vtr = visit_stmt(heap_get(stmt.body, i)); i = i + 1; }
                i = 0;
                while (i < len(stmt.handler)) { def _vth = visit_stmt(heap_get(stmt.handler, i)); i = i + 1; }
                return Null;
            }
            if (stmt.__tag__ == "TaskBlock") {
                def i = 0;
                while (i < len(stmt.body)) { def _vtask = visit_stmt(heap_get(stmt.body, i)); i = i + 1; }
                return Null;
            }
            if (stmt.__tag__ == "Namespace") {
                def i = 0;
                while (i < len(stmt.body)) { def _vn = visit_stmt(heap_get(stmt.body, i)); i = i + 1; }
                return Null;
            }
            if (stmt.__tag__ == "Fn" || stmt.__tag__ == "MethodDef") { return Null; }
            return Null;
        }

        def i = 0;
        while (i < len(stmts)) {
            def _vs = visit_stmt(heap_get(stmts, i));
            i = i + 1;
        }
        return Set.to_list(used);
    }

    fn parse_type_annotation(self) -> any {
        def name = self._eat_name_or_kw().text;
        if (self._accept("SYM", "?", Null)) { return name + "?"; }
        return name;
    }

    fn parse_arg_list(self) -> any {
        def _open = self._eat("SYM", "(");
        def args = new[];
        if (!(self.tok.kind == "SYM" && self.tok.text == ")")) {
            def first = self.parse_expr();
            def _p = Collections.push(args, first);
            while (self._accept("SYM", ",", Null)) {
                def nxt = self.parse_expr();
                def _p2 = Collections.push(args, nxt);
            }
        }
        def _close = self._eat("SYM", ")");
        return args;
    }

    fn parse_destruct_names(self) -> any {
        def start_tok = self._eat("SYM", "{");
        def names = new[];
        def spans = new[];
        def first = self._eat("NAME", Null);
        def _p = Collections.push(names, first.text);
        def _s = Collections.push(spans, self._tok_span(first));
        while (self._accept("SYM", ",", Null)) {
            def name_tok = self._eat("NAME", Null);
            def _p2 = Collections.push(names, name_tok.text);
            def _s2 = Collections.push(spans, self._tok_span(name_tok));
        }
        def _close = self._eat("SYM", "}");
        return new[names, start_tok.start, spans];
    }

    fn parse_expr(self) -> any { return self.parse_logic_or(); }

    fn parse_logic_or(self) -> any {
        def left = self.parse_logic_and();
        while ((self.tok.kind == "KW" && self.tok.text == "or") || (self.tok.kind == "OP" && self.tok.text == "||")) {
            def op_tok = self.tok;
            def _eat_tok = self._eat(self.tok.kind, Null);
            def right = self.parse_logic_and();
            def span = self._span_cover(left, right);
            left = self._attach_span(Bin("or", left, right, op_tok.start, Null), span.start, span.stop);
        }
        return left;
    }

    fn parse_logic_and(self) -> any {
        def left = self.parse_compare();
        while ((self.tok.kind == "KW" && self.tok.text == "and") || (self.tok.kind == "OP" && self.tok.text == "&&")) {
            def op_tok = self.tok;
            def _eat_tok = self._eat(self.tok.kind, Null);
            def right = self.parse_compare();
            def span = self._span_cover(left, right);
            left = self._attach_span(Bin("and", left, right, op_tok.start, Null), span.start, span.stop);
        }
        return left;
    }

    fn parse_compare(self) -> any {
        def left = self.parse_term();
        while (self.tok.kind == "OP" && (self.tok.text == ">" || self.tok.text == ">=" || self.tok.text == "<" || self.tok.text == "<=" || self.tok.text == "==" || self.tok.text == "!=")) {
            def op_tok = self._eat("OP", Null);
            def right = self.parse_term();
            def span = self._span_cover(left, right);
            left = self._attach_span(Bin(op_tok.text, left, right, op_tok.start, Null), span.start, span.stop);
        }
        return left;
    }

    fn parse_term(self) -> any {
        def left = self.parse_factor();
        while (self.tok.kind == "OP" && (self.tok.text == "+" || self.tok.text == "-")) {
            def op_tok = self._eat("OP", Null);
            def right = self.parse_factor();
            def span = self._span_cover(left, right);
            left = self._attach_span(Bin(op_tok.text, left, right, op_tok.start, Null), span.start, span.stop);
        }
        return left;
    }

    fn parse_factor(self) -> any {
        def left = self.parse_power();
        while (self.tok.kind == "OP" && (self.tok.text == "*" || self.tok.text == "/" || self.tok.text == "%")) {
            def op_tok = self._eat("OP", Null);
            def right = self.parse_power();
            def span = self._span_cover(left, right);
            left = self._attach_span(Bin(op_tok.text, left, right, op_tok.start, Null), span.start, span.stop);
        }
        return left;
    }

    fn parse_power(self) -> any {
        def left = self.parse_unary();
        if (self.tok.kind == "OP" && self.tok.text == "^") {
            def op_tok = self._eat("OP", Null);
            def right = self.parse_power();
            def span = self._span_cover(left, right);
            return self._attach_span(Bin("^", left, right, op_tok.start, Null), span.start, span.stop);
        }
        return left;
    }

    fn parse_unary(self) -> any {
        if (self.tok.kind == "OP" && self.tok.text == "-") {
            def op_tok = self._eat("OP", Null);
            def rhs = self.parse_unary();
            def zero = Num("0", op_tok.start, Null);
            def span = self._span_cover(zero, rhs);
            return self._attach_span(Bin("-", zero, rhs, op_tok.start, Null), span.start, span.stop);
        }
        if ((self.tok.kind == "KW" && self.tok.text == "not") || (self.tok.kind == "OP" && self.tok.text == "!")) {
            def op_tok = self._eat(self.tok.kind, Null);
            def rhs = self.parse_unary();
            def zero = Num("0", op_tok.start, Null);
            def span = self._span_cover(zero, rhs);
            return self._attach_span(Bin("not", zero, rhs, op_tok.start, Null), span.start, span.stop);
        }
        return self.parse_postfix();
    }

    fn parse_postfix(self) -> any {
        def expr = self.parse_primary();
        def looping = true;
        while (looping) {
            if (self.tok.kind == "SYM" && self.tok.text == ".") {
                def dot_tok = self._eat("SYM", ".");
                def name_tok = self._eat_name_or_kw();
                if (self.tok.kind == "SYM" && self.tok.text == "(") {
                    def args = self.parse_arg_list();
                    expr = self._attach_span(MethodCall(expr, name_tok.text, args, dot_tok.start, Null), expr.span.start, self._last_tok.stop);
                } else {
                    expr = self._attach_span(Field(expr, name_tok.text, dot_tok.start, Null), expr.span.start, name_tok.stop);
                }
                looping = true;
            } else {
                looping = false;
            }
        }
        return expr;
    }

    fn parse_match(self) -> any {
        def kw = self._eat("KW", "match");
        def prev_allow = self._allow_variant_ctor;
        self._allow_variant_ctor = false;
        def target = self.parse_expr();
        self._allow_variant_ctor = prev_allow;
        def _open = self._eat("SYM", "{");
        def cases = new[];
        while (!self._accept("SYM", "}", Null)) {
            if (!(self.tok.kind == "KW" && self.tok.text == "case")) {
                return self._error("expected case", self.tok.start, self._tok_span(self.tok));
            }
            def _case = self._eat("KW", "case");
            def pattern = self.parse_pattern();
            if (self._accept("SYM", ":", Null)) { def _noop = 1; }
            else {
                if (self._accept("SYM", "=", Null)) {
                    if (!self._accept("OP", ">", Null)) { return self._error("expected '=>'", self.tok.start, self._tok_span(self.tok)); }
                } else {
                    return self._error("expected ':' or '=>'", self.tok.start, self._tok_span(self.tok));
                }
            }
            def body = self.parse_expr();
            def semi = self._eat("SYM", ";");
            def _push_case = Collections.push(cases, self._attach_span(MatchCase(pattern, body, pattern.pos, Null), pattern.pos, semi.stop));
        }
        return __keep(self, self._attach_span(Match(target, cases, kw.start, Null), kw.start, self._last_tok.stop));
    }

    fn parse_pattern(self) -> any {
        if (self.tok.kind == "NAME" && self.tok.text == "_") {
            def tok = self._eat("NAME", Null);
            return self._attach_span(WildcardPattern(Null, tok.start, Null), tok.start, tok.stop);
        }
        if (!(self.tok.kind == "NAME")) { return self._error("expected pattern", self.tok.start, self._tok_span(self.tok)); }
        def vname_tok = self._eat("NAME", Null);
        def bindings = Map.new();
        def positional = Null;
        if (self._accept("SYM", "{", Null)) {
            def done = false;
            while (!done) {
                if (self._accept("SYM", "}", Null)) { done = true; }
                else {
                    def fname = self._eat("NAME", Null).text;
                    def bind_name = fname;
                    if (self._accept("SYM", ":", Null)) {
                        def bind_tok = self._eat_name_or_kw();
                        if (bind_tok.text == "_") { bind_name = Null; }
                        else { bind_name = bind_tok.text; }
                    }
                    def _set = Map.set(bindings, fname, bind_name);
                    if (self._accept("SYM", "}", Null)) { done = true; }
                    else {
                        if (!(self._accept("SYM", ";", Null) || self._accept("SYM", ",", Null))) {
                            return self._error("expected field separator", self.tok.start, self._tok_span(self.tok));
                        }
                    }
                }
            }
        } else {
            if (self._accept("SYM", "(", Null)) {
                positional = new[];
                def done_pos = false;
                while (!done_pos) {
                    if (self._accept("SYM", ")", Null)) { done_pos = true; }
                    else {
                        def bind_tok = self._eat_name_or_kw();
                        if (bind_tok.text == "_") { def _p = Collections.push(positional, Null); }
                        else { def _p = Collections.push(positional, bind_tok.text); }
                        if (self._accept("SYM", ")", Null)) { done_pos = true; }
                        else {
                            if (!(self._accept("SYM", ",", Null) || self._accept("SYM", ";", Null))) {
                                return self._error("expected field separator", self.tok.start, self._tok_span(self.tok));
                            }
                        }
                    }
                }
            }
        }
        return self._attach_span(VariantPattern(vname_tok.text, bindings, positional, vname_tok.start, Null), vname_tok.start, self._last_tok.stop);
    }

    fn parse_primary(self) -> any {
        if (self._accept("SYM", "(", Null)) {
            def inner = self.parse_expr();
            def _close = self._eat("SYM", ")");
            return inner;
        }
        if (self.tok.kind == "KW" && self.tok.text == "await") {
            def kw = self._eat("KW", "await");
            def expr = self.parse_expr();
            def end_pos = expr.pos;
            if (expr.span != Null) { end_pos = expr.span.stop; }
            return self._attach_span(Await(expr, kw.start, Null), kw.start, end_pos);
        }
        if (self.tok.kind == "KW" && self.tok.text == "match") { return self.parse_match(); }
        if (self.tok.kind == "NUMBER") {
            def t = self._eat("NUMBER", Null);
            return self._attach_span(Num(t.text, t.start, Null), t.start, t.stop);
        }
        if (self.tok.kind == "STRING") {
            def t = self._eat("STRING", Null);
            return self._attach_span(Str(t.text, t.start, Null), t.start, t.stop);
        }
        if (self.tok.kind == "KW" && (self.tok.text == "true" || self.tok.text == "false")) {
            def kw = self._eat("KW", Null);
            def val = kw.text == "true";
            return self._attach_span(Bool(val, kw.start, Null), kw.start, kw.stop);
        }
        if (self.tok.kind == "KW" && self.tok.text == "Null") {
            def kw = self._eat("KW", Null);
            return self._attach_span(NullLit(kw.start, Null), kw.start, kw.stop);
        }
        if (self.tok.kind == "NAME" || self.tok.kind == "KW") {
            def name_tok = self._eat(self.tok.kind, Null);
            def name = name_tok.text;
            if (name == "spawn") {
                def target = self._eat_name_or_kw().text;
                def args = self.parse_arg_list();
                return self._attach_span(Spawn(target, args, name_tok.start, Null), name_tok.start, self._last_tok.stop);
            }
            if (name == "new" && self.tok.kind == "SYM" && self.tok.text == "[") {
                def start_tok = self._eat("SYM", "[");
                def items = new[];
                if (!(self.tok.kind == "SYM" && self.tok.text == "]")) {
                    def first = self.parse_expr();
                    def _p = Collections.push(items, first);
                    while (self._accept("SYM", ",", Null)) {
                        def nxt = self.parse_expr();
                        def _p2 = Collections.push(items, nxt);
                    }
                }
                def _close = self._eat("SYM", "]");
                return self._attach_span(NewLit(items, start_tok.start, Null), start_tok.start, self._last_tok.stop);
            }
            if (self.tok.kind == "SYM" && self.tok.text == "(") {
                def args = self.parse_arg_list();
                return self._attach_span(Call(name, args, name_tok.start, Null), name_tok.start, self._last_tok.stop);
            }
            if (name == "new" && self.tok.kind == "NAME") {
                def cname = self._eat("NAME", Null).text;
                def start_tok = self._eat("SYM", "{");
                def init = new[];
                def init_done = false;
                while (!init_done) {
                    if (self._accept("SYM", "}", Null)) { init_done = true; }
                    else {
                        def fname = self.parse_field_name();
                        def _colon = self._eat("SYM", ":");
                        def fexpr = self.parse_expr();
                        def _p = Collections.push(init, new[fname, fexpr]);
                        if (self._accept("SYM", "}", Null)) { init_done = true; }
                        else {
                            if (!(self._accept("SYM", ";", Null) || self._accept("SYM", ",", Null))) {
                                return self._error("expected field separator", self.tok.start, self._tok_span(self.tok));
                            }
                        }
                    }
                }
                return self._attach_span(ClassNew(cname, init, name_tok.start, Null), name_tok.start, self._last_tok.stop);
            }
            if (self._allow_variant_ctor && self.tok.kind == "SYM" && self.tok.text == "{") {
                def fields = self.parse_variant_init_fields();
                return self._attach_span(VariantCtor(name, fields, Null, name_tok.start, Null), name_tok.start, self._last_tok.stop);
            }
            return self._attach_span(Var(name, name_tok.start, Null), name_tok.start, name_tok.stop);
        }
        if (self.tok.kind == "SYM" && self.tok.text == "{") {
            def start_tok = self._eat("SYM", "{");
            def fields = new[];
            def obj_done = false;
            while (!obj_done) {
                if (self._accept("SYM", "}", Null)) { obj_done = true; }
                else {
                    def fname = self.parse_field_name();
                    def _colon = self._eat("SYM", ":");
                    def fexpr = self.parse_expr();
                    def _p = Collections.push(fields, new[fname, fexpr]);
                    if (self._accept("SYM", "}", Null)) { obj_done = true; }
                    else {
                        if (!(self._accept("SYM", ";", Null) || self._accept("SYM", ",", Null))) {
                            return self._error("expected field separator", self.tok.start, self._tok_span(self.tok));
                        }
                    }
                }
            }
            return self._attach_span(ObjLit(fields, start_tok.start, Null), start_tok.start, self._last_tok.stop);
        }
        return self._error("unexpected token " + self.tok.kind, self.tok.start, self._tok_span(self.tok));
    }

    fn parse_field_name(self) -> any {
        def name = self._eat("NAME", Null).text;
        if (self._accept("SYM", ".", Null)) {
            def sub = self._eat("NAME", Null).text;
            return name + "." + sub;
        }
        return name;
    }

    fn parse_variant_fields(self) -> any {
        def fields = new[];
        if (self._accept("SYM", "{", Null) || self._accept("SYM", "(", Null)) {
            def closing = "}";
            if (self._last_tok.text == "(") { closing = ")"; }
            def done = false;
            while (!done) {
                if (self._accept("SYM", closing, Null)) { done = true; }
                else {
                    def fname = self._eat("NAME", Null).text;
                    def _colon = self._eat("SYM", ":");
                    def ftype = self._eat_name_or_kw().text;
                    def _p = Collections.push(fields, new[fname, ftype]);
                    if (self._accept("SYM", closing, Null)) { done = true; }
                    else {
                        if (!(self._accept("SYM", ";", Null) || self._accept("SYM", ",", Null))) {
                            return self._error("expected field separator", self.tok.start, self._tok_span(self.tok));
                        }
                    }
                }
            }
        }
        return fields;
    }

    fn parse_variant_init_fields(self) -> any {
        def _start_tok = self._eat("SYM", "{");
        def fields = new[];
        def done = false;
        while (!done) {
            if (self._accept("SYM", "}", Null)) { done = true; }
            else {
                def fname = self._eat("NAME", Null).text;
                def _colon = self._eat("SYM", ":");
                def fexpr = self.parse_expr();
                def _p = Collections.push(fields, new[fname, fexpr]);
                if (self._accept("SYM", "}", Null)) { done = true; }
                else {
                    if (!(self._accept("SYM", ";", Null) || self._accept("SYM", ",", Null))) {
                        return self._error("expected field separator", self.tok.start, self._tok_span(self.tok));
                    }
                }
            }
        }
        return fields;
    }

    fn parse_module_path(self) -> any {
        def prefix = "";
        def start_tok = Null;
        while (self._accept("SYM", ".", Null)) {
            if (start_tok == Null) { start_tok = self._last_tok; }
            prefix = prefix + ".";
        }
        if (!(self.tok.kind == "NAME")) {
            def err = self._error("expected NAME", self.tok.start, self._tok_span(self.tok));
            return new[err, err];
        }
        def first_tok = self._eat("NAME", Null);
        def parts = new[first_tok.text];
        def last_tok = first_tok;
        while (self._accept("SYM", ".", Null)) {
            last_tok = self._eat("NAME", Null);
            def _p = Collections.push(parts, last_tok.text);
        }
        def start = first_tok.start;
        if (start_tok != Null) { start = start_tok.start; }
        def span = SourceSpan(start, last_tok.stop);
        return new[prefix + String.join(parts, "."), span];
    }

    fn parse_qualified_name(self) -> any {
        def parts = new[self._eat("NAME", Null).text];
        while (self._accept("SYM", ".", Null)) {
            def _p = Collections.push(parts, self._eat("NAME", Null).text);
        }
        return String.join(parts, ".");
    }

    fn _parse_product_fields(self) -> any {
        def _open = self._eat("SYM", "{");
        def fields = new[];
        def semi = self._last_tok;
        while (!self._accept("SYM", "}", Null)) {
            def fname = self._eat("NAME", Null).text;
            def _colon = self._eat("SYM", ":");
            def ftype = self._eat_name_or_kw().text;
            semi = self._eat("SYM", ";");
            def _p = Collections.push(fields, new[fname, ftype]);
        }
        return new[fields, semi];
    }

    fn _parse_sum_variants(self) -> any {
        def _open = self._eat("SYM", "{");
        def variants = new[];
        def semi = self._last_tok;
        if (self.tok.kind == "NAME") {
            def first_name_tok = self._eat("NAME", Null);
            if (self._accept("SYM", ":", Null)) {
                def first_type = self._eat_name_or_kw().text;
                semi = self._eat("SYM", ";");
                def fields = new[new[first_name_tok.text, first_type]];
                while (!self._accept("SYM", "}", Null)) {
                    def fname = self._eat("NAME", Null).text;
                    def _colon = self._eat("SYM", ":");
                    def ftype = self._eat_name_or_kw().text;
                    semi = self._eat("SYM", ";");
                    def _p = Collections.push(fields, new[fname, ftype]);
                }
                return new[variants, semi, fields];
            }
            def _vpush = Collections.push(variants, TypeVariant(first_name_tok.text, self.parse_variant_fields()));
            semi = self._eat("SYM", ";");
        }
        while (!self._accept("SYM", "}", Null)) {
            def vname = self._eat("NAME", Null).text;
            def vfields = self.parse_variant_fields();
            semi = self._eat("SYM", ";");
            def _p = Collections.push(variants, TypeVariant(vname, vfields));
        }
        return new[variants, semi, Null];
    }
}

fn Parser_new(source) {
    def tokens = lex(source);
    def start_tok = heap_get(tokens, 0);
    def parser = new Parser {
        tokens: tokens;
        index: 1;
        source: source;
        tok: start_tok;
        _last_tok: Token("<start>", "", SourcePos_origin(), SourcePos_origin());
        _allow_variant_ctor: true
    };
    return parser;
}

fn parse_program(source) {
    def parser = Parser_new(source);
    return parser.parse();
}
