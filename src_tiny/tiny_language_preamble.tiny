// TinyLanguage wrapper for src/tiny_language_preamble.py.
// Exposes shared constants and error formatting helpers via Python interop.

def PY_ALLOW = new["BUILTINS", "KEYWORDS", "TinyLangError", "format_error"];

def PY = Python.import_module("tiny_language_preamble", PY_ALLOW);

def BUILTINS = PY.BUILTINS;
def KEYWORDS = PY.KEYWORDS;
def TinyLangError = PY.TinyLangError;
def format_error = PY.format_error;

def exports = new[BUILTINS, KEYWORDS, TinyLangError, format_error];
