// TinyLanguage wrapper for src/tiny_language_eval.py.
// Exposes evaluator hooks and Environment via the stitched Python module.

def PY_ALLOW = new["eval_block", "eval_stmt", "eval_expr", "Environment"];

def PY = Python.import_module("tiny_language", PY_ALLOW);

def eval_block = PY.eval_block;
def eval_stmt = PY.eval_stmt;
def eval_expr = PY.eval_expr;
def Environment = PY.Environment;
