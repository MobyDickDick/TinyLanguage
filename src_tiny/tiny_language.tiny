// TinyLanguage wrapper for src/tiny_language.py.
// Exposes stitched TinyLanguage API through Python interop.

define __PY_ALLOW = new[
    "Lexer",
    "Parser",
    "Runtime",
    "Environment",
    "TinyLangError",
    "BUILTINS",
    "KEYWORDS",
    "format_error",
    "compile_and_run",
    "compile_to_c_executable",
    "compile_to_c_source",
    "compile_to_executable",
    "compile_to_llvm_ir",
    "compile_to_llvm_ir_via_c",
    "compile_to_llvm_bitcode_via_c",
    "compile_to_python_ast",
    "compile_to_python_source",
    "run_with_python_backend",
    "run_with_native_backend",
    "run_with_python_bytecode_backend",
    "run_file",
    "ModuleResolver",
    "main"
];

define __PY = Python.import_module("tiny_language", __PY_ALLOW);

define Lexer = __PY.Lexer;
define Parser = __PY.Parser;
define Runtime = __PY.Runtime;
define Environment = __PY.Environment;
define TinyLangError = __PY.TinyLangError;
define BUILTINS = __PY.BUILTINS;
define KEYWORDS = __PY.KEYWORDS;
define format_error = __PY.format_error;
fn compile_and_run(src) {
    return __PY.compile_and_run(src);
}

fn compile_to_c_executable(src, output_path) {
    return __PY.compile_to_c_executable(src, output_path);
}

fn compile_to_c_source(src) {
    return __PY.compile_to_c_source(src);
}

fn compile_to_executable(src, output_path) {
    return __PY.compile_to_executable(src, output_path);
}

fn compile_to_llvm_ir(src) {
    return __PY.compile_to_llvm_ir(src);
}

fn compile_to_llvm_ir_via_c(src) {
    return __PY.compile_to_llvm_ir_via_c(src);
}

fn compile_to_llvm_bitcode_via_c(src) {
    return __PY.compile_to_llvm_bitcode_via_c(src);
}

fn compile_to_python_ast(src) {
    return __PY.compile_to_python_ast(src);
}

fn compile_to_python_source(src) {
    return __PY.compile_to_python_source(src);
}

fn run_with_python_backend(src) {
    return __PY.run_with_python_backend(src);
}

fn run_with_native_backend(src) {
    return __PY.run_with_native_backend(src);
}

fn run_with_python_bytecode_backend(src) {
    return __PY.run_with_python_bytecode_backend(src);
}

fn run_file(path) {
    return __PY.run_file(path);
}
define ModuleResolver = __PY.ModuleResolver;
fn main(argv) {
    return __PY.main(argv);
}

define _exports = new[
    Lexer,
    Parser,
    Runtime,
    Environment,
    TinyLangError,
    BUILTINS,
    KEYWORDS,
    format_error,
    ModuleResolver
];
