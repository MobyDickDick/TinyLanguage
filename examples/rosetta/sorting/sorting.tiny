fn bubble_sort(values) {
    define n = len(values);
    define i = 0;
    while (i < n) {
        define j = 0;
        while (j < n - 1 - i) {
            define left = heap_get(values, j);
            define right = heap_get(values, j + 1);
            if (left > right) {
                heap_set(values, j, right);
                heap_set(values, j + 1, left);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return values;
}

fn print_list(values) {
    define i = 0;
    while (i < len(values)) {
        print(heap_get(values, i));
        i = i + 1;
    }
}

define numbers = new[5, 1, 4, 2, 8];
define sorted_numbers = bubble_sort(numbers);
define _ = print_list(sorted_numbers);
