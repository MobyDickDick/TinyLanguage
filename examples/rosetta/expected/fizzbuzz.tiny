// Rosetta example implementing FizzBuzz with a simple counting loop.

fn fizzbuzz(n) {
    // Print the FizzBuzz sequence from 1 to n inclusive.
    def i = 1;
    while (i <= n) {
        if (i % 15 == 0) {
            print("FizzBuzz");
        } else {
            if (i % 3 == 0) {
                print("Fizz");
            } else {
                if (i % 5 == 0) {
                    print("Buzz");
                } else {
                    print(i);
                }
            }
        }
        i = i + 1;
    }
}

def ignored1 = fizzbuzz(16);
