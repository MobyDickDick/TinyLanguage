// TinyLanguage port of the lightweight language_server utilities from src/language_server.py.
// Provides hover, completion, and diagnostic helpers for TinyLanguage source.

import tiny_language_lexer;
import tiny_language_linter;
import tiny_language_parser;

define __PY_SORT_ALLOW = new["sorted"];
define __PY_INT_ALLOW = new["int"];

define __KEYWORDS = tiny_language_lexer.KEYWORDS;
define __BUILTINS = tiny_language_lexer.BUILTINS;

fn __starts_with(text, prefix) {
    if (prefix == Null) { return true; }
    if (text == Null) { return false; }
    define text_chars = Python.call("builtins", "list", new[text], new["list"]);
    define prefix_chars = Python.call("builtins", "list", new[prefix], new["list"]);
    if (len(prefix_chars) > len(text_chars)) { return false; }
    define i = 0;
    while (i < len(prefix_chars)) {
        if (heap_get(text_chars, i) != heap_get(prefix_chars, i)) { return false; }
        i = i + 1;
    }
    return true;
}

fn __format_signature(name, params, return_type) {
    define parts = new[];
    define i = 0;
    while (i < len(params)) {
        define param = heap_get(params, i);
        define suffix = "";
        if (param.type_hint != Null && len(param.type_hint) > 0) {
            suffix = ": " + param.type_hint;
        }
        define _ = Collections.push(parts, param.name + suffix);
        i = i + 1;
    }
    define signature = String.join(parts, ", ");
    define return_annotation = "";
    if (return_type != Null && len(return_type) > 0) {
        return_annotation = " -> " + return_type;
    }
    return name + "(" + signature + ")" + return_annotation;
}

fn __record_symbol(server, name, pos, kind, detail) {
    define symbols = Map.get(server, "symbols");
    define kinds = Map.get(server, "symbol_kinds");
    define details = Map.get(server, "symbol_details");
    define _ = Map.set(symbols, name, pos);
    define _k = Map.set(kinds, name, kind);
    if (detail != Null) { define _d = Map.set(details, name, detail); }
    return Null;
}

fn __index_symbols(server, stmts, prefix) {
    define i = 0;
    while (i < len(stmts)) {
        define st = heap_get(stmts, i);
        if (st.__tag__ == "Namespace") {
            define nested = st.name;
            if (len(prefix) > 0) { nested = prefix + "." + st.name; }
            __index_symbols(server, st.body, nested);
        }

        if (st.__tag__ == "Fn" || st.__tag__ == "MethodDef" || st.__tag__ == "ClassDef" || st.__tag__ == "TypeDef" || st.__tag__ == "Namespace") {
            define qualified = st.name;
            if (len(prefix) > 0) { qualified = prefix + "." + st.name; }
            define kind = "identifier";
            define detail = Null;
            if (st.__tag__ == "Fn") {
                kind = "function";
                detail = "fn " + __format_signature(st.name, st.params, st.return_type);
            } else {
                if (st.__tag__ == "MethodDef") {
                    kind = "method";
                    detail = "method " + __format_signature(st.name, st.params, st.return_type);
                } else {
                    if (st.__tag__ == "ClassDef") { kind = "class"; }
                    if (st.__tag__ == "TypeDef") { kind = "type"; }
                }
            }
            __record_symbol(server, qualified, st.pos, kind, detail);

            if (st.__tag__ == "ClassDef") {
                define m = 0;
                while (m < len(st.methods)) {
                    define method = heap_get(st.methods, m);
                    define method_name = qualified + "." + method.name;
                    define method_detail = "method " + __format_signature(method.name, method.params, method.return_type);
                    __record_symbol(server, method_name, method.pos, "method", method_detail);
                    m = m + 1;
                }
            }
        }
        i = i + 1;
    }
    return Null;
}

fn TinyLanguageServer(source) {
    define stmts = tiny_language_parser.parse_program(source);
    define server = Map.new();
    define _ = Map.set(server, "source", source);
    define _s = Map.set(server, "stmts", stmts);
    define _sym = Map.set(server, "symbols", Map.new());
    define _k = Map.set(server, "symbol_kinds", Map.new());
    define _d = Map.set(server, "symbol_details", Map.new());
    __index_symbols(server, stmts, "");
    return server;
}

fn completions(server, prefix) {
    define candidates = Set.new();
    define kw = Set.to_list(__KEYWORDS);
    define bi = Set.to_list(__BUILTINS);
    define i = 0;
    while (i < len(kw)) { define _ = Set.add(candidates, heap_get(kw, i)); i = i + 1; }
    i = 0;
    while (i < len(bi)) { define _ = Set.add(candidates, heap_get(bi, i)); i = i + 1; }

    define symbols = Map.get(server, "symbols");
    define keys = Map.keys(symbols);
    i = 0;
    while (i < len(keys)) {
        define name = heap_get(keys, i);
        define _ = Set.add(candidates, name);
        if (String.contains(name, ".")) {
            define parts = String.split(name, ".");
            define short = heap_get(parts, len(parts) - 1);
            define _s = Set.add(candidates, short);
        }
        i = i + 1;
    }

    define filtered = new[];
    define all_items = Set.to_list(candidates);
    i = 0;
    while (i < len(all_items)) {
        define item = heap_get(all_items, i);
        if (__starts_with(item, prefix)) { define _ = Collections.push(filtered, item); }
        i = i + 1;
    }

    define sorted_items = Python.call("builtins", "sorted", new[filtered], __PY_SORT_ALLOW);
    define out = new[];
    i = 0;
    while (i < len(sorted_items)) {
        define label = heap_get(sorted_items, i);
        define kind = Map.get(Map.get(server, "symbol_kinds"), label);
        if (kind == Null) { kind = "identifier"; }
        define entry = Map.new();
        define _l = Map.set(entry, "label", label);
        define _k = Map.set(entry, "kind", kind);
        define _ = Collections.push(out, entry);
        i = i + 1;
    }
    return out;
}

fn definition(server, symbol, position) {
    define symbols = Map.get(server, "symbols");
    if (Map.has(symbols, symbol)) { return Map.get(symbols, symbol); }

    define matches = new[];
    define keys = Map.keys(symbols);
    define i = 0;
    while (i < len(keys)) {
        define name = heap_get(keys, i);
        if (name == symbol || (String.contains(name, ".") && heap_get(String.split(name, "."), len(String.split(name, ".")) - 1) == symbol)) {
            define _ = Collections.push(matches, new[name, Map.get(symbols, name)]);
        }
        i = i + 1;
    }
    if (len(matches) == 0) { return Null; }

    define best = heap_get(matches, 0);
    define best_score = new[999999, 999999];
    define idx = 0;
    while (idx < len(matches)) {
        define candidate = heap_get(matches, idx);
        define pos = heap_get(candidate, 1);
        define score = new[pos.line, pos.column];
        if (position != Null) {
            define line_delta = pos.line - heap_get(position, 0);
            if (line_delta < 0) { line_delta = 0 - line_delta; }
            define col_delta = pos.column - heap_get(position, 1);
            if (col_delta < 0) { col_delta = 0 - col_delta; }
            score = new[line_delta, col_delta];
        }
        if (heap_get(score, 0) < heap_get(best_score, 0) || (heap_get(score, 0) == heap_get(best_score, 0) && heap_get(score, 1) < heap_get(best_score, 1))) {
            best = candidate;
            best_score = score;
        }
        idx = idx + 1;
    }
    return heap_get(best, 1);
}

fn hover(server, symbol) {
    define symbols = Map.get(server, "symbols");
    if (!Map.has(symbols, symbol)) { return Null; }
    define pos = Map.get(symbols, symbol);
    define detail = Map.get(Map.get(server, "symbol_details"), symbol);
    if (detail == Null) { detail = "TinyLanguage symbol"; }
    define result = Map.new();
    define _s = Map.set(result, "symbol", symbol);
    define _d = Map.set(result, "detail", detail);
    define _p = Map.set(result, "position", new[pos.line, pos.column]);
    return result;
}

fn __diagnostic_range_from_message(message) {
    define range = new[1, 1, 1, 1];
    if (String.contains(message, "line ") && String.contains(message, "col ")) {
        define line_parts = String.split(message, "line ");
        if (len(line_parts) >= 2) {
            define after_line = heap_get(line_parts, 1);
            define line_split = String.split(after_line, ",");
            if (len(line_split) >= 1) {
                define line_text = String.trim(heap_get(line_split, 0));
                define line = Python.call("builtins", "int", new[line_text], __PY_INT_ALLOW);

                define col_parts = String.split(after_line, "col ");
                if (len(col_parts) >= 2) {
                    define col_tail = heap_get(col_parts, 1);
                    define col_split = String.split(col_tail, ")");
                    define col_text = String.trim(heap_get(col_split, 0));
                    define col = Python.call("builtins", "int", new[col_text], __PY_INT_ALLOW);
                    range = new[line, col, line, col + 1];
                }
            }
        }
    }
    return range;
}

fn diagnostics(server) {
    define diagnostics = new[];
    define stmts = Map.get(server, "stmts");
    define source = Map.get(server, "source");
    try {
        tiny_language_linter.lint_destruct_call_outputs(stmts, source);
        tiny_language_linter.lint_no_consecutive_definitions(stmts);
        tiny_language_linter.lint_import_style(stmts, source);
        tiny_language_linter.lint_locals_used(stmts, source);
        define signatures = tiny_language_linter._collect_function_signatures(stmts, "");
        tiny_language_linter.lint_bare_call_results(stmts, signatures, source);
        define i = 0;
        while (i < len(stmts)) {
            define st = heap_get(stmts, i);
            if (st.__tag__ == "Fn") { tiny_language_linter.lint_fn_params_used(st, source); }
            if (st.__tag__ == "MethodDef") { tiny_language_linter.lint_method_params_used(st, source); }
            if (st.__tag__ == "ClassDef") {
                define m = 0;
                while (m < len(st.methods)) {
                    define md = heap_get(st.methods, m);
                    tiny_language_linter.lint_method_params_used(md, source);
                    m = m + 1;
                }
            }
            i = i + 1;
        }
    } catch(err) {
        define diag = Map.new();
        define _m = Map.set(diag, "message", err.message);
        define _c = Map.set(diag, "code", err.code);
        define _r = Map.set(diag, "range", __diagnostic_range_from_message(err.message));
        define _ = Collections.push(diagnostics, diag);
    }
    return diagnostics;
}
