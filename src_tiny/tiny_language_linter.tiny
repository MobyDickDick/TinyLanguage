fn _return_signature(expr) {
    define result = new["<scalar>"];
    if (expr.__tag__ == "ObjLit") {
        result = new[];
        define i = 0;
        while (i < len(expr.fields)) { define pair = heap_get(expr.fields, i); define _ = Collections.push(result, heap_get(pair, 0)); i = i + 1; }
    } else {
