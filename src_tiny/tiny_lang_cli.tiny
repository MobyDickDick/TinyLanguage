// TinyLanguage wrapper mirroring src/tiny_lang_cli.py.

def tiny_cli = Python.import_module("tiny_language_cli", new["main"]);
def os = Python.import_module("os", new["getenv"]);
def builtins = Python.import_module("builtins", new["exit"]);

fn __argv_from_env() {
    def raw = os.getenv("TINYLANG_ARGS", "");
    def payload = "[]";
    if (raw != Null && len(raw) > 0) { payload = raw; }
    return JSON.parse(payload);
}

fn run() {
    def code = tiny_cli.main(__argv_from_env());
    def _unused1 = builtins.exit(code);
}

def __unused2 = run();
