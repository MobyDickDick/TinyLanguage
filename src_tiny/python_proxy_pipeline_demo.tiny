namespace PyPipeline {
    fn sqrt_then_square(x: number) -> number {
        def math = Python.import_module("math", new["sqrt", "pow"]);
        def root = math.sqrt(x);
        return math.pow(root, 2);
    }

    fn normalize_path(path: string) -> string {
        def os_path = Python.import_module("os.path", new["basename", "dirname"]);
        def base = os_path.basename(path);
        return os_path.dirname(path) + "/" + base;
    }
}

fn describe_area(width: number, height: number) -> string {
    def as_string = Python.call("builtins", "str", new[width * height], { allow: new["str"] });
    return "{\"area\": " + as_string + "}";
}

def squared = PyPipeline.sqrt_then_square(81);
print(squared);
print(PyPipeline.normalize_path("/tmp/example.txt"));
print(describe_area(3, 4));
