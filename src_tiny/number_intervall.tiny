// Closed real sets with outward-rounded binary64 bounds. See
// docs/interval_arithmetic_contract.md for exterior, empty and unbounded sets.
// Exact bound/rounding primitives are provided by the reference interpreter.
// Compiler backends and standalone self-hosting are not qualified for this API.

class NumberIntervall {
  lower: number;
  upper: number;
  error: string;

  fn to_string(self) {
    return self;
  }
}

fn __intervall_with_error(code) {
  return __interval_bounds(0, 0, code);
}

fn __intervall_with_bounds_and_error(l, u, code) {
  return __interval_bounds(l, u, code);
}

fn __intervall_from_bounds(l, u) {
  return __interval_bounds(l, u, "normal");
}

fn NumberIntervall(l, u) {
  return __intervall_from_bounds(l, u);
}

// An explicit neighbor envelope; ordinary constructors and Number promotion
// enclose the stored value without adding this extra uncertainty.
fn interval_number(v) {
  return __interval_neighbors(v);
}

fn __is_error(iv, code) { return iv.error == code; }
fn __is_normal(iv) { return iv.error == "normal"; }
fn __is_wrapped(iv) { return iv.error == "wrapped_interval"; }

operator + (a: NumberIntervall, b: NumberIntervall) -> NumberIntervall {
  return __interval_binary("+", a, b);
}

operator - (a: NumberIntervall, b: NumberIntervall) -> NumberIntervall {
  return __interval_binary("-", a, b);
}

operator * (a: NumberIntervall, b: NumberIntervall) -> NumberIntervall {
  return __interval_binary("*", a, b);
}

operator / (a: NumberIntervall, b: NumberIntervall) -> NumberIntervall {
  return __interval_binary("/", a, b);
}
