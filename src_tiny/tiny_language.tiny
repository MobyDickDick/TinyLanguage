// TinyLanguage wrapper for src/tiny_language.py.
// Exposes stitched TinyLanguage API through Python interop.

def PY_ALLOW = new[
    "Lexer",
    "Parser",
    "Runtime",
    "Environment",
    "TinyLangError",
    "BUILTINS",
    "KEYWORDS",
    "format_error",
    "compile_and_run",
    "compile_to_c_executable",
    "compile_to_c_source",
    "compile_to_executable",
    "compile_to_llvm_ir",
    "compile_to_llvm_ir_via_c",
    "compile_to_llvm_bitcode_via_c",
    "compile_to_python_ast",
    "compile_to_python_source",
    "run_with_python_backend",
    "run_with_native_backend",
    "run_with_python_bytecode_backend",
    "run_file",
    "ModuleResolver",
    "main"
];

def PY = Python.import_module("tiny_language", PY_ALLOW);

def Lexer = PY.Lexer;
def Parser = PY.Parser;
def Runtime = PY.Runtime;
def Environment = PY.Environment;
def TinyLangError = PY.TinyLangError;
def BUILTINS = PY.BUILTINS;
def KEYWORDS = PY.KEYWORDS;
def format_error = PY.format_error;
fn compile_and_run(src) {
    return PY.compile_and_run(src);
}

fn compile_to_c_executable(src, output_path) {
    return PY.compile_to_c_executable(src, output_path);
}

fn compile_to_c_source(src) {
    return PY.compile_to_c_source(src);
}

fn compile_to_executable(src, output_path) {
    return PY.compile_to_executable(src, output_path);
}

fn compile_to_llvm_ir(src) {
    return PY.compile_to_llvm_ir(src);
}

fn compile_to_llvm_ir_via_c(src) {
    return PY.compile_to_llvm_ir_via_c(src);
}

fn compile_to_llvm_bitcode_via_c(src) {
    return PY.compile_to_llvm_bitcode_via_c(src);
}

fn compile_to_python_ast(src) {
    return PY.compile_to_python_ast(src);
}

fn compile_to_python_source(src) {
    return PY.compile_to_python_source(src);
}

fn run_with_python_backend(src) {
    return PY.run_with_python_backend(src);
}

fn run_with_native_backend(src) {
    return PY.run_with_native_backend(src);
}

fn run_with_python_bytecode_backend(src) {
    return PY.run_with_python_bytecode_backend(src);
}

fn run_file(path) {
    return PY.run_file(path);
}
def ModuleResolver = PY.ModuleResolver;
fn main(argv) {
    return PY.main(argv);
}

def exports = new[
    Lexer,
    Parser,
    Runtime,
    Environment,
    TinyLangError,
    BUILTINS,
    KEYWORDS,
    format_error,
    ModuleResolver
];
