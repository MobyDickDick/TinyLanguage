    name: string;
    type_hint: string;
}
fn Param(name, type_hint) { return new Param { name: name; type_hint: type_hint }; }

class Fn {
    name: string;
    params: Pointer;
    body: Pointer;
    return_param_names: Pointer;
    namespace_name: string;
    return_type: string;
    inferred_return_type: string;
    is_async: Bool;
    pos: SourcePos;
    span: SourceSpan;
}
fn Fn(name, params, body, return_param_names, namespace_name, return_type, inferred_return_type, is_async, pos, span) {
    return new Fn {
        name: name;
        params: params;
        body: body;
        return_param_names: return_param_names;
        namespace_name: namespace_name;
        return_type: return_type;
        inferred_return_type: inferred_return_type;
        is_async: is_async;
        pos: _pos_or_default(pos);
        span: _span_or_default(span, pos)
    };
}

