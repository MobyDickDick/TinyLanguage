// TinyLanguage stdlib: string module (Python-style subset)

fn split(text, sep) {
  return String.split(text, sep);
}

fn join(items, sep) {
  return String.join(items, sep);
}

fn contains(text, needle) {
  return String.contains(text, needle);
}

fn upper(text) {
  return String.upper(text);
}

fn lower(text) {
  return String.lower(text);
}

fn trim(text) {
  return String.trim(text);
}

fn repeat(text, count) {
  return String.repeat(text, count);
}

fn replace(text, old, replacement) {
  return String.replace(text, old, replacement);
}

fn starts_with(text, prefix) {
  return String.starts_with(text, prefix);
}

fn ends_with(text, suffix) {
  return String.ends_with(text, suffix);
}

fn is_digit(text) {
  return String.is_digit(text);
}
