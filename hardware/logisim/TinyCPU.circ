<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="3.9.0" version="1.0">
  This file is intended to be loaded by Logisim-evolution 3.x.
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#TTL" name="6"/>
  <lib desc="#TCL" name="7"/>
  <lib desc="#Base" name="8"/>
  <main name="TinyCPU"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings/>
  <toolbar/>

  <circuit name="TinyCPU">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="TinyCPU"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1.0"/>
    <comp lib="8" loc="(100,80)" name="Text">
      <a name="text" val="TinyCPU 16/12 starter — wire and verify each subcircuit before adding control logic"/>
    </comp>
    <comp loc="(220,180)" name="Datapath"/>
    <comp loc="(220,300)" name="AddressPath"/>
    <comp loc="(480,180)" name="Memory"/>
    <comp loc="(480,300)" name="ErrorFlags"/>
  </circuit>

  <circuit name="Datapath">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="Datapath"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <comp lib="8" loc="(80,60)" name="Text"><a name="text" val="16-bit accumulator plus validity state"/></comp>
    <comp lib="4" loc="(280,150)" name="Register">
      <a name="label" val="ACC"/><a name="width" val="16"/>
    </comp>
    <comp lib="4" loc="(280,240)" name="Register">
      <a name="label" val="ACC_VALID"/><a name="width" val="1"/>
    </comp>
    <comp lib="0" loc="(100,150)" name="Pin"><a name="label" val="DATA_IN"/><a name="width" val="16"/></comp>
    <comp lib="0" loc="(100,200)" name="Pin"><a name="label" val="ACC_LOAD"/></comp>
    <comp lib="0" loc="(100,260)" name="Pin"><a name="label" val="VALID_IN"/></comp>
    <comp lib="0" loc="(100,310)" name="Pin"><a name="label" val="CLK"/></comp>
    <comp lib="0" loc="(420,150)" name="Pin"><a name="facing" val="west"/><a name="label" val="ACC"/><a name="output" val="true"/><a name="width" val="16"/></comp>
    <comp lib="0" loc="(420,240)" name="Pin"><a name="facing" val="west"/><a name="label" val="ACC_VALID"/><a name="output" val="true"/></comp>
  </circuit>

  <circuit name="AddressPath">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="AddressPath"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <comp lib="8" loc="(80,60)" name="Text"><a name="text" val="12-bit unsigned address register plus validity state"/></comp>
    <comp lib="4" loc="(280,150)" name="Register"><a name="label" val="AR"/><a name="width" val="12"/></comp>
    <comp lib="4" loc="(280,240)" name="Register"><a name="label" val="AR_VALID"/><a name="width" val="1"/></comp>
    <comp lib="0" loc="(100,150)" name="Pin"><a name="label" val="ADDRESS_IN"/><a name="width" val="12"/></comp>
    <comp lib="0" loc="(100,200)" name="Pin"><a name="label" val="AR_LOAD"/></comp>
    <comp lib="0" loc="(100,260)" name="Pin"><a name="label" val="VALID_IN"/></comp>
    <comp lib="0" loc="(100,310)" name="Pin"><a name="label" val="CLK"/></comp>
    <comp lib="0" loc="(420,150)" name="Pin"><a name="facing" val="west"/><a name="label" val="ADDRESS"/><a name="output" val="true"/><a name="width" val="12"/></comp>
    <comp lib="0" loc="(420,240)" name="Pin"><a name="facing" val="west"/><a name="label" val="AR_VALID"/><a name="output" val="true"/></comp>
  </circuit>

  <circuit name="Memory">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="Memory"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <comp lib="8" loc="(80,60)" name="Text"><a name="text" val="Parallel value/valid RAM — shared address and write-enable are the next wiring step"/></comp>
    <comp lib="4" loc="(260,160)" name="RAM"><a name="addrWidth" val="12"/><a name="dataWidth" val="16"/><a name="label" val="DATA_RAM"/></comp>
    <comp lib="4" loc="(500,160)" name="RAM"><a name="addrWidth" val="12"/><a name="dataWidth" val="1"/><a name="label" val="VALID_RAM"/></comp>
  </circuit>

  <circuit name="ErrorFlags">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="ErrorFlags"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <comp lib="8" loc="(80,60)" name="Text"><a name="text" val="Sticky set-dominant error state; CLEAR_ERROR must be the sole clear source"/></comp>
    <comp lib="4" loc="(180,160)" name="Register"><a name="label" val="OVF"/><a name="width" val="1"/></comp>
    <comp lib="4" loc="(300,160)" name="Register"><a name="label" val="DIV0"/><a name="width" val="1"/></comp>
    <comp lib="4" loc="(420,160)" name="Register"><a name="label" val="ADDR"/><a name="width" val="1"/></comp>
    <comp lib="4" loc="(180,260)" name="Register"><a name="label" val="INV"/><a name="width" val="1"/></comp>
    <comp lib="4" loc="(300,260)" name="Register"><a name="label" val="ILL"/><a name="width" val="1"/></comp>
    <comp lib="4" loc="(420,260)" name="Register"><a name="label" val="INPUT"/><a name="width" val="1"/></comp>
  </circuit>
</project>
