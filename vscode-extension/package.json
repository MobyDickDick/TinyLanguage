{
  "name": "tinylanguage-vscode",
  "displayName": "TinyLanguage",
  "description": "Syntax highlighting, formatting, REPL integration, and diagnostics for TinyLanguage programs.",
  "version": "0.1.2",
  "publisher": "tinylanguage",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:tinylanguage",
    "onCommand:tinylanguage.startRepl",
    "onCommand:tinylanguage.runFile",
    "onCommand:tinylanguage.formatDocument",
    "onCommand:tinylanguage.refreshDiagnostics",
    "onCommand:tinylanguage.getDebugAdapterExecutable",
    "onDebugResolve:tinylanguage",
    "onDebugInitialConfigurations"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tinylanguage",
        "aliases": [
          "TinyLanguage",
          "tinylanguage"
        ],
        "extensions": [
          ".tiny"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tinylanguage",
        "scopeName": "source.tiny",
        "path": "./syntaxes/tiny.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "tinylanguage.startRepl",
        "title": "TinyLanguage: Start REPL"
      },
      {
        "command": "tinylanguage.runFile",
        "title": "TinyLanguage: Run Active File"
      },
      {
        "command": "tinylanguage.formatDocument",
        "title": "TinyLanguage: Format Document"
      },
      {
        "command": "tinylanguage.refreshDiagnostics",
        "title": "TinyLanguage: Refresh Diagnostics"
      },
      {
        "command": "tinylanguage.getDebugAdapterExecutable",
        "title": "TinyLanguage: Debug Adapter (scaffolding)"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "TinyLanguage",
      "properties": {
        "tinylanguage.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python executable used to run TinyLanguage tooling."
        },
        "tinylanguage.runtimePath": {
          "type": "string",
          "default": "${workspaceFolder}/src/tiny_language.py",
          "description": "Path to tiny_language.py for running the REPL or executing files."
        },
        "tinylanguage.debugLogPath": {
          "type": "string",
          "default": "${workspaceFolder}/.tinylanguage/debug-adapter.log",
          "description": "Optional file path for a verbose TinyLanguage debug adapter log. Clear to disable logging."
        },
        "tinylanguage.traceLogPath": {
          "type": "string",
          "default": "${workspaceFolder}/.tinylanguage/runtime-trace.log",
          "description": "Optional file path for interpreter trace logs while debugging. Clear to disable logging."
        },
        "tinylanguage.showDebugTerminal": {
          "type": "boolean",
          "default": false,
          "description": "Show the TinyLanguage Debug Log terminal when launching the adapter (useful for troubleshooting)."
        }
      }
    },
    "configurationDefaults": {
      "workbench.iconTheme": "tinylanguage-icons"
    },
    "iconThemes": [
      {
        "id": "tinylanguage-icons",
        "label": "TinyLanguage File Icons",
        "path": "./icons/fileicons.json"
      }
    ],
    "debuggers": [
      {
        "type": "tinylanguage",
        "label": "TinyLanguage",
        "languages": [
          "tinylanguage"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "TinyLanguage source file to launch."
              },
              "runtime": {
                "type": "string",
                "description": "Path to tiny_language.py (used by the prototype adapter)."
              },
              "python": {
                "type": "string",
                "description": "Python executable to run the TinyLanguage interpreter."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false,
                "description": "Pause on the first line of the program before executing."
              },
              "env": {
                "type": "object",
                "description": "Environment variables passed to the TinyLanguage debug adapter.",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "default": {}
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "name": "TinyLanguage: Launch active file (prototype)",
            "type": "tinylanguage",
            "request": "launch",
            "program": "${file}",
            "runtime": "${config:tinylanguage.runtimePath}",
            "python": "${config:tinylanguage.pythonPath}",
            "stopOnEntry": false
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "tinylanguage"
      }
    ]
  },
  "devDependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/tinylanguage/TinyLanguage.git"
  },
  "license": "CC-BY-NC-SA-4.0"
}
