// TinyLanguage-Port von src/tiny_errors.py
// Contains position/span structures along with basic error formatting.

class SourcePos {
    line: number;
    column: number;

    fn col(self) {
        return self.column;
    }
}

fn SourcePos(line, column) {
    return new SourcePos { line: line; column: column };
}

fn SourcePos_origin() {
    return SourcePos(1, 1);
}

class SourceSpan {
    start: SourcePos;
    stop: SourcePos;
}

fn SourceSpan(start, stop) {
    return new SourceSpan { start: start; stop: stop };
}

class TinyError {
    kind: string;
    msg: string;
    span: SourceSpan;

    fn to_string(self) {
        if (self.span == Null) {
            return "[" + self.kind + "] " + self.msg;
        }
        def s = self.span.start;
        return "[" + self.kind + "] " + self.msg + " (line " + s.line + ", column " + s.column + ")";
    }
}

fn TinyError(kind, msg, span) {
    return new TinyError { kind: kind; msg: msg; span: span };
}

fn format_error(err: TinyError, source: string) {
    def header = "[" + err.kind + "] " + err.msg;
    if (err.span == Null) {
        return header;
    }

    def lines = String.split(source, "\n");
    def line_index = err.span.start.line - 1;
    if (line_index < 0 || line_index >= Collections.len(lines)) {
        return header;
    }

    def line_text = heap_get(lines, line_index);
    def start_col = err.span.start.column;
    def end_col = err.span.stop.column;

    if (start_col < 1) {
        start_col = 1;
    }
    if (end_col < start_col) {
        end_col = start_col;
    }

    // Leerzeichen vor den Carets aufbauen
    def prefix = "";
    def idx = 1;
    while (idx < start_col) {
        prefix = prefix + " ";
        idx = idx + 1;
    }

    def caret_len = end_col - start_col + 1;
    def underline = prefix + String.repeat("^", caret_len);

    return header
        + "\nline " + err.span.start.line + ", column " + err.span.start.column + ":\n"
        + line_text + "\n" + underline;
}
