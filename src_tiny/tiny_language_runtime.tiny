// TinyLanguage wrapper for src/tiny_language_runtime.py.
// Delegates Runtime helpers to the stitched Python module for parity.

def __PY_ALLOW = new[
    "Runtime",
    "ModuleResolver",
    "Debugger",
    "NamespaceRef",
    "ReturnSignal",
    "TinyLangError",
    "format_error",
    "register_stdlib",
    "SourcePos",
    "SourceSpan",
    "DebugSnapshot",
    "StepRequest"
];

def __PY = Python.import_module("tiny_language", __PY_ALLOW);

def Runtime = __PY.Runtime;
def ModuleResolver = __PY.ModuleResolver;
def Debugger = __PY.Debugger;
def NamespaceRef = __PY.NamespaceRef;
def ReturnSignal = __PY.ReturnSignal;
def TinyLangError = __PY.TinyLangError;
def format_error = __PY.format_error;
def register_stdlib = __PY.register_stdlib;
def SourcePos = __PY.SourcePos;
def SourceSpan = __PY.SourceSpan;
def DebugSnapshot = __PY.DebugSnapshot;
def StepRequest = __PY.StepRequest;
