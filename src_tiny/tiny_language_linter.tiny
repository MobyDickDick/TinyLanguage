fn lint_destruct_call_outputs_stmt(st, source) {
    define handled = false;
    if (!handled && st.__tag__ == "DestructAssign") { check_destruct_call_expr(st.expr, Set.from_list(st.names), source, st.pos); handled = true; }
    if (!handled && st.__tag__ == "If") { lint_destruct_call_outputs(st.then, source); lint_destruct_call_outputs(st.els, source); handled = true; }
    if (!handled && st.__tag__ == "While") { lint_destruct_call_outputs(st.body, source); handled = true; }
    if (!handled && st.__tag__ == "Switch") {
        define ci = 0;
        while (ci < len(st.cases)) { lint_destruct_call_outputs(heap_get(st.cases, ci).body, source); ci = ci + 1; }
        handled = true;
    }
    if (!handled && st.__tag__ == "Fn") { lint_destruct_call_outputs(st.body, source); handled = true; }
    if (!handled && st.__tag__ == "MethodDef") { lint_destruct_call_outputs(st.body, source); handled = true; }
    if (!handled && st.__tag__ == "ClassDef") { define mi = 0; while (mi < len(st.methods)) { lint_destruct_call_outputs_stmt(heap_get(st.methods, mi), source); mi = mi + 1; } handled = true; }
    if (!handled && st.__tag__ == "Namespace") { lint_destruct_call_outputs(st.body, source); handled = true; }
    if (!handled && st.__tag__ == "TryCatch") { lint_destruct_call_outputs(st.body, source); lint_destruct_call_outputs(st.handler, source); }
}

fn check_destruct_call_expr(expr, names, source, pos) {
    if (expr.__tag__ == "Call") {
        define skip = Set.from_list(new["heap_set", "heap_get", "delete", "tag", "__new", "new"]);
        if (Set.has(skip, expr.name)) { return Null; }
        define missing_set = Set.new();
        define i = 0;
        while (i < len(expr.args)) {
            define arg = heap_get(expr.args, i);
            if (arg.__tag__ == "Var" && !Set.has(names, arg.name)) { define _ = Set.add(missing_set, arg.name); }
            i = i + 1;
        }
        define missing = __sorted_strings(Set.to_list(missing_set));
        if (len(missing) > 0) {
            define msg = "destructuring call to " + expr.name + " must include output for argument(s): " + String.join(missing, ", ");
            if (source != Null) { _lint_error(source, pos, msg, "E006", "Add the missing binding(s) to the destructuring pattern so each referenced argument is captured."); }
            else { __raise_runtime_error(msg); }
        }
    } else {
        if (expr.__tag__ == "MethodCall") {
            define missing_set = Set.new();
            define i = 0;
            while (i < len(expr.args)) {
                define arg = heap_get(expr.args, i);
                if (arg.__tag__ == "Var" && !Set.has(names, arg.name)) { define _ = Set.add(missing_set, arg.name); }
                i = i + 1;
            }
            define missing = __sorted_strings(Set.to_list(missing_set));
            if (len(missing) > 0) {
                define msg = "destructuring method call to " + expr.name + " must include output for argument(s): " + String.join(missing, ", ");
                if (source != Null) { _lint_error(source, pos, msg, "E006", "Add the missing binding(s) to the destructuring pattern so each referenced argument is captured."); }
                else { __raise_runtime_error(msg); }
            }
        }
    }
}

fn lint_param_mutations_returned(stmts, params, fn_name, is_method, source, pos) {
    define mutated = Set.new();
    define returned = Set.new();

    fn visit(st) {
        define handled = false;
        if (!handled && st.__tag__ == "Assign" && Set.has(params, st.name)) { define _ = Set.add(mutated, st.name); handled = true; }
        if (!handled && st.__tag__ == "FieldAssign" && st.obj.__tag__ == "Var" && Set.has(params, st.obj.name)) { define _ = Set.add(mutated, st.obj.name); handled = true; }
        if (!handled && st.__tag__ == "DestructAssign") { define i = 0; while (i < len(st.names)) { define nm = heap_get(st.names, i); if (Set.has(params, nm)) { define _ = Set.add(mutated, nm); } i = i + 1; } handled = true; }
        if (!handled && st.__tag__ == "Return") {
            define reads = Map.new(); uses_in_expr(st.expr, reads);
            define keys = Map.keys(reads);
            define i = 0;
            while (i < len(keys)) { define n = heap_get(keys, i); if (Set.has(params, n)) { define _ = Set.add(returned, n); } i = i + 1; }
            handled = true;
        }
        if (!handled && st.__tag__ == "If") { define i = 0; while (i < len(st.then)) { visit(heap_get(st.then, i)); i = i + 1; } i = 0; while (i < len(st.els)) { visit(heap_get(st.els, i)); i = i + 1; } handled = true; }
        if (!handled && st.__tag__ == "TryCatch") { define i = 0; while (i < len(st.body)) { visit(heap_get(st.body, i)); i = i + 1; } i = 0; while (i < len(st.handler)) { visit(heap_get(st.handler, i)); i = i + 1; } handled = true; }
        if (!handled && st.__tag__ == "While") { define i = 0; while (i < len(st.body)) { visit(heap_get(st.body, i)); i = i + 1; } }
        if (!handled && st.__tag__ == "Switch") {
            define ci = 0;
            while (ci < len(st.cases)) {
                define case_node = heap_get(st.cases, ci);
                define bi = 0;
                while (bi < len(case_node.body)) { visit(heap_get(case_node.body, bi)); bi = bi + 1; }
                ci = ci + 1;
            }
        }
    }

    define i = 0;
    while (i < len(stmts)) { visit(heap_get(stmts, i)); i = i + 1; }

    define missing = __sorted_strings(Set.to_list(Set.difference(mutated, returned)));
    if (len(missing) > 0) {
        define kind = "function";
        if (is_method) { kind = "method"; }
        define msg = "mutated parameter(s) in " + kind + " " + fn_name + " must be returned: " + String.join(missing, ", ");
        if (source == Null) { __raise_runtime_error(msg); }
        else { _lint_error(source, pos, msg, "E001", "Return the mutated parameters so callers receive the updates."); }
    }
}
