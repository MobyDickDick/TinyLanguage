// TinyLanguage wrapper mirroring src/tiny_lang_cli.py.

define tiny_cli = Python.import_module("tiny_language_cli", new["main"]);
define os = Python.import_module("os", new["getenv"]);
define builtins = Python.import_module("builtins", new["exit"]);

fn __argv_from_env() {
    define raw = os.getenv("TINYLANG_ARGS", "");
    define payload = "[]";
    if (raw != Null && len(raw) > 0) { payload = raw; }
    return JSON.parse(payload);
}

fn run() {
    define code = tiny_cli.main(__argv_from_env());
    define _ = builtins.exit(code);
}

define _ = run();
