    visit_block(stmts);
}

fn lint_no_consecutive_definitions(stmts) {
    define prev = Null;

    fn check_block(block) {
        prev = Null;
        define i = 0;
        while (i < len(block)) {
            define st = heap_get(block, i);
            define handled = false;
            if (!handled && (st.__tag__ == "If" || st.__tag__ == "While" || st.__tag__ == "Switch")) {
                if (st.__tag__ == "If") { lint_no_consecutive_definitions(st.then); lint_no_consecutive_definitions(st.els); }
                else {
                    if (st.__tag__ == "While") { lint_no_consecutive_definitions(st.body); }
                    else {
                        define ci = 0;
                        while (ci < len(st.cases)) { lint_no_consecutive_definitions(heap_get(st.cases, ci).body); ci = ci + 1; }
                    }
                }
                prev = Null;
                handled = true;
            }
            if (!handled && st.__tag__ == "Fn") { lint_no_consecutive_definitions(st.body); prev = Null; handled = true; }
            if (!handled && st.__tag__ == "MethodDef") { lint_no_consecutive_definitions(st.body); prev = Null; handled = true; }
            if (!handled && st.__tag__ == "ClassDef") {
                define mi = 0;
                while (mi < len(st.methods)) { lint_no_consecutive_definitions(heap_get(st.methods, mi).body); mi = mi + 1; }
                prev = Null;
                handled = true;
            }
            if (!handled && st.__tag__ == "Namespace") { lint_no_consecutive_definitions(st.body); prev = Null; handled = true; }
            if (!handled && st.__tag__ == "TryCatch") { lint_no_consecutive_definitions(st.body); lint_no_consecutive_definitions(st.handler); prev = Null; handled = true; }
            if (!handled) {
