// TinyLanguage wrapper for src/tiny_language_highlighting.py.
// Exposes syntax highlighting helpers when pygments is available.

def PY_ALLOW = new["PYGMENTS_AVAILABLE", "highlight_source"];

def PY = Python.import_module("tiny_language_highlighting", PY_ALLOW);

def PYGMENTS_AVAILABLE = PY.PYGMENTS_AVAILABLE;
def highlight_source = PY.highlight_source;

def exports = new[PYGMENTS_AVAILABLE, highlight_source];
