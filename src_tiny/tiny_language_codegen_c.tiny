// TinyLanguage wrapper for src/tiny_language_codegen_c.py.
// Exposes the C backend code generator via Python interop.

def PY_ALLOW = new["CCodeGenerator"];

def PY = Python.import_module("tiny_language_codegen_c", PY_ALLOW);

def CCodeGenerator = PY.CCodeGenerator;

def exports = new[CCodeGenerator];
