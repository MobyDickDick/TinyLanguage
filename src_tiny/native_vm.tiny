// TinyLanguage-Port von src/native_vm.py
// Runtime for executing TinyLanguage native bytecode.

// Opcode + IR definitions are expected from native_ir.tiny

def __PY_STR_ALLOW = new["str"];
def __PY_BOOL_ALLOW = new["bool"];
def __PY_POW_ALLOW = new["pow"];
def __PY_EXEC_ALLOW = new["exec"];
def __PY_REPR_ALLOW = new["repr"];

fn __to_str(value) {
    return Python.call("builtins", "str", new[value], __PY_STR_ALLOW);
}

fn __to_bool(value) {
    return Python.call("builtins", "bool", new[value], __PY_BOOL_ALLOW);
}

fn __raise_runtime_error(msg) {
    def safe = Python.call("builtins", "repr", new[msg], __PY_REPR_ALLOW);
    def stmt = "raise RuntimeError(" + safe + ")";
    return Python.call("builtins", "exec", new[stmt], __PY_EXEC_ALLOW);
}

fn __reverse_list(items) {
    def out = new[];
    def i = len(items) - 1;
    while (i >= 0) {
        def _ = Collections.push(out, heap_get(items, i));
        i = i - 1;
    }
    return out;
}

fn __pop_args(stack, count) {
    def raw = new[];
    def i = 0;
    while (i < count) {
        def val = Collections.pop(stack);
        def _ = Collections.push(raw, val);
        i = i + 1;
    }
    return __reverse_list(raw);
}

fn __format_value(value) {
    if (value == Null) { return "null"; }
    if (value == true) { return "true"; }
    if (value == false) { return "false"; }
    return __to_str(value);
}

fn __binary_apply(op, left, right) {
    if (op == "+") { return left + right; }
    if (op == "-") { return left - right; }
    if (op == "*") { return left * right; }
    if (op == "/") { return left / right; }
    if (op == "%") { return left % right; }
    if (op == "^") { return Python.call("builtins", "pow", new[left, right], __PY_POW_ALLOW); }
    if (op == "==") { return left == right; }
    if (op == "!=") { return left != right; }
    if (op == "<") { return left < right; }
    if (op == ">") { return left > right; }
    if (op == "<=") { return left <= right; }
    if (op == ">=") { return left >= right; }
    if (op == "&&" || op == "and") { return __to_bool(left) && __to_bool(right); }
    if (op == "||" || op == "or") { return __to_bool(left) || __to_bool(right); }
    def _ = __raise_runtime_error("unsupported operator " + op);
    return Null;
}

fn __supported_opcodes() {
    def items = new[
        OPCODE_PUSH_CONST,
        OPCODE_LOAD,
        OPCODE_STORE,
        OPCODE_BINARY,
        OPCODE_PRINT,
        OPCODE_FLUSH,
        OPCODE_JUMP,
        OPCODE_JUMP_IF_FALSE,
        OPCODE_CALL,
        OPCODE_POP,
        OPCODE_RETURN
    ];
    return String.join(items, ", ");
}

class _Frame {
    instructions: Pointer;
    locals: any;
    ip: number;
}

fn _Frame(instructions, locals) {
    def locals_map = locals;
    if (locals_map == Null) { locals_map = Map.new(); }
    return new _Frame { instructions: instructions; locals: locals_map; ip: 0 };
}

class NativeVM {
    output: Pointer;
    globals: any;
    program: any;

    fn run(self, program) {
        self.program = program;
        self.output = new[];
        self.globals = Map.new();
        def _ = _vm_execute(self, _Frame(program.entry, self.globals));
        return String.join(self.output, "");
    }
}

fn NativeVM() {
    return new NativeVM { output: new[]; globals: Map.new(); program: Null };
}

fn _vm_load(vm, locals, name) {
    if (Map.has(locals, name)) { return Map.get(locals, name); }
    if (Map.has(vm.globals, name)) { return Map.get(vm.globals, name); }
    def _ = __raise_runtime_error("unknown variable " + name);
    return Null;
}

fn _vm_call(vm, name, args) {
    if (vm.program == Null) { def _ = __raise_runtime_error("VM has no program loaded"); }
    def target = Map.get(vm.program.functions, name);
    if (target == Null) { def _ = __raise_runtime_error("unknown function " + name); }
    if (len(args) != len(target.params)) {
        def _ = __raise_runtime_error("function " + name + " expects " + __to_str(len(target.params)) + " args, got " + __to_str(len(args)));
    }
    def locals = Map.new();
    def i = 0;
    while (i < len(target.params)) {
        def param = heap_get(target.params, i);
        def arg = heap_get(args, i);
        def _ = Map.set(locals, param, arg);
        i = i + 1;
    }
    return _vm_execute(vm, _Frame(target.instructions, locals));
}

fn _vm_execute(vm, frame) {
    def stack = new[];
    def ip = frame.ip;
    def instructions = frame.instructions;
    def locals = frame.locals;
    while (ip < len(instructions)) {
        def instr = heap_get(instructions, ip);
        ip = ip + 1;

        if (instr.op == OPCODE_PUSH_CONST) {
            def _ = Collections.push(stack, instr.arg);
        } else {
            if (instr.op == OPCODE_LOAD) {
                def _ = Collections.push(stack, _vm_load(vm, locals, instr.arg));
            } else {
                if (instr.op == OPCODE_STORE) {
                    def value = Collections.pop(stack);
                    def _ = Map.set(locals, instr.arg, value);
                    if (locals == vm.globals) { def _g = Map.set(vm.globals, instr.arg, value); }
                } else {
                    if (instr.op == OPCODE_BINARY) {
                        def right = Collections.pop(stack);
                        def left = Collections.pop(stack);
                        def _ = Collections.push(stack, __binary_apply(instr.arg, left, right));
                    } else {
                        if (instr.op == OPCODE_PRINT) {
                            def values = __pop_args(stack, instr.arg);
                            def rendered = new[];
                            def i = 0;
                            while (i < len(values)) {
                                def _ = Collections.push(rendered, __format_value(heap_get(values, i)));
                                i = i + 1;
                            }
                            def line = String.join(rendered, " ") + "\n";
                            def _ = Collections.push(vm.output, line);
                        } else {
                            if (instr.op == OPCODE_FLUSH) {
                                // No-op in Tiny runtime; output is buffered in memory.
                            } else {
                                if (instr.op == OPCODE_JUMP) {
                                    ip = instr.arg;
                                } else {
                                    if (instr.op == OPCODE_JUMP_IF_FALSE) {
                                        def cond = Collections.pop(stack);
                                        if (!__to_bool(cond)) { ip = instr.arg; }
                                    } else {
                                        if (instr.op == OPCODE_CALL) {
                                            def name = heap_get(instr.arg, 0);
                                            def argc = heap_get(instr.arg, 1);
                                            def args = __pop_args(stack, argc);
                                            def _ = Collections.push(stack, _vm_call(vm, name, args));
                                        } else {
                                            if (instr.op == OPCODE_POP) {
                                                def _ = Collections.pop(stack);
                                            } else {
                                                if (instr.op == OPCODE_RETURN) {
                                                    if (len(stack) == 0) { return Null; }
                                                    return Collections.pop(stack);
                                                } else {
                                                    def msg = "unknown opcode " + instr.op + ". Supported opcodes: " + __supported_opcodes() + ".";
                                                    def _ = __raise_runtime_error(msg);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return Null;
}
