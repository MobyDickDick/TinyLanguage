// TinyLanguage wrapper for src/tiny_language_runtime.py.
// Delegates Runtime helpers to the stitched Python module for parity.

def PY_ALLOW = new[
    "Runtime",
    "ModuleResolver",
    "Debugger",
    "NamespaceRef",
    "ReturnSignal",
    "TinyLangError",
    "format_error",
    "register_stdlib",
    "SourcePos",
    "SourceSpan",
    "DebugSnapshot",
    "StepRequest"
];

def PY = Python.import_module("tiny_language", PY_ALLOW);

def Runtime = PY.Runtime;
def ModuleResolver = PY.ModuleResolver;
def Debugger = PY.Debugger;
def NamespaceRef = PY.NamespaceRef;
def ReturnSignal = PY.ReturnSignal;
def TinyLangError = PY.TinyLangError;
def format_error = PY.format_error;
def register_stdlib = PY.register_stdlib;
def SourcePos = PY.SourcePos;
def SourceSpan = PY.SourceSpan;
def DebugSnapshot = PY.DebugSnapshot;
def StepRequest = PY.StepRequest;
