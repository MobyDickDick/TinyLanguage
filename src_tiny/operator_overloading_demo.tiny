// Operator-Overloading mit einer kleinen Vektor-Klasse, jede Zeile kommentiert.
class Point { // Klasse zur Darstellung eines 2D-Punkts.
    x: number; // X-Koordinate des Punkts.
    y: number; // Y-Koordinate des Punkts.

    fn to_tuple(self) { // Wandelt den Punkt in ein Heap-Array um.
        return new[self.x, self.y]; // Speichert x und y in ein neues Array.
    }
}

fn Point(x, y) { // Fabrikfunktion zur einfachen Erstellung eines Punktes.
    return new Point { x: x; y: y }; // Initialisiert Felder anhand der Parameter.
}

operator + (a: Point, b: Point) -> Point { // Überlädt + für die Punktaddition.
    return Point(a.x + b.x, a.y + b.y); // Addiert Koordinaten paarweise.
}

operator == (left: Point, right: Point) -> Bool { // Überlädt == für Strukturvergleich.
    return left.x == right.x && left.y == right.y; // Punkte sind gleich, wenn beide Koordinaten passen.
}

define p = Point(1, 2); // Erstellt einen Punkt bei (1, 2).
define q = Point(3, 4); // Erstellt einen zweiten Punkt bei (3, 4).

define sum = p + q; // Nutzt die überladene Addition zur Summenbildung.
print(heap_get(sum.to_tuple(), 0)); // 4 // Gibt die x-Komponente des Summen-Punkts aus.
print(heap_get(sum.to_tuple(), 1)); // 6 // Gibt die y-Komponente des Summen-Punkts aus.
print(p == sum); // false // Vergleich von Originalpunkt und Summe ergibt false.
