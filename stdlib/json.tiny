// TinyLanguage stdlib: json module (Python-style subset)

fn loads(text) -> any {
  return JSON.parse(text);
}

fn dumps(value) -> string {
  return JSON.stringify(value);
}

fn load(path) -> any {
  return JSON.parse(File.read(path));
}

fn dump(path, value) -> bool {
  return File.write(path, JSON.stringify(value));
}

fn parse(text) -> any {
  return loads(text);
}

fn stringify(value) -> string {
  return dumps(value);
}

fn validate(text) -> bool {
  return JSON.validate(text);
}
