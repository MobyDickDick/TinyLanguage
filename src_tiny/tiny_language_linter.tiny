// TinyLanguage port of the linter from src/tiny_language_linter.py.
// Covers must-use rules, type changes, return exhaustiveness, and
// import/destructuring checks. Error messages mirror the Python
// version (including error codes) as closely as possible.

define __PY_REPR_ALLOW = new["repr"];
define __PY_EXEC_ALLOW = new["exec"];
define __PY_STR_ALLOW = new["str"];
define __PY_LIST_ALLOW = new["list"];

fn __starts_with(text, prefix) {
    if (text == Null || prefix == Null) { return false; }
    define text_chars = Python.call("builtins", "list", new[text], __PY_LIST_ALLOW);
    define prefix_chars = Python.call("builtins", "list", new[prefix], __PY_LIST_ALLOW);
    if (len(prefix_chars) > len(text_chars)) { return false; }
    define i = 0;
    while (i < len(prefix_chars)) {
        if (heap_get(prefix_chars, i) != heap_get(text_chars, i)) { return false; }
        i = i + 1;
    }
    return true;
}

fn __raise_runtime_error(msg) {
    define safe = Python.call("builtins", "repr", new[msg], __PY_REPR_ALLOW);
    define stmt = "raise RuntimeError(" + safe + ")";
    // Return value is irrelevant — the call raises an exception.
    return Python.call("builtins", "exec", new[stmt], __PY_EXEC_ALLOW);
}

fn __to_str(value) {
    return Python.call("builtins", "str", new[value], __PY_STR_ALLOW);
}

fn __sorted_strings(items) {
    define arr = new[];
    define i = 0;
    while (i < len(items)) { define _ = Collections.push(arr, heap_get(items, i)); i = i + 1; }
    define n = len(arr);
    define a = 0;
    fn _swap(list, idx_a, idx_b) {
        define out = new[];
        define si = 0;
        while (si < len(list)) {
            if (si == idx_a) {
                define _ = Collections.push(out, heap_get(list, idx_b));
            } else {
                if (si == idx_b) { define _ = Collections.push(out, heap_get(list, idx_a)); }
                else { define _ = Collections.push(out, heap_get(list, si)); }
            }
            si = si + 1;
        }
        return out;
    }
    while (a < n) {
        define b = a + 1;
        while (b < n) {
            define ia = heap_get(arr, a);
            define ib = heap_get(arr, b);
            if (ib < ia) {
                arr = _swap(arr, a, b);
            }
            b = b + 1;
        }
        a = a + 1;
    }
    return arr;
}

fn __copy_state(state) {
    define keys = Map.keys(state);
    define new_state = Map.new();
    define i = 0;
    while (i < len(keys)) {
        define k = heap_get(keys, i);
        define _ = Map.set(new_state, k, Map.get(state, k));
        i = i + 1;
    }
    return new_state;
}

fn _import_binding_name(module, alias) {
    if (alias != Null) { return alias; }
    define chars = Python.call("builtins", "list", new[module], __PY_LIST_ALLOW);
    define idx = 0;
    while (idx < len(chars) && heap_get(chars, idx) == ".") { idx = idx + 1; }
    if (idx >= len(chars)) { return module; }
    define trimmed = String.join(Collections.slice(chars, idx, len(chars)), "");
    define parts = String.split(trimmed, ".");
    if (len(parts) == 0) { return trimmed; }
    return heap_get(parts, len(parts) - 1);
}

fn __starts_with_underscore(name) {
    if (name == Null) { return false; }
    if (String.len(name) == 0) { return false; }
    return heap_get(Python.call("builtins", "list", new[name], __PY_LIST_ALLOW), 0) == "_";
}

fn __pad_left(num, width) {
    define txt = __to_str(num);
    while (String.len(txt) < width) { txt = " " + txt; }
    return txt;
}

fn __line_info(source, pos) {
    define target_pos = pos;
    define lines = String.split(source, "\n");
    if (target_pos.__tag__ == "SourceSpan") { target_pos = target_pos.start; }
    if (target_pos.__tag__ == "SourcePos") {
        define line = target_pos.line;
        if (line < 1) { line = 1; }
        if (line > len(lines) && len(lines) > 0) { line = len(lines); }
        define line_text = "";
        if (len(lines) > 0 && line - 1 >= 0 && line - 1 < len(lines)) { line_text = heap_get(lines, line - 1); }
        define col = target_pos.column;
        define max_col = String.len(line_text) + 1;
        if (max_col > 0 && col > max_col) { col = max_col; }
        if (col < 1) { col = 1; }
        return new[line, col, line_text];
    }
    define idx = target_pos;
    if (idx < 0) { idx = 0; }
    if (idx > String.len(source)) { idx = String.len(source); }
    define chars = Python.call("builtins", "list", new[source], __PY_LIST_ALLOW);
    define line = 1;
    define last_nl = -1;
    define i = 0;
    while (i < idx) {
        if (heap_get(chars, i) == "\n") {
            line = line + 1;
            last_nl = i;
        }
        i = i + 1;
    }
    define col = idx - last_nl;
    define line_text = "";
    if (len(lines) > 0 && line - 1 >= 0 && line - 1 < len(lines)) { line_text = heap_get(lines, line - 1); }
    return new[line, col, line_text];
}

fn __format_error(source, pos, message, code, hint) {
    if (pos.__tag__ == "SourceSpan") {
        define start_info = __line_info(source, pos.start);
        define stop_info = __line_info(source, pos.stop);
        define start_line = heap_get(start_info, 0);
        define start_col = heap_get(start_info, 1);
        define stop_line = heap_get(stop_info, 0);
        define stop_col = heap_get(stop_info, 1);
        define lines = String.split(source, "\n");
        define line_count = len(lines);
        if (line_count < 1) { line_count = 1; }
        define gutter_width = String.len(__to_str(line_count));
        define lines_out = new[];
        define header = "[" + code + "] " + message + " (line " + __to_str(start_line) + ", col " + __to_str(start_col) + ")";
        define _hpush = Collections.push(lines_out, header);
        define context_start = start_line - 1; if (context_start < 1) { context_start = 1; }
        define context_end = stop_line + 1;
        if (len(lines) == 0) { context_end = stop_line; }
        if (len(lines) > 0 && context_end > len(lines)) { context_end = len(lines); }
        define ln = context_start;
        while (ln <= context_end) {
            define text = "";
            if (len(lines) > 0 && ln - 1 >= 0 && ln - 1 < len(lines)) {
                text = heap_get(lines, ln - 1);
            }
            define prefix = " ";
            if (ln == start_line) { prefix = ">"; }
            define padded = __pad_left(ln, gutter_width);
            define _lpush = Collections.push(lines_out, prefix + " " + padded + " | " + text);

            if (ln >= start_line && ln <= stop_line) {
                define underline_start = 1;
                define underline_end = String.len(text);
                if (ln == start_line && ln == stop_line) {
                    underline_start = start_col;
                    underline_end = stop_col;
                } else {
                    if (ln == start_line) {
                        underline_start = start_col;
                        if (underline_end < start_col) { underline_end = start_col; }
                    } else {
                        if (ln == stop_line) {
                            underline_start = 1;
                            underline_end = stop_col;
                        } else {
                            if (underline_end < 1) { underline_end = 1; }
                        }
                    }
                }
                define underline_len = underline_end - underline_start + 1;
                if (underline_len < 1) { underline_len = 1; }
                define prefix_spaces = "";
                define i = 1;
                while (i < underline_start) { prefix_spaces = prefix_spaces + " "; i = i + 1; }
                define underline = prefix_spaces + String.repeat("^", underline_len);
                define _upush = Collections.push(lines_out, "  " + String.repeat(" ", gutter_width) + " | " + underline);
            }
            ln = ln + 1;
        }
        if (hint != Null && hint != "") {
            define _h = Collections.push(lines_out, "  Hint: " + hint);
        }
        return String.join(lines_out, "\n");
    }
    define lines = String.split(source, "\n");
    define line_count = len(lines);
    if (line_count < 1) { line_count = 1; }
    define info = __line_info(source, pos);
    define line = heap_get(info, 0);
    define col = heap_get(info, 1);
    define gutter_width = String.len(__to_str(line_count));
    define start = line - 1; if (start < 1) { start = 1; }
    define end = line + 1;
    if (len(lines) > 0 && end > len(lines)) { end = len(lines); }
    define lines_out = new[];
    define header = "[" + code + "] " + message + " (line " + __to_str(line) + ", col " + __to_str(col) + ")";
    define _ph = Collections.push(lines_out, header);
    define ln = start;
    while (ln <= end) {
        define text = "";
        if (len(lines) > 0 && ln - 1 >= 0 && ln - 1 < len(lines)) { text = heap_get(lines, ln - 1); }
        define prefix = " ";
        if (ln == line) { prefix = ">"; }
        define padded = __pad_left(ln, gutter_width);
        define _l = Collections.push(lines_out, prefix + " " + padded + " | " + text);
        if (ln == line) {
            define spaces = String.repeat(" ", col - 1);
            define caret = String.repeat("^", 1);
            define _u = Collections.push(lines_out, "  " + String.repeat(" ", gutter_width) + " | " + spaces + caret);
        }
        ln = ln + 1;
    }
    if (hint != Null && hint != "") {
        define _hint = Collections.push(lines_out, "  Hint: " + hint);
    }
    return String.join(lines_out, "\n");
}

fn _node_span(obj) {
    if (obj == Null) { return Null; }
    if (obj.__tag__ == "SourceSpan") { return obj; }
    if (obj.span != Null) { return obj.span; }
    return Null;
}

fn _node_pos(obj) {
    if (obj == Null) { return SourcePos_origin(); }
    if (obj.__tag__ == "SourceSpan") { return obj.start; }
    if (obj.__tag__ == "SourcePos") { return obj; }
    if (obj.pos != Null) { return obj.pos; }
    return SourcePos_origin();
}

fn _lint_error(source, node, message, code, hint) {
    define span = _node_span(node);
    define pos = _node_pos(node);
    define location = pos;
    if (span != Null) { location = span; }
    define rendered = __format_error(source, location, message, code, hint);
    return __raise_runtime_error(rendered);
}

fn _param_names(params) {
    define names = new[];
    define i = 0;
    while (i < len(params)) {
        define p = heap_get(params, i);
        define _ = Collections.push(names, p.name);
        i = i + 1;
    }
    return names;
}

fn _collect_names_in_expr(e, names) {
    if (e == Null) { return Null; }
    if (e.__tag__ == "Var") { define _ = Set.add(names, e.name); return Null; }
    if (e.__tag__ == "Bin") { _collect_names_in_expr(e.a, names); _collect_names_in_expr(e.b, names); return Null; }
    if (e.__tag__ == "Call") {
        define i = 0;
        while (i < len(e.args)) { _collect_names_in_expr(heap_get(e.args, i), names); i = i + 1; }
        return Null;
    }
    if (e.__tag__ == "Spawn") {
        define i = 0;
        while (i < len(e.args)) { _collect_names_in_expr(heap_get(e.args, i), names); i = i + 1; }
        return Null;
    }
    if (e.__tag__ == "Await") { _collect_names_in_expr(e.expr, names); return Null; }
    if (e.__tag__ == "New") { _collect_names_in_expr(e.size, names); return Null; }
    if (e.__tag__ == "NewLit") {
        define i = 0;
        while (i < len(e.items)) { _collect_names_in_expr(heap_get(e.items, i), names); i = i + 1; }
        return Null;
    }
    if (e.__tag__ == "Field") { _collect_names_in_expr(e.obj, names); return Null; }
    if (e.__tag__ == "MethodCall") {
        _collect_names_in_expr(e.obj, names);
        define i = 0;
        while (i < len(e.args)) { _collect_names_in_expr(heap_get(e.args, i), names); i = i + 1; }
        return Null;
    }
    if (e.__tag__ == "ClassNew") {
        define i = 0;
        while (i < len(e.init)) { _collect_names_in_expr(heap_get(heap_get(e.init, i), 1), names); i = i + 1; }
        return Null;
    }
    if (e.__tag__ == "ObjLit") {
        define i = 0;
        while (i < len(e.fields)) { _collect_names_in_expr(heap_get(heap_get(e.fields, i), 1), names); i = i + 1; }
        return Null;
    }
    if (e.__tag__ == "Match") {
        _collect_names_in_expr(e.expr, names);
        define i = 0;
        while (i < len(e.cases)) { _collect_names_in_expr(heap_get(e.cases, i).body, names); i = i + 1; }
        return Null;
    }
    if (e.__tag__ == "VariantCtor") {
        define i = 0;
        while (i < len(e.fields)) { _collect_names_in_expr(heap_get(heap_get(e.fields, i), 1), names); i = i + 1; }
        return Null;
    }
    return Null;
}

fn uses_in_expr(e, reads) {
    if (e == Null) { return Null; }
    if (e.__tag__ == "Var") {
        define prev = Map.get(reads, e.name, 0);
        define _ = Map.set(reads, e.name, prev + 1);
        return Null;
    }
    if (e.__tag__ == "Bin") { uses_in_expr(e.a, reads); uses_in_expr(e.b, reads); return Null; }
    if (e.__tag__ == "Call") {
        define i = 0;
        while (i < len(e.args)) { uses_in_expr(heap_get(e.args, i), reads); i = i + 1; }
        return Null;
    }
    if (e.__tag__ == "Spawn") {
        define i = 0;
        while (i < len(e.args)) { uses_in_expr(heap_get(e.args, i), reads); i = i + 1; }
        return Null;
    }
    if (e.__tag__ == "Await") { uses_in_expr(e.expr, reads); return Null; }
    if (e.__tag__ == "New") { uses_in_expr(e.size, reads); return Null; }
    if (e.__tag__ == "NewLit") {
        define i = 0;
        while (i < len(e.items)) { uses_in_expr(heap_get(e.items, i), reads); i = i + 1; }
        return Null;
    }
    if (e.__tag__ == "Field") { uses_in_expr(e.obj, reads); return Null; }
    if (e.__tag__ == "MethodCall") {
        uses_in_expr(e.obj, reads);
        define i = 0;
        while (i < len(e.args)) { uses_in_expr(heap_get(e.args, i), reads); i = i + 1; }
        return Null;
    }
    if (e.__tag__ == "ClassNew") {
        define i = 0;
        while (i < len(e.init)) { uses_in_expr(heap_get(heap_get(e.init, i), 1), reads); i = i + 1; }
        return Null;
    }
    if (e.__tag__ == "ObjLit") {
        define i = 0;
        while (i < len(e.fields)) { uses_in_expr(heap_get(heap_get(e.fields, i), 1), reads); i = i + 1; }
        return Null;
    }
    if (e.__tag__ == "Match") {
        uses_in_expr(e.expr, reads);
        define i = 0;
        while (i < len(e.cases)) {
            define tmp_reads = Map.new();
            uses_in_expr(heap_get(e.cases, i).body, tmp_reads);
            define keys = Map.keys(tmp_reads);
            define j = 0;
            while (j < len(keys)) {
                define name = heap_get(keys, j);
                define count = Map.get(tmp_reads, name, 0);
                define prev = Map.get(reads, name, 0);
                if (count > prev) { define _ = Map.set(reads, name, count); }
                j = j + 1;
            }
            i = i + 1;
        }
        return Null;
    }
    if (e.__tag__ == "VariantCtor") {
        define i = 0;
        while (i < len(e.fields)) { uses_in_expr(heap_get(heap_get(e.fields, i), 1), reads); i = i + 1; }
        return Null;
    }
    return Null;
}

fn lint_stmt_reads(s, reads) {
    if (s.__tag__ == "Let" || s.__tag__ == "Assign") { uses_in_expr(s.expr, reads); return Null; }
    if (s.__tag__ == "FieldAssign") { uses_in_expr(s.obj, reads); uses_in_expr(s.expr, reads); return Null; }
    if (s.__tag__ == "Print") {
        define i = 0;
        while (i < len(s.exprs)) { uses_in_expr(heap_get(s.exprs, i), reads); i = i + 1; }
        return Null;
    }
    if (s.__tag__ == "Flush") { return Null; }
    if (s.__tag__ == "If") {
        uses_in_expr(s.cond, reads);
        define i = 0;
        while (i < len(s.then)) { lint_stmt_reads(heap_get(s.then, i), reads); i = i + 1; }
        i = 0;
        while (i < len(s.els)) { lint_stmt_reads(heap_get(s.els, i), reads); i = i + 1; }
        return Null;
    }
    if (s.__tag__ == "While") { uses_in_expr(s.cond, reads); define i = 0; while (i < len(s.body)) { lint_stmt_reads(heap_get(s.body, i), reads); i = i + 1; } return Null; }
    if (s.__tag__ == "Switch") {
        uses_in_expr(s.expr, reads);
        define i = 0;
        while (i < len(s.cases)) {
            define case_node = heap_get(s.cases, i);
            if (case_node.value != Null) { uses_in_expr(case_node.value, reads); }
            define bi = 0;
            while (bi < len(case_node.body)) { lint_stmt_reads(heap_get(case_node.body, bi), reads); bi = bi + 1; }
            i = i + 1;
        }
        return Null;
    }
    if (s.__tag__ == "TryCatch") {
        define i = 0;
        while (i < len(s.body)) { lint_stmt_reads(heap_get(s.body, i), reads); i = i + 1; }
        define handler_reads = Map.new();
        i = 0;
        while (i < len(s.handler)) { lint_stmt_reads(heap_get(s.handler, i), handler_reads); i = i + 1; }
        if (s.err_name != Null) { if (Map.get(handler_reads, s.err_name, 0) == 0) { define _ = Map.set(handler_reads, s.err_name, 0); } }
        define keys = Map.keys(handler_reads);
        i = 0;
        while (i < len(keys)) {
            define name = heap_get(keys, i);
            define count = Map.get(handler_reads, name, 0);
            define prev = Map.get(reads, name, 0);
            if (count > prev) { define _ = Map.set(reads, name, count); }
            i = i + 1;
        }
        return Null;
    }
    if (s.__tag__ == "Return") { uses_in_expr(s.expr, reads); return Null; }
    if (s.__tag__ == "OpDef") {
        define tmp = Map.new();
        define i = 0;
        while (i < len(s.body)) { lint_stmt_reads(heap_get(s.body, i), tmp); i = i + 1; }
        define miss = new[];
        if (!__starts_with_underscore(s.a_name) && Map.get(tmp, s.a_name, 0) == 0) { define _ = Collections.push(miss, s.a_name); }
        if (!__starts_with_underscore(s.b_name) && Map.get(tmp, s.b_name, 0) == 0) { define _ = Collections.push(miss, s.b_name); }
        if (len(miss) > 0) {
            define msg = "unused operator parameter(s) in op " + s.op + ": " + String.join(miss, ", ");
            __raise_runtime_error(msg);
        }
        define keys = Map.keys(tmp);
        i = 0;
        while (i < len(keys)) {
            define name = heap_get(keys, i);
            if (!(name == s.a_name || name == s.b_name)) {
                define count = Map.get(tmp, name, 0);
                define prev = Map.get(reads, name, 0);
                if (count > prev) { define _ = Map.set(reads, name, count); }
            }
            i = i + 1;
        }
        return Null;
    }
    if (s.__tag__ == "DestructAssign") { uses_in_expr(s.expr, reads); return Null; }
    if (s.__tag__ == "MethodDef") {
        define tmp = Map.new();
        define i = 0;
        while (i < len(s.body)) { lint_stmt_reads(heap_get(s.body, i), tmp); i = i + 1; }
        define param_names = _param_names(s.params);
        define miss = new[];
        i = 0;
        while (i < len(param_names)) {
            define p = heap_get(param_names, i);
            if (p != "self" && !__starts_with_underscore(p)) {
                if (Map.get(tmp, p, 0) == 0) { define _ = Collections.push(miss, p); }
            }
            i = i + 1;
        }
        if (len(miss) > 0) {
            __raise_runtime_error("unused parameter(s) in method " + s.class_name + "." + s.name + ": " + String.join(miss, ", "));
        }
        define keys = Map.keys(tmp);
        i = 0;
        while (i < len(keys)) {
            define name = heap_get(keys, i);
            define skip = false;
            define j = 0;
            while (j < len(param_names)) { if (name == heap_get(param_names, j)) { skip = true; } j = j + 1; }
            if (!skip) {
                define count = Map.get(tmp, name, 0);
                define prev = Map.get(reads, name, 0);
                if (count > prev) { define _ = Map.set(reads, name, count); }
            }
            i = i + 1;
        }
        return Null;
    }
    if (s.__tag__ == "Fn") {
        define tmp = Map.new();
        define i = 0;
        while (i < len(s.body)) { lint_stmt_reads(heap_get(s.body, i), tmp); i = i + 1; }
        define param_names = _param_names(s.params);
        define keys = Map.keys(tmp);
        i = 0;
        while (i < len(keys)) {
            define name = heap_get(keys, i);
            define skip = false;
            define j = 0;
            while (j < len(param_names)) { if (name == heap_get(param_names, j)) { skip = true; } j = j + 1; }
            if (!skip) {
                define count = Map.get(tmp, name, 0);
                define prev = Map.get(reads, name, 0);
                if (count > prev) { define _ = Map.set(reads, name, count); }
            }
            i = i + 1;
        }
        return Null;
    }
    if (s.__tag__ == "ClassDef") {
        define i = 0;
        while (i < len(s.methods)) { lint_stmt_reads(heap_get(s.methods, i), reads); i = i + 1; }
        return Null;
    }
    if (s.__tag__ == "Namespace") {
        define i = 0;
        while (i < len(s.body)) { lint_stmt_reads(heap_get(s.body, i), reads); i = i + 1; }
        return Null;
    }
    if (s.__tag__ == "CallStmt") {
        define i = 0;
        while (i < len(s.args)) { uses_in_expr(heap_get(s.args, i), reads); i = i + 1; }
        return Null;
    }
    return Null;
}

fn lint_fn_params_used(fn_node, source) {
    define reads = Map.new();
    define i = 0;
    while (i < len(fn_node.body)) { lint_stmt_reads(heap_get(fn_node.body, i), reads); i = i + 1; }
    define param_names = _param_names(fn_node.params);
    define unused = new[];
        i = 0;
        while (i < len(param_names)) {
            define p = heap_get(param_names, i);
            if (!(p == "self" || __starts_with_underscore(p))) {
                if (Map.get(reads, p, 0) == 0) { define _ = Collections.push(unused, p); }
            }
            i = i + 1;
        }
    if (len(unused) > 0) {
        define msg = "unused parameter(s) in function " + fn_node.name + ": " + String.join(unused, ", ");
        if (source == Null) { __raise_runtime_error(msg); }
        else { _lint_error(source, fn_node, msg, "E002", "Remove the unused parameter or reference it."); }
