    return result;
}

fn __sig_equal(a, b) {
    if (len(a) != len(b)) { return false; }
    define i = 0;
    while (i < len(a)) { if (heap_get(a, i) != heap_get(b, i)) { return false; } i = i + 1; }
    return true;
}

fn _format_signature(sig) {
    if (len(sig) == 1 && heap_get(sig, 0) == "<scalar>") { return "single value"; }
    return "{" + String.join(sig, ", ") + "}";
