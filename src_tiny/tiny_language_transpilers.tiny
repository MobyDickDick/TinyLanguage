// TinyLanguage-Port des Transpiler-Moduls aus src/tiny_language_transpilers.py.
// Contains the shared IR structure and language transpilers for Python/Julia/JS/C++/Tiny.
// Parsing support mirrors the Python implementation for the constrained IR.

def __PY_EXEC_ALLOW = new["exec"];
def __PY_REPR_ALLOW = new["repr"];
def __PY_STR_ALLOW = new["str"];
def __PY_LIST_ALLOW = new["list"];
def __PY_INT_ALLOW = new["int"];
def __PY_FLOAT_ALLOW = new["float"];
def __PY_AST_ALLOW = new["literal_eval"];
def __PY_JSON_ALLOW = new["dumps"];

fn __raise_runtime_error(msg) {
    def safe = Python.call("builtins", "repr", new[msg], __PY_REPR_ALLOW);
    def stmt = "raise RuntimeError(" + safe + ")";
    return Python.call("builtins", "exec", new[stmt], __PY_EXEC_ALLOW);
}

fn __to_str(value) {
    return Python.call("builtins", "str", new[value], __PY_STR_ALLOW);
}

fn __to_repr(value) {
    return Python.call("builtins", "repr", new[value], __PY_REPR_ALLOW);
}

fn __json_dump(value) {
    return Python.call("json", "dumps", new[value], __PY_JSON_ALLOW);
}

fn __chars(text) {
    return Python.call("builtins", "list", new[text], __PY_LIST_ALLOW);
}

fn __is_space(ch) {
    return ch == " " || ch == "\t" || ch == "\n" || ch == "\r";
}

fn __strip(text) {
    if (text == Null) { return ""; }
    def chars = __chars(text);
    def start = 0;
    def end = len(chars) - 1;
    while (start < len(chars) && __is_space(heap_get(chars, start))) { start = start + 1; }
    while (end >= start && __is_space(heap_get(chars, end))) { end = end - 1; }
    if (end < start) { return ""; }
    return String.join(Collections.slice(chars, start, end + 1), "");
}

fn __starts_with(text, prefix) {
    if (text == Null || prefix == Null) { return false; }
    def text_chars = __chars(text);
    def prefix_chars = __chars(prefix);
    if (len(prefix_chars) > len(text_chars)) { return false; }
    def i = 0;
    while (i < len(prefix_chars)) {
        if (heap_get(text_chars, i) != heap_get(prefix_chars, i)) { return false; }
        i = i + 1;
    }
    return true;
}

fn __ends_with(text, suffix) {
    if (text == Null || suffix == Null) { return false; }
    def text_chars = __chars(text);
    def suffix_chars = __chars(suffix);
    if (len(suffix_chars) > len(text_chars)) { return false; }
    def offset = len(text_chars) - len(suffix_chars);
    def i = 0;
    while (i < len(suffix_chars)) {
        if (heap_get(text_chars, offset + i) != heap_get(suffix_chars, i)) { return false; }
        i = i + 1;
    }
    return true;
}

fn __strip_suffix(text, suffix) {
    if (!__ends_with(text, suffix)) { return text; }
    def chars = __chars(text);
    def keep = len(chars) - String.len(suffix);
    if (keep < 0) { keep = 0; }
    return String.join(Collections.slice(chars, 0, keep), "");
}

fn __strip_prefix(text, prefix) {
    if (!__starts_with(text, prefix)) { return text; }
    def chars = __chars(text);
    def skip = String.len(prefix);
    if (skip < 0) { skip = 0; }
    return String.join(Collections.slice(chars, skip, len(chars)), "");
}

fn __first_char(text) {
    if (text == Null) { return ""; }
    def chars = __chars(text);
    if (len(chars) == 0) { return ""; }
    return heap_get(chars, 0);
}

fn __find_char(text, target) {
    def chars = __chars(text);
    def i = 0;
    while (i < len(chars)) {
        if (heap_get(chars, i) == target) { return i; }
        i = i + 1;
    }
    return -1;
}

fn __copy_map(map) {
    def keys = Map.keys(map);
    def out = Map.new();
    def i = 0;
    while (i < len(keys)) {
        def k = heap_get(keys, i);
        def _unused1 = Map.set(out, k, Map.get(map, k));
        i = i + 1;
    }
    return out;
}

fn __list_or_empty(items) {
    if (items == Null) { return new[]; }
    return items;
}

fn __extend(list, items) {
    def i = 0;
    while (i < len(items)) {
        def _unused2 = Collections.push(list, heap_get(items, i));
        i = i + 1;
    }
    return list;
}

fn __split_params(text) {
    def trimmed = __strip(text);
    if (String.len(trimmed) == 0) { return new[]; }
    def parts = String.split(trimmed, ",");
    def params = new[];
    def i = 0;
    while (i < len(parts)) {
        def part = __strip(heap_get(parts, i));
        if (String.len(part) > 0) { def _unused3 = Collections.push(params, part); }
        i = i + 1;
    }
    return params;
}

fn __split_by_braces(line) {
    def parts = new[];
    def current = "";
    def chars = __chars(line);
    def i = 0;
    while (i < len(chars)) {
        def ch = heap_get(chars, i);
        if (ch == "{" || ch == "}") {
            if (String.len(__strip(current)) > 0) {
                def _unused4 = Collections.push(parts, __strip(current));
            }
            def _b = Collections.push(parts, ch);
            current = "";
        } else {
            current = current + ch;
        }
        i = i + 1;
    }
    if (String.len(__strip(current)) > 0) {
        def _unused5 = Collections.push(parts, __strip(current));
    }
    return parts;
}

fn __strip_trailing_semicolon(text) {
    def trimmed = __strip(text);
    if (__ends_with(trimmed, ";")) {
        return __strip_suffix(trimmed, ";");
    }
    return trimmed;
}

fn __is_digit(ch) { return ch >= "0" && ch <= "9"; }

fn __is_identifier_start(ch) {
    return (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || ch == "_";
}

fn __is_identifier_char(ch) {
    return __is_identifier_start(ch) || __is_digit(ch);
}

fn __tokenize_expr(text) {
    def tokens = new[];
    def chars = __chars(text);
    def i = 0;
    while (i < len(chars)) {
        def ch = heap_get(chars, i);
        def handled = false;
        if (__is_space(ch)) {
            i = i + 1;
            handled = true;
        }
        if (!handled && (ch == "\"" || ch == "'")) {
            def quote = ch;
            def start = i;
            i = i + 1;
            def done = false;
            while (i < len(chars) && !done) {
                def curr = heap_get(chars, i);
                if (curr == "\\") {
                    i = i + 2;
                } else {
                    if (curr == quote) {
                        i = i + 1;
                        done = true;
                    } else {
                        i = i + 1;
                    }
                }
            }
            def token_chars = Collections.slice(chars, start, i);
            def token = String.join(token_chars, "");
            def _unused6 = Collections.push(tokens, token);
            handled = true;
        }
        if (!handled && __is_digit(ch)) {
            def start = i;
            def saw_dot = false;
            def done = false;
            while (i < len(chars) && !done) {
                def curr = heap_get(chars, i);
                if (curr == "." && !saw_dot) {
                    saw_dot = true;
                    i = i + 1;
                } else {
                    if (!__is_digit(curr)) {
                        done = true;
                    } else {
                        i = i + 1;
                    }
                }
            }
            def token = String.join(Collections.slice(chars, start, i), "");
            def _unused7 = Collections.push(tokens, token);
            handled = true;
        }
        if (!handled && __is_identifier_start(ch)) {
            def start = i;
            i = i + 1;
            while (i < len(chars) && __is_identifier_char(heap_get(chars, i))) { i = i + 1; }
            def token = String.join(Collections.slice(chars, start, i), "");
            def _unused8 = Collections.push(tokens, token);
            handled = true;
        }
        if (!handled && i + 1 < len(chars)) {
            def two = heap_get(chars, i) + heap_get(chars, i + 1);
            if (two == "==" || two == "!=" || two == "<=" || two == ">=" || two == "**") {
                def _unused9 = Collections.push(tokens, two);
                i = i + 2;
                handled = true;
            }
        }
        if (!handled) {
            def _unused10 = Collections.push(tokens, ch);
            i = i + 1;
        }
    }
    return tokens;
}

fn __parse_number(token) {
    if (String.contains(token, ".")) {
        return Python.call("builtins", "float", new[token], __PY_FLOAT_ALLOW);
    }
    return Python.call("builtins", "int", new[token], __PY_INT_ALLOW);
}

fn __parse_literal(token) {
    if (token == "true" || token == "True") { return true; }
    if (token == "false" || token == "False") { return false; }
    if (token == "null" || token == "None" || token == "nothing" || token == "nullptr") { return Null; }
    if (__starts_with(token, "\"") || __starts_with(token, "'")) {
        return Python.call("ast", "literal_eval", new[token], __PY_AST_ALLOW);
    }
    return __parse_number(token);
}

fn __is_repr_string(value) {
    def repr = __to_repr(value);
    return __starts_with(repr, "'") || __starts_with(repr, "\"");
}

fn __parse_expression(text) {
    def tokens = __tokenize_expr(text);
    def idx = 0;

    fn peek() {
        if (idx >= len(tokens)) { return Null; }
        return heap_get(tokens, idx);
    }

    fn consume() {
        def token = peek();
        idx = idx + 1;
        return token;
    }

    fn parse_primary() {
        def token = consume();
        if (token == "(") {
            def expr = parse_comparison();
            if (peek() == ")") { def _unused11 = consume(); }
            return expr;
        }
        if (token == Null) { return __raise_runtime_error("Unexpected end of expression"); }
        def first = __first_char(token);
        def next = peek();
        if (__is_identifier_start(first) && next == "(") {
            def _open = consume();
            def args = new[];
            if (peek() != ")") {
                def done = false;
                while (!done) {
                    def arg_expr = parse_comparison();
                    def _unused12 = Collections.push(args, arg_expr);
                    if (peek() == ",") { def _c = consume(); }
                    else { done = true; }
                }
            }
            if (peek() == ")") { def _close = consume(); }
            return Call(token, args);
        }
        if (__is_identifier_start(first)) {
            if (token == "true" || token == "false" || token == "null" || token == "None" || token == "nothing" || token == "nullptr") {
                return Literal(__parse_literal(token));
            }
            return Name(token);
        }
        if (token == "+" || token == "-" || token == "*" || token == "/" || token == "%" || token == "**" || token == "==" || token == "!=" || token == "<" || token == ">" || token == "<=" || token == ">=") {
            return __raise_runtime_error("Unexpected operator token: " + token);
        }
        return Literal(__parse_literal(token));
    }

    fn parse_power() {
        def left = parse_primary();
        if (peek() == "**") {
            def _unused13 = consume();
            def right = parse_power();
            return BinaryOp("**", left, right);
        }
        return left;
    }

    fn parse_mul() {
        def expr = parse_power();
        def done = false;
        while (!done) {
            def op = peek();
            if (op == "*" || op == "/" || op == "%") {
                def _unused14 = consume();
                def rhs = parse_power();
                expr = BinaryOp(op, expr, rhs);
            } else {
                done = true;
            }
        }
        return expr;
    }

    fn parse_add() {
        def expr = parse_mul();
        def done = false;
        while (!done) {
            def op = peek();
            if (op == "+" || op == "-") {
                def _unused15 = consume();
                def rhs = parse_mul();
                expr = BinaryOp(op, expr, rhs);
            } else {
                done = true;
            }
        }
        return expr;
    }

    fn parse_comparison() {
        def expr = parse_add();
        def op = peek();
        if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=") {
            def _unused16 = consume();
            def rhs = parse_add();
            return BinaryOp(op, expr, rhs);
        }
        return expr;
    }

    return parse_comparison();
}

fn __split_assignment(line) {
    def chars = __chars(line);
    def depth = 0;
    def quote = Null;
    def i = 0;
    while (i < len(chars)) {
        def ch = heap_get(chars, i);
        if (quote != Null) {
            if (ch == "\\") {
                i = i + 2;
            } else {
                if (ch == quote) { quote = Null; }
                i = i + 1;
            }
        } else {
            if (ch == "\"" || ch == "'") {
                quote = ch;
                i = i + 1;
            } else {
                if (ch == "(") {
                    depth = depth + 1;
                    i = i + 1;
                } else {
                    if (ch == ")") {
                        depth = depth - 1;
                        i = i + 1;
                    } else {
                        if (ch == "=" && depth == 0) {
                            def prev = "";
                            def next = "";
                            if (i > 0) { prev = heap_get(chars, i - 1); }
                            if (i + 1 < len(chars)) { next = heap_get(chars, i + 1); }
                            if (prev == "=" || prev == "!" || prev == "<" || prev == ">" || next == "=") {
                                i = i + 1;
                            } else {
                                def left = String.join(Collections.slice(chars, 0, i), "");
                                def right = String.join(Collections.slice(chars, i + 1, len(chars)), "");
                                return new[left, right];
                            }
                        } else {
                            i = i + 1;
                        }
                    }
                }
            }
        }
    }
    return Null;
}

fn __parse_statement(line) {
    def trimmed = __strip_trailing_semicolon(line);
    if (__starts_with(trimmed, "return ")) {
        def expr = __strip_prefix(trimmed, "return ");
        return Return(__parse_expression(expr));
    }
    if (__starts_with(trimmed, "const ") || __starts_with(trimmed, "let ") || __starts_with(trimmed, "var ") || __starts_with(trimmed, "auto ")) {
        trimmed = __strip(trimmed);
        if (__starts_with(trimmed, "const ")) { trimmed = __strip_prefix(trimmed, "const "); }
        if (__starts_with(trimmed, "let ")) { trimmed = __strip_prefix(trimmed, "let "); }
        if (__starts_with(trimmed, "var ")) { trimmed = __strip_prefix(trimmed, "var "); }
        if (__starts_with(trimmed, "auto ")) { trimmed = __strip_prefix(trimmed, "auto "); }
        trimmed = __strip(trimmed);
    }
    def split = __split_assignment(trimmed);
    if (split != Null) {
        def target = __strip(heap_get(split, 0));
        def expr = __strip(heap_get(split, 1));
        return Assign(target, __parse_expression(expr));
    }
    return ExprStmt(__parse_expression(trimmed));
}

fn __line_indent(line) {
    def chars = __chars(line);
    def i = 0;
    while (i < len(chars) && heap_get(chars, i) == " ") { i = i + 1; }
    return i;
}

fn __python_tokenize_lines(code) {
    def raw_lines = String.split(code, "\n");
    def lines = new[];
    def i = 0;
    while (i < len(raw_lines)) {
        def raw = heap_get(raw_lines, i);
        def text = __strip(raw);
        if (String.len(text) > 0) {
            def indent = __line_indent(raw);
            def _unused17 = Collections.push(lines, new[indent, text]);
        }
        i = i + 1;
    }
    return lines;
}

fn __python_parse_signature(line) {
    def trimmed = __strip(line);
    def signature = __strip_prefix(trimmed, "def ");
    signature = __strip_suffix(signature, ":");
    def open = __find_char(signature, "(");
    def close = __find_char(signature, ")");
    if (open < 0 || close < 0 || close < open) { return __raise_runtime_error("Invalid Python function signature: " + line); }
    def name = __strip(String.join(Collections.slice(__chars(signature), 0, open), ""));
    def params_text = String.join(Collections.slice(__chars(signature), open + 1, close), "");
    return new[name, __split_params(params_text)];
}

fn __python_parse_block(lines, start_index, indent_level) {
    def stmts = new[];
    def i = start_index;
    while (i < len(lines)) {
        def entry = heap_get(lines, i);
        def indent = heap_get(entry, 0);
        def text = heap_get(entry, 1);
        if (indent < indent_level) { return new[stmts, i]; }
        if (indent > indent_level) { return __raise_runtime_error("Unexpected indentation: " + text); }
        if (text == "else:") { return new[stmts, i]; }
        def handled = false;
        if (__starts_with(text, "if ")) {
            def condition = __strip_suffix(__strip_prefix(text, "if "), ":");
            def then_info = __python_parse_block(lines, i + 1, indent_level + 4);
            def then_body = heap_get(then_info, 0);
            def j = heap_get(then_info, 1);
            def else_body = new[];
            if (j < len(lines)) {
                def next_entry = heap_get(lines, j);
                if (heap_get(next_entry, 0) == indent_level && heap_get(next_entry, 1) == "else:") {
                    def else_info = __python_parse_block(lines, j + 1, indent_level + 4);
                    else_body = heap_get(else_info, 0);
                    j = heap_get(else_info, 1);
                }
            }
            def _unused18 = Collections.push(stmts, IfElse(__parse_expression(condition), then_body, else_body));
            i = j;
            handled = true;
        }
        if (!handled && __starts_with(text, "while ")) {
            def condition = __strip_suffix(__strip_prefix(text, "while "), ":");
            def body_info = __python_parse_block(lines, i + 1, indent_level + 4);
            def body = heap_get(body_info, 0);
            def j = heap_get(body_info, 1);
            def _unused19 = Collections.push(stmts, While(__parse_expression(condition), body));
            i = j;
            handled = true;
        }
        if (!handled) {
            def _unused20 = Collections.push(stmts, __parse_statement(text));
            i = i + 1;
        }
    }
    return new[stmts, i];
}

fn __julia_lines(code) {
    def raw = String.split(code, "\n");
    def lines = new[];
    def i = 0;
    while (i < len(raw)) {
        def line = __strip(heap_get(raw, i));
        if (String.len(line) > 0) { def _unused21 = Collections.push(lines, line); }
        i = i + 1;
    }
    return lines;
}

fn __julia_parse_signature(line) {
    def signature = __strip_prefix(line, "function ");
    def open = __find_char(signature, "(");
    def close = __find_char(signature, ")");
    if (open < 0 || close < 0 || close < open) { return __raise_runtime_error("Invalid Julia function signature: " + line); }
    def name = __strip(String.join(Collections.slice(__chars(signature), 0, open), ""));
    def params_text = String.join(Collections.slice(__chars(signature), open + 1, close), "");
    return new[name, __split_params(params_text)];
}

fn __julia_parse_block(lines, start_index) {
    def stmts = new[];
    def i = start_index;
    while (i < len(lines)) {
        def line = heap_get(lines, i);
        if (line == "end" || line == "else") { return new[stmts, i]; }
        def handled = false;
        if (__starts_with(line, "if ")) {
            def condition = __strip_prefix(line, "if ");
            def then_info = __julia_parse_block(lines, i + 1);
            def then_body = heap_get(then_info, 0);
            def j = heap_get(then_info, 1);
            def else_body = new[];
            if (j < len(lines) && heap_get(lines, j) == "else") {
                def else_info = __julia_parse_block(lines, j + 1);
                else_body = heap_get(else_info, 0);
                j = heap_get(else_info, 1);
            }
            if (j >= len(lines) || heap_get(lines, j) != "end") {
                return __raise_runtime_error("Unterminated Julia if/else block");
            }
            def _unused22 = Collections.push(stmts, IfElse(__parse_expression(condition), then_body, else_body));
            i = j + 1;
            handled = true;
        }
        if (!handled && __starts_with(line, "while ")) {
            def condition = __strip_prefix(line, "while ");
            def body_info = __julia_parse_block(lines, i + 1);
            def body = heap_get(body_info, 0);
            def j = heap_get(body_info, 1);
            if (j >= len(lines) || heap_get(lines, j) != "end") {
                return __raise_runtime_error("Unterminated Julia while block");
            }
            def _unused23 = Collections.push(stmts, While(__parse_expression(condition), body));
            i = j + 1;
            handled = true;
        }
        if (!handled) {
            def _unused24 = Collections.push(stmts, __parse_statement(line));
            i = i + 1;
        }
    }
    return new[stmts, i];
}

fn __tokenize_brace_lines(code) {
    def raw_lines = String.split(code, "\n");
    def tokens = new[];
    def i = 0;
    while (i < len(raw_lines)) {
        def line = __strip(heap_get(raw_lines, i));
        if (String.len(line) > 0) {
            def parts = __split_by_braces(line);
            def j = 0;
            while (j < len(parts)) {
                def part = __strip_trailing_semicolon(heap_get(parts, j));
                if (String.len(part) > 0) { def _unused25 = Collections.push(tokens, part); }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return tokens;
}

fn __block_start_index(lines, index, line, label) {
    def trimmed = __strip(line);
    if (__ends_with(trimmed, "{")) { return index + 1; }
    if (index + 1 < len(lines) && heap_get(lines, index + 1) == "{") { return index + 2; }
    return __raise_runtime_error(label + " must open with '{'");
}

fn __extract_paren_content(line, keyword) {
    def chars = __chars(line);
    def open = -1;
    def close = -1;
    def i = 0;
    def found_open = false;
    while (i < len(chars) && !found_open) {
        if (heap_get(chars, i) == "(") {
            open = i;
            found_open = true;
        } else {
            i = i + 1;
        }
    }
    if (open < 0) { return __raise_runtime_error("Invalid " + keyword + " syntax: " + line); }
    i = len(chars) - 1;
    def found_close = false;
    while (i >= 0 && !found_close) {
        if (heap_get(chars, i) == ")") {
            close = i;
            found_close = true;
        } else {
            i = i - 1;
        }
    }
    if (close < 0 || close <= open) { return __raise_runtime_error("Invalid " + keyword + " syntax: " + line); }
    return String.join(Collections.slice(chars, open + 1, close), "");
}

fn __parse_brace_block(lines, start_index, label) {
    def stmts = new[];
    def i = start_index;
    while (i < len(lines)) {
        def line = heap_get(lines, i);
        if (line == "}") { return new[stmts, i]; }
        if (line == "else") { return new[stmts, i]; }
        def handled = false;
        if (__starts_with(line, "if")) {
            def condition = __extract_paren_content(line, label + " if");
            def body_start = __block_start_index(lines, i, line, label + " if");
            def then_info = __parse_brace_block(lines, body_start, label);
            def then_body = heap_get(then_info, 0);
            def j = heap_get(then_info, 1);
            if (j >= len(lines) || heap_get(lines, j) != "}") { return __raise_runtime_error("Unterminated " + label + " if block"); }
            j = j + 1;
            def else_body = new[];
