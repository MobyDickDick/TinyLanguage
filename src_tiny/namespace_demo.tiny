// Namespaces trennen Funktionen logisch, hier mit Kommentaren zu jeder Zeile.
namespace Tools { // Start des Namespace-Blocks.
    fn double(x) { return x * 2; } // Verdoppelt die Eingabe und gibt sie zurück.
    fn label(x) { return "#" + x; } // Präfixiert einen String mit einem Hash-Zeichen.
}

define value = Tools.double(5); // Ruft die Namespaced-Funktion auf.
print(value); // Gibt das verdoppelte Ergebnis aus.
print(Tools.label("done")); // Zeigt die label-Funktion im Namespace.
