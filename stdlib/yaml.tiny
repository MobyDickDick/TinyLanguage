// TinyLanguage stdlib: yaml module (JSON-compatible YAML subset)

fn _parse_scalar(text) -> any {
  def trimmed = String.trim(text);
  try {
    return JSON.parse(trimmed);
  } catch (_err) {
    return trimmed;
  }
}

fn _stringify_scalar(value) {
  return JSON.stringify(value);
}

fn _parse_collection(text) -> any {
  return YAML.parse_block(text);
}

fn parse(text) -> any {
  def trimmed = String.trim(text);
  if (Collections.len(trimmed) == 0) { return Map.new(); }
  if (String.starts_with(trimmed, "{") || String.starts_with(trimmed, "[")) {
    return JSON.parse(trimmed);
  }
  return _parse_collection(trimmed);
}

fn stringify(value) -> string {
  def keys = Map.keys(value);
  def lines = new[];
  def idx = 0;
  while (idx < Collections.len(keys)) {
    def key = heap_get(keys, idx);
    def entry = key + ": " + _stringify_scalar(Map.get(value, key));
    def _push = Collections.push(lines, entry);
    idx = idx + 1;
  }
  def rendered = String.join(lines, "\n");
  def _cleanup_keys = delete(keys);
  def _cleanup_lines = delete(lines);
  return rendered;
}
fn load(path) {
  def content = File.read(path);
  return parse(content);
}

fn dump(path, value) {
  return File.write(path, stringify(value));
}
