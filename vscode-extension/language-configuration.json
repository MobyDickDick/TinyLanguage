{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": '"', "close": '"', "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["'", "'"],
    ['"', '"']
  ],
  "indentationRules": {
    "increaseIndentPattern": "^(.*(\{[^}\"]*|\b(namespace|class|fn|if|else|while|match|case)\b).*|.*\{\s*)$",
    "decreaseIndentPattern": "^\s*[}\]]"
  }
}
