// TinyLanguage stdlib: yaml module (stub for JSON-compatible YAML)

fn __raise_not_implemented() {
  def _unused = 1 / 0;
  return _unused;
}

fn parse(text) {
  def _unused = text;
  return __raise_not_implemented();
}

fn stringify(value) {
  def _unused = value;
  return __raise_not_implemented();
}

fn load(path) {
  def content = File.read(path);
  return parse(content);
}

fn dump(path, value) {
  return File.write(path, stringify(value));
}
