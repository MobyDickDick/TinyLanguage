// TinyLanguage stdlib: os module (Python-style subset)

fn getenv(key) {
  return OS.getenv(key);
}

fn setenv(key, value) {
  return OS.setenv(key, value);
}

fn unsetenv(key) {
  return OS.unsetenv(key);
}

fn cwd() {
  return OS.cwd();
}

fn chdir(path) {
  return OS.chdir(path);
}

fn listdir(path) {
  return OS.listdir(path);
}

fn platform() {
  return OS.platform();
}

fn path_separator() {
  return OS.path_separator();
}

// Backwards-compatible helpers: os.path + file shims.
namespace path {
  fn _split_path(path) {
    return String.split(path, "/");
  }

  fn _last_non_empty(parts) {
    def idx = Collections.len(parts) - 1;
    while (idx >= 0) {
      def part = heap_get(parts, idx);
      if (Collections.len(part) > 0) { return part; }
      idx = idx - 1;
    }
    return "";
  }

  fn join(left, right) {
    if (Collections.len(left) == 0) { return right; }
    if (String.ends_with(left, "/")) { return left + right; }
    return left + "/" + right;
  }

  fn basename(path) {
    def parts = _split_path(path);
    def value = _last_non_empty(parts);
    def _cleanup_parts = delete(parts);
    return value;
  }

  fn dirname(path) {
    def parts = _split_path(path);
    def idx = Collections.len(parts) - 1;
    while (idx >= 0 && Collections.len(heap_get(parts, idx)) == 0) {
      idx = idx - 1;
    }
    def value = "";
    if (idx > 0) {
      def parent_parts = Collections.slice(parts, 0, idx);
      value = String.join(parent_parts, "/");
      def _cleanup_parent = delete(parent_parts);
    }
    def _cleanup_parts = delete(parts);
    return value;
  }

  fn exists(path) {
    return File.exists(path);
  }
}

fn remove(path) {
  return File.remove(path);
}

fn read_text(path) {
  return File.read(path);
}

fn write_text(path, text) {
  return File.write(path, text);
}
