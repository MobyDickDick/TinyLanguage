// Operator overloading with a tiny vector class, annotated line by line.
class Point { // Represents a 2D point.
    x: number; // X coordinate of the point.
    y: number; // Y coordinate of the point.

    fn to_tuple(self) { // Converts the point into a heap array.
        return new[self.x, self.y]; // Stores x and y in a new array.
    }
}

fn Point(x, y) { // Factory function that builds a point.
    return new Point { x: x; y: y }; // Initializes fields from parameters.
}

operator + (a: Point, b: Point) -> Point { // Overloads + for point addition.
    return Point(a.x + b.x, a.y + b.y); // Adds coordinates pairwise.
}

operator == (left: Point, right: Point) -> Bool { // Overloads == for structural comparison.
    return left.x == right.x && left.y == right.y; // Points are equal when both coordinates match.
}

def p = Point(1, 2); // Create a point at (1, 2).
def q = Point(3, 4); // Create a second point at (3, 4).

def sum = p + q; // Use the overloaded addition to form the sum.
print(heap_get(sum.to_tuple(), 0)); // 4 // Print the x component of the sum point.
print(heap_get(sum.to_tuple(), 1)); // 6 // Print the y component of the sum point.
print(p == sum); // false // Comparing the original point with the sum yields false.
