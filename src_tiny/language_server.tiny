// TinyLanguage port of the lightweight language_server utilities from src/language_server.py.
// Provides hover, completion, and diagnostic helpers for TinyLanguage source.

import tiny_language_lexer;
import tiny_language_linter;
import tiny_language_parser;

def __PY_SORT_ALLOW = new["sorted"];
def __PY_INT_ALLOW = new["int"];
def __PY_LIST_ALLOW = new["list"];

def __KEYWORDS = tiny_language_lexer.KEYWORDS;
def __BUILTINS = tiny_language_lexer.BUILTINS;

fn __starts_with(text, prefix) {
    if (prefix == Null) { return true; }
    if (text == Null) { return false; }
    def text_chars = Python.call("builtins", "list", new[text], new["list"]);
    def prefix_chars = Python.call("builtins", "list", new[prefix], new["list"]);
    if (len(prefix_chars) > len(text_chars)) { return false; }
    def i = 0;
    while (i < len(prefix_chars)) {
        if (heap_get(text_chars, i) != heap_get(prefix_chars, i)) { return false; }
        i = i + 1;
    }
    return true;
}

fn __format_signature(name, params, return_type) {
    def parts = new[];
    def i = 0;
    while (i < len(params)) {
        def param = heap_get(params, i);
        def suffix = "";
        if (param.type_hint != Null && len(param.type_hint) > 0) {
            suffix = ": " + param.type_hint;
        }
        def _unused1 = Collections.push(parts, param.name + suffix);
        i = i + 1;
    }
    def signature = String.join(parts, ", ");
    def return_annotation = "";
    if (return_type != Null && len(return_type) > 0) {
        return_annotation = " -> " + return_type;
    }
    return name + "(" + signature + ")" + return_annotation;
}

fn __line_info(source, pos) {
    def target_pos = pos;
    def lines = String.split(source, "\n");
    if (target_pos == Null) { return new[1, 1, ""]; }
    if (target_pos.__tag__ == "SourceSpan") { target_pos = target_pos.start; }
    if (target_pos.__tag__ == "SourcePos") {
        def line = target_pos.line;
        if (line < 1) { line = 1; }
        if (line > len(lines) && len(lines) > 0) { line = len(lines); }
        def line_text = "";
        if (len(lines) > 0 && line - 1 >= 0 && line - 1 < len(lines)) { line_text = heap_get(lines, line - 1); }
        def col = target_pos.column;
        def max_col = String.len(line_text) + 1;
        if (max_col > 0 && col > max_col) { col = max_col; }
        if (col < 1) { col = 1; }
        return new[line, col, line_text];
    }
    def idx = target_pos;
    if (idx < 0) { idx = 0; }
    if (idx > String.len(source)) { idx = String.len(source); }
    def chars = Python.call("builtins", "list", new[source], __PY_LIST_ALLOW);
    def line = 1;
    def last_nl = -1;
    def i = 0;
    while (i < idx) {
        if (heap_get(chars, i) == "\n") {
            line = line + 1;
            last_nl = i;
        }
        i = i + 1;
    }
    def col = idx - last_nl;
    def line_text = "";
    if (len(lines) > 0 && line - 1 >= 0 && line - 1 < len(lines)) { line_text = heap_get(lines, line - 1); }
    return new[line, col, line_text];
}

fn __record_symbol(server, name, pos, kind, detail) {
    def symbols = Map.get(server, "symbols");
    def kinds = Map.get(server, "symbol_kinds");
    def details = Map.get(server, "symbol_details");
    def _unused2 = Map.set(symbols, name, pos);
    def _k = Map.set(kinds, name, kind);
    if (detail != Null) { def _d = Map.set(details, name, detail); }
    return Null;
}

fn __index_symbols(server, stmts, prefix) {
    def i = 0;
    while (i < len(stmts)) {
        def st = heap_get(stmts, i);
        if (st.__tag__ == "Namespace") {
            def nested = st.name;
            if (len(prefix) > 0) { nested = prefix + "." + st.name; }
            def _unused3 = __index_symbols(server, st.body, nested);
        }

        if (st.__tag__ == "Fn" || st.__tag__ == "MethodDef" || st.__tag__ == "ClassDef" || st.__tag__ == "TypeDef" || st.__tag__ == "Namespace") {
            def qualified = st.name;
            if (len(prefix) > 0) { qualified = prefix + "." + st.name; }
            def kind = "identifier";
            def detail = Null;
            if (st.__tag__ == "Fn") {
                kind = "function";
                detail = "fn " + __format_signature(st.name, st.params, st.return_type);
            } else {
                if (st.__tag__ == "MethodDef") {
                    kind = "method";
                    detail = "method " + __format_signature(st.name, st.params, st.return_type);
                } else {
                    if (st.__tag__ == "ClassDef") { kind = "class"; }
                    if (st.__tag__ == "TypeDef") { kind = "type"; }
                }
            }
            def _unused4 = __record_symbol(server, qualified, st.pos, kind, detail);

            if (st.__tag__ == "ClassDef") {
                def m = 0;
                while (m < len(st.methods)) {
                    def method = heap_get(st.methods, m);
                    def method_name = qualified + "." + method.name;
                    def method_detail = "method " + __format_signature(method.name, method.params, method.return_type);
                    def _unused5 = __record_symbol(server, method_name, method.pos, "method", method_detail);
                    m = m + 1;
                }
            }
        }
        i = i + 1;
    }
    return Null;
}

fn TinyLanguageServer(source) {
    def stmts = tiny_language_parser.parse_program(source);
    def server = Map.new();
    def _unused6 = Map.set(server, "source", source);
    def _s = Map.set(server, "stmts", stmts);
    def _sym = Map.set(server, "symbols", Map.new());
    def _k = Map.set(server, "symbol_kinds", Map.new());
    def _d = Map.set(server, "symbol_details", Map.new());
    def _unused7 = __index_symbols(server, stmts, "");
    return server;
}

fn completions(server, prefix) {
    def candidates = Set.new();
    def kw = Set.to_list(__KEYWORDS);
    def bi = Set.to_list(__BUILTINS);
    def i = 0;
    while (i < len(kw)) { def _unused8 = Set.add(candidates, heap_get(kw, i)); i = i + 1; }
    i = 0;
    while (i < len(bi)) { def _unused9 = Set.add(candidates, heap_get(bi, i)); i = i + 1; }

    def symbols = Map.get(server, "symbols");
    def keys = Map.keys(symbols);
    i = 0;
    while (i < len(keys)) {
        def name = heap_get(keys, i);
        def _unused10 = Set.add(candidates, name);
        if (String.contains(name, ".")) {
            def parts = String.split(name, ".");
            def short = heap_get(parts, len(parts) - 1);
            def _s = Set.add(candidates, short);
        }
        i = i + 1;
    }

    def filtered = new[];
    def all_items = Set.to_list(candidates);
    i = 0;
    while (i < len(all_items)) {
        def item = heap_get(all_items, i);
        if (__starts_with(item, prefix)) { def _unused11 = Collections.push(filtered, item); }
        i = i + 1;
    }

    def sorted_items = Python.call("builtins", "sorted", new[filtered], __PY_SORT_ALLOW);
    def out = new[];
    i = 0;
    while (i < len(sorted_items)) {
        def label = heap_get(sorted_items, i);
        def kind = Map.get(Map.get(server, "symbol_kinds"), label);
        if (kind == Null) { kind = "identifier"; }
        def entry = Map.new();
        def _l = Map.set(entry, "label", label);
        def _k = Map.set(entry, "kind", kind);
        def _unused12 = Collections.push(out, entry);
        i = i + 1;
    }
    return out;
}

fn definition(server, symbol, position) {
    def symbols = Map.get(server, "symbols");
    if (Map.has(symbols, symbol)) { return Map.get(symbols, symbol); }

    def matches = new[];
    def keys = Map.keys(symbols);
    def i = 0;
    while (i < len(keys)) {
        def name = heap_get(keys, i);
        if (name == symbol || (String.contains(name, ".") && heap_get(String.split(name, "."), len(String.split(name, ".")) - 1) == symbol)) {
            def _unused13 = Collections.push(matches, new[name, Map.get(symbols, name)]);
        }
        i = i + 1;
    }
    if (len(matches) == 0) { return Null; }

    def best = heap_get(matches, 0);
    def best_score = new[999999, 999999];
    def idx = 0;
    while (idx < len(matches)) {
        def candidate = heap_get(matches, idx);
        def pos = heap_get(candidate, 1);
        def score = new[pos.line, pos.column];
        if (position != Null) {
            def line_delta = pos.line - heap_get(position, 0);
            if (line_delta < 0) { line_delta = 0 - line_delta; }
            def col_delta = pos.column - heap_get(position, 1);
            if (col_delta < 0) { col_delta = 0 - col_delta; }
            score = new[line_delta, col_delta];
        }
        if (heap_get(score, 0) < heap_get(best_score, 0) || (heap_get(score, 0) == heap_get(best_score, 0) && heap_get(score, 1) < heap_get(best_score, 1))) {
            best = candidate;
            best_score = score;
        }
        idx = idx + 1;
    }
    return heap_get(best, 1);
}

fn hover(server, symbol) {
    def symbols = Map.get(server, "symbols");
    if (!Map.has(symbols, symbol)) { return Null; }
    def pos = Map.get(symbols, symbol);
    def detail = Map.get(Map.get(server, "symbol_details"), symbol);
    if (detail == Null) { detail = "TinyLanguage symbol"; }
    def result = Map.new();
    def _s = Map.set(result, "symbol", symbol);
    def _d = Map.set(result, "detail", detail);
    def _p = Map.set(result, "position", new[pos.line, pos.column]);
    return result;
}

fn __diagnostic_range_from_message(message) {
    def range = new[1, 1, 1, 1];
    if (message == Null) { return range; }
    if (String.contains(message, "line ") && String.contains(message, "col ")) {
        def line_parts = String.split(message, "line ");
        if (len(line_parts) >= 2) {
            def after_line = heap_get(line_parts, 1);
            def line_split = String.split(after_line, ",");
            if (len(line_split) >= 1) {
                def line_text = String.trim(heap_get(line_split, 0));
                def line = Python.call("builtins", "int", new[line_text], __PY_INT_ALLOW);

                def col_parts = String.split(after_line, "col ");
                if (len(col_parts) >= 2) {
                    def col_tail = heap_get(col_parts, 1);
                    def col_split = String.split(col_tail, ")");
                    def col_text = String.trim(heap_get(col_split, 0));
                    def col = Python.call("builtins", "int", new[col_text], __PY_INT_ALLOW);
                    range = new[line, col, line, col + 1];
                }
            }
        }
    }
    return range;
}

fn __diagnostic_range(err, source) {
    if (err != Null) {
        def span = err.span;
        if (span != Null) {
            def start_info = __line_info(source, span.start);
            def stop_info = __line_info(source, span.stop);
            def start_line = heap_get(start_info, 0);
            def start_col = heap_get(start_info, 1);
            def stop_line = heap_get(stop_info, 0);
            def stop_col = heap_get(stop_info, 1);
            def end_col = stop_col + 1;
            if (stop_line == start_line && end_col < start_col + 1) { end_col = start_col + 1; }
            return new[start_line, start_col, stop_line, end_col];
        }
        def pos = err.pos;
        if (pos != Null) {
            def info = __line_info(source, pos);
            def line = heap_get(info, 0);
            def col = heap_get(info, 1);
            return new[line, col, line, col + 1];
        }
        def message = err.message;
        def parsed = __diagnostic_range_from_message(message);
        return new[
            heap_get(parsed, 0),
            heap_get(parsed, 1),
            heap_get(parsed, 2),
            heap_get(parsed, 3)
        ];
    }
    return new[1, 1, 1, 1];
}

fn __extract_code(message) {
    if (message == Null) { return Null; }
    if (!String.contains(message, "[")) { return Null; }
    def split_open = String.split(message, "[");
    if (len(split_open) < 2) { return Null; }
    def tail = heap_get(split_open, 1);
    def split_close = String.split(tail, "]");
    if (len(split_close) < 1) { return Null; }
    def code = heap_get(split_close, 0);
    if (code == Null || len(code) == 0) { return Null; }
    return code;
}

fn diagnostics(server) {
    def diagnostics = new[];
    def stmts = Map.get(server, "stmts");
    def source = Map.get(server, "source");
    try {
        def _unused14 = tiny_language_linter.lint_destruct_call_outputs(stmts, source);
        def _unused15 = tiny_language_linter.lint_no_consecutive_definitions(stmts);
        def _unused16 = tiny_language_linter.lint_no_underscore_bindings(stmts, source);
        def _unused17 = tiny_language_linter.lint_import_style(stmts, source);
        def _unused18 = tiny_language_linter.lint_locals_used(stmts, source);
        def signatures = tiny_language_linter._collect_function_signatures(stmts, "");
        def _unused19 = tiny_language_linter.lint_bare_call_results(stmts, signatures, source);
        def i = 0;
        while (i < len(stmts)) {
            def st = heap_get(stmts, i);
            if (st.__tag__ == "Fn") { def _unused20 = tiny_language_linter.lint_fn_params_used(st, source); }
            if (st.__tag__ == "MethodDef") { def _unused21 = tiny_language_linter.lint_method_params_used(st, source); }
            if (st.__tag__ == "ClassDef") {
                def m = 0;
                while (m < len(st.methods)) {
                    def md = heap_get(st.methods, m);
                    def _unused22 = tiny_language_linter.lint_method_params_used(md, source);
                    m = m + 1;
                }
            }
            i = i + 1;
        }
    } catch(err) {
        def diag = Map.new();
        def message = err.message;
        def code = err.code;
        if (code == Null) { code = __extract_code(message); }
        def _m = Map.set(diag, "message", message);
        def _c = Map.set(diag, "code", code);
        def _r = Map.set(diag, "range", __diagnostic_range(err, source));
        def _unused22 = Collections.push(diagnostics, diag);
    }
    return diagnostics;
}

fn completions_for_source(source, prefix) {
    def server = TinyLanguageServer(source);
    return completions(server, prefix);
}

fn hover_for_source(source, symbol) {
    def server = TinyLanguageServer(source);
    def result = hover(server, symbol);
    if (result == Null) { return Map.new(); }
    return result;
}

fn diagnostics_for_source(source) {
    def server = TinyLanguageServer(source);
    return diagnostics(server);
}

fn definition_for_source(source, symbol, position) {
    def server = TinyLanguageServer(source);
    def result = definition(server, symbol, position);
    if (result == Null) { return Map.new(); }
    def out = Map.new();
    def _s = Map.set(out, "symbol", symbol);
    def _p = Map.set(out, "position", new[result.line, result.column]);
    return out;
}
