// TinyLanguage port of src/language_server_cli.py.
// Invokes the TinyLanguage language server helpers and outputs JSON.

def py_server = Python.import_module(
    "language_server",
    new["completions_for_source", "hover_for_source", "diagnostics_for_source"]
);
def os = Python.import_module("os", new["getenv"]);

fn __argv_from_env(os_module) {
    def raw = os_module.getenv("TINYLANG_ARGS", "");
    def payload = "[]";
    if (raw != Null && len(raw) > 0) { payload = raw; }
    def parsed = JSON.parse(payload);
    return Collections.slice(parsed, 0, len(parsed));
}

fn __parse_args(argv) {
    def args = Map.new();
    def _unused1 = Map.set(args, "source", Null);
    def _f = Map.set(args, "file", Null);
    def _c = Map.set(args, "command", Null);
    def _p = Map.set(args, "prefix", "");
    def _s = Map.set(args, "symbol", Null);

    def i = 0;
    while (i < len(argv)) {
        def arg = heap_get(argv, i);
        if (arg == "--source" && i + 1 < len(argv)) {
            def _set = Map.set(args, "source", heap_get(argv, i + 1));
            i = i + 2;
        } else {
            if (arg == "--file" && i + 1 < len(argv)) {
                def _setf = Map.set(args, "file", heap_get(argv, i + 1));
                i = i + 2;
            } else {
                if (arg == "--prefix" && i + 1 < len(argv)) {
                    def _setp = Map.set(args, "prefix", heap_get(argv, i + 1));
                    i = i + 2;
                } else {
                    if (arg == "--symbol" && i + 1 < len(argv)) {
                        def _sets = Map.set(args, "symbol", heap_get(argv, i + 1));
                        i = i + 2;
                    } else {
                        if (arg == "completions" || arg == "hover" || arg == "diagnostics") {
                            def _setc = Map.set(args, "command", arg);
                            i = i + 1;
                        } else {
                            i = i + 1;
                        }
                    }
                }
            }
        }
    }
    return args;
}

fn __load_source(args) {
    def source = Map.get(args, "source");
    if (source != Null) { return source; }
    def file_path = Map.get(args, "file");
    if (file_path != Null) { return File.read(file_path); }
    return Null;
}

fn run() {
    def argv = __argv_from_env(os);
    def args = __parse_args(argv);
    def source = __load_source(args);
    if (source == Null) {
        print("Provide --source or --file to supply TinyLanguage code");
        return 1;
    }

    def command = Map.get(args, "command");
    if (command == Null) {
        print("Provide a command: completions, hover, or diagnostics");
        return 1;
    }

    if (command == "completions") {
        def completions = py_server.completions_for_source(source, Map.get(args, "prefix"));
        print(JSON.stringify(completions));
        return 0;
    }
    if (command == "hover") {
        def symbol = Map.get(args, "symbol");
        if (symbol == Null) { print("Provide --symbol for hover"); return 1; }
        def hover = py_server.hover_for_source(source, symbol);
        print(JSON.stringify(hover));
        return 0;
    }
    def diagnostics = py_server.diagnostics_for_source(source);
    print(JSON.stringify(diagnostics));
    return 0;
}

def _unused8 = run();
