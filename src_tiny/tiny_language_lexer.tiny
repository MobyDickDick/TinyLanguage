// TinyLanguage-Port des Lexers aus src/tiny_language_lexer.py.
// Contains the token structure, keyword/builtin sets, and the full tokenization.

// Position + Spans ------------------------------------------------------------
class SourcePos {
    line: number;
    column: number;

    fn col(self) { return self.column; }
}

fn SourcePos(line, column) {
    return new SourcePos { line: line; column: column };
}

fn SourcePos_origin() {
    return SourcePos(1, 1);
}

class SourceSpan {
    start: SourcePos;
    stop: SourcePos;
}

fn SourceSpan(start, stop) {
    return new SourceSpan { start: start; stop: stop };
}

// Error formatting via Python interop so we can raise RuntimeErrors like the Python port.
def __PY_EXEC_ALLOW = new["exec"];
def __PY_REPR_ALLOW = new["repr"];

fn __raise_runtime_error(msg) {
    def safe = Python.call("builtins", "repr", new[msg], __PY_REPR_ALLOW);
    def stmt = "raise RuntimeError(" + safe + ")";
    // Return value is irrelevant — the call raises an exception.
    return Python.call("builtins", "exec", new[stmt], __PY_EXEC_ALLOW);
}

// Tokens ----------------------------------------------------------------------
class Token {
    kind: string;
    text: string;
    start: SourcePos;
    stop: SourcePos;

    fn pos(self) {
        return self.start;
    }
}

fn Token(kind, text, start, stop) {
    return new Token { kind: kind; text: text; start: start; stop: stop };
}

def KEYWORDS = Set.from_list(new[
    "def", "print", "if", "else", "while", "switch", "default", "fn", "import", "return",
    "operator", "new", "type", "class", "namespace", "as", "spawn", "task",
    "async", "await", "true", "false", "flush", "and", "or", "not",
    "Null", "try", "catch", "match", "case"
]);

def BUILTINS = Set.from_list(new["Collections", "Math", "String", "len", "print"]);

// Lexer -----------------------------------------------------------------------
def __PY_LIST_ALLOW = new["list"];

fn __is_alpha(c) {
    return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z");
}

fn __is_digit(c) {
    return c >= "0" && c <= "9";
}

fn __is_alnum_or_underscore(c) {
    if (__is_alpha(c)) { return true; }
    if (__is_digit(c)) { return true; }
    return c == "_";
}

fn __peek(chars, n, idx) {
    if (idx < n) { return heap_get(chars, idx); }
    return "";
}

fn __peek_at(chars, n, idx, offset) {
    def target = idx + offset;
    if (target < n) { return heap_get(chars, target); }
    return "";
}

fn __advance_state(chars, i, n, line, col, count) {
    def steps = count;
    if (steps == Null) { steps = 1; }
    def idx = i;
    def l = line;
    def c = col;
    while (steps > 0) {
        if (idx < n && heap_get(chars, idx) == "\n") {
            l = l + 1;
            c = 1;
        } else {
            c = c + 1;
        }
        idx = idx + 1;
        steps = steps - 1;
    }
    return new[idx, l, c];
}

fn __slice_text(chars, start_idx, end_idx) {
    def segment = Collections.slice(chars, start_idx, end_idx);
    return String.join(segment, "");
}

fn __read_string(chars, n, i, line, col) {
    def start_line = line;
    def start_col = col;
    def pos0 = SourcePos(start_line, start_col);
    def buf = "";

    def adv_open = __advance_state(chars, i, n, line, col, 1);
    i = heap_get(adv_open, 0);
    line = heap_get(adv_open, 1);
    col = heap_get(adv_open, 2);

    def done = false;
    while (i < n && done == false) {
        def c = __peek(chars, n, i);
        if (c == "\"") {
            def adv_end = __advance_state(chars, i, n, line, col, 1);
            i = heap_get(adv_end, 0);
            line = heap_get(adv_end, 1);
            col = heap_get(adv_end, 2);
            def stop = SourcePos(start_line, col - 1);
            def tok = Token("STRING", buf, pos0, stop);
            return new[tok, i, line, col];
        }

        if (c == "\\") {
            def adv_slash = __advance_state(chars, i, n, line, col, 1);
            i = heap_get(adv_slash, 0);
            line = heap_get(adv_slash, 1);
            col = heap_get(adv_slash, 2);

            if (i >= n) { __raise_runtime_error("unterminated escape in string"); }

            def esc = __peek(chars, n, i);
            def adv_esc = __advance_state(chars, i, n, line, col, 1);
            i = heap_get(adv_esc, 0);
            line = heap_get(adv_esc, 1);
            col = heap_get(adv_esc, 2);

            if (esc == "n") {
                buf = buf + "\n";
            } else {
                if (esc == "t") {
                    buf = buf + "\t";
                } else {
                    if (esc == "r") {
                        buf = buf + "\r";
                    } else {
                        if (esc == "\"") {
                            buf = buf + "\"";
                        } else {
                            if (esc == "\\") {
                                buf = buf + "\\";
                            } else {
                                buf = buf + "\\" + esc;
                            }
                        }
                    }
                }
            }
        } else {
            buf = buf + c;
            def adv_char = __advance_state(chars, i, n, line, col, 1);
            i = heap_get(adv_char, 0);
            line = heap_get(adv_char, 1);
            col = heap_get(adv_char, 2);
        }
    }

    __raise_runtime_error("unterminated string literal");
    def fallback = Token("STRING", buf, pos0, pos0);
    return new[fallback, i, line, col];
}

fn lex(source) {
    def tokens = new[];
    def chars = Python.call("builtins", "list", new[source], __PY_LIST_ALLOW);
    def n = len(chars);
    def i = 0;
    def line = 1;
    def col = 1;
    def finished = false;

    while (finished == false) {
        // Skip whitespace and comments.
        def skipping = true;
        while (i < n && skipping) {
            def c = __peek(chars, n, i);
            if (c == " " || c == "\t" || c == "\r" || c == "\n") {
                def adv_ws = __advance_state(chars, i, n, line, col, 1);
                i = heap_get(adv_ws, 0);
                line = heap_get(adv_ws, 1);
                col = heap_get(adv_ws, 2);
            } else {
                if (c == "/" && __peek_at(chars, n, i, 1) == "/") {
                    def adv_comment = __advance_state(chars, i, n, line, col, 2);
                    i = heap_get(adv_comment, 0);
                    line = heap_get(adv_comment, 1);
                    col = heap_get(adv_comment, 2);
                    while (i < n && __peek(chars, n, i) != "\n") {
                        def adv_comment_body = __advance_state(chars, i, n, line, col, 1);
                        i = heap_get(adv_comment_body, 0);
                        line = heap_get(adv_comment_body, 1);
                        col = heap_get(adv_comment_body, 2);
                    }
                } else {
                    skipping = false;
                }
            }
        }

        if (i >= n) {
            def pos = SourcePos(line, col);
            def _push_eof = Collections.push(tokens, Token("EOF", "", pos, pos));
            finished = true;
        } else {
            def c = __peek(chars, n, i);
            def start_line = line;
            def start_col = col;
            def pos = SourcePos(start_line, start_col);
            def handled = false;

            if (c == "&" && __peek_at(chars, n, i, 1) == "&") {
                def adv_and = __advance_state(chars, i, n, line, col, 2);
                i = heap_get(adv_and, 0);
                line = heap_get(adv_and, 1);
                col = heap_get(adv_and, 2);
                def stop = SourcePos(start_line, start_col + 1);
                def _push_and = Collections.push(tokens, Token("OP", "&&", pos, stop));
                handled = true;
            } else {
                if (c == "|" && __peek_at(chars, n, i, 1) == "|") {
                    def adv_or = __advance_state(chars, i, n, line, col, 2);
                    i = heap_get(adv_or, 0);
                    line = heap_get(adv_or, 1);
                    col = heap_get(adv_or, 2);
                    def stop_or = SourcePos(start_line, start_col + 1);
                    def _push_or = Collections.push(tokens, Token("OP", "||", pos, stop_or));
                    handled = true;
                } else {
                    if (c == "\"") {
                        def res = __read_string(chars, n, i, line, col);
                        def tok = heap_get(res, 0);
                        i = heap_get(res, 1);
                        line = heap_get(res, 2);
                        col = heap_get(res, 3);
                        def _push_str = Collections.push(tokens, tok);
                        handled = true;
                    } else {
                        if (__is_alpha(c) || c == "_") {
                            def j = i + 1;
                            def keep = true;
                            while (j < n && keep) {
                                def cj = heap_get(chars, j);
                                if (__is_alnum_or_underscore(cj)) {
                                    j = j + 1;
                                } else {
                                    keep = false;
                                }
                            }
                            def txt = __slice_text(chars, i, j);
                            def consumed = j - i;
                            i = j;
                            col = col + consumed;
                            def kind = "NAME";
                            if (Set.has(KEYWORDS, txt)) { kind = "KW"; }
                            // BUILTINS werden aktuell nicht gesondert getaggt, aber die Abfrage
                            // Keeps the definition active (and enables future highlighting).
                            if (Set.has(BUILTINS, txt)) { kind = kind; }
                            def stop_name = SourcePos(start_line, start_col + consumed - 1);
                            def _push_name = Collections.push(tokens, Token(kind, txt, pos, stop_name));
                            handled = true;
                        } else {
                            if (__is_digit(c)) {
                                def jnum = i + 1;
                                def hasdot = false;
                                def keep_num = true;
                                while (jnum < n && keep_num) {
                                    def cjnum = heap_get(chars, jnum);
                                    if (cjnum == "." && hasdot == false) {
                                        hasdot = true;
                                        jnum = jnum + 1;
                                    } else {
                                        if (__is_digit(cjnum)) {
                                            jnum = jnum + 1;
                                        } else {
                                            keep_num = false;
                                        }
                                    }
                                }
                                def txtnum = __slice_text(chars, i, jnum);
                                def consumed_num = jnum - i;
                                i = jnum;
                                col = col + consumed_num;
                                def stop_num = SourcePos(start_line, start_col + consumed_num - 1);
                                def _push_num = Collections.push(tokens, Token("NUMBER", txtnum, pos, stop_num));
                                handled = true;
                            } else {
                                if (c == ">" || c == "<" || c == "=" || c == "!") {
                                    if (__peek_at(chars, n, i, 1) == "=") {
                                        def adv_cmp = __advance_state(chars, i, n, line, col, 2);
                                        i = heap_get(adv_cmp, 0);
                                        line = heap_get(adv_cmp, 1);
                                        col = heap_get(adv_cmp, 2);
                                        def stop_cmp = SourcePos(start_line, start_col + 1);
                                        def _push_cmp = Collections.push(tokens, Token("OP", c + "=", pos, stop_cmp));
                                        handled = true;
                                    }
                                }
                                if (handled == false && (c == "+" || c == "-" || c == "*" || c == "/" || c == ">" || c == "<" || c == "^" || c == "!" || c == "%")) {
                                    def adv_op = __advance_state(chars, i, n, line, col, 1);
                                    i = heap_get(adv_op, 0);
                                    line = heap_get(adv_op, 1);
                                    col = heap_get(adv_op, 2);
                                    def _push_op = Collections.push(tokens, Token("OP", c, pos, SourcePos(start_line, start_col)));
                                    handled = true;
                                } else {
                                    if (handled == false && (c == "(" || c == ")" || c == "{" || c == "}" || c == "[" || c == "]"
                                        || c == ";" || c == "," || c == "=" || c == ":" || c == "." || c == "?")) {
                                        def adv_sym = __advance_state(chars, i, n, line, col, 1);
                                        i = heap_get(adv_sym, 0);
                                        line = heap_get(adv_sym, 1);
                                        col = heap_get(adv_sym, 2);
                                        def _push_sym = Collections.push(tokens, Token("SYM", c, pos, SourcePos(start_line, start_col)));
                                        handled = true;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if (handled == false) {
                __raise_runtime_error("lexing error: unexpected character '" + c + "'");
                finished = true;
            }
        }
    }
    return tokens;
}
