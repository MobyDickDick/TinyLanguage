// Python interop demo: binding functions via Python.fn
// Run with: python src/tiny_language.py src_tiny/python_fn_demo.tiny

def _sqrt = Python.fn("math", "sqrt", { allow: new["sqrt"] });
def _ceil = Python.fn("math", "ceil", { allow: new["ceil"] });

print("sqrt via Python.fn:");
print(sqrt(81));
print("ceil via Python.fn:");
print(ceil(4.2));
