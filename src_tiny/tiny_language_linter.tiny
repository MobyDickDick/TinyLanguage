    }

    define ordered = __sorted_imports(imports);
    if (len(imports) > 0) {
        define mismatch = false;
        define idx = 0;
        while (idx < len(imports)) {
            define imp = heap_get(imports, idx);
            define ord = heap_get(ordered, idx);
            define alias_imp = Null;
            define alias_ord = Null;
            if (imp.alias != Null) { alias_imp = imp.alias; }
            if (ord.alias != Null) { alias_ord = ord.alias; }
            if (!(imp.module == ord.module && alias_imp == alias_ord)) {
