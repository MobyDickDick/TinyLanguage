// TinyLanguage-Port von src/tiny_language_ast.py
// Enthält die zentralen AST-Knoten als einfache Klassen mit Konstruktorfunktionen.

class SourcePos {
    line: number;
    column: number;
    fn col(self) { return self.column; }
}
fn SourcePos(line, column) { return new SourcePos { line: line; column: column }; }
fn SourcePos_origin() { return SourcePos(1, 1); }

class SourceSpan {
    start: SourcePos;
    stop: SourcePos;
}
fn SourceSpan(start, stop) { return new SourceSpan { start: start; stop: stop }; }

fn _pos_or_default(pos) {
    if (pos == Null) { return SourcePos_origin(); }
    return pos;
}

fn _span_or_default(span, pos) {
    if (span == Null) { return SourceSpan(_pos_or_default(pos), _pos_or_default(pos)); }
    return span;
}

class IR { pos: SourcePos; span: SourceSpan; }

class Let {
    name: string;
    expr: IR;
    pos: SourcePos;
    span: SourceSpan;
    name_span: SourceSpan;
}
fn Let(name, expr, pos, span, name_span) {
    return new Let {
        name: name;
        expr: expr;
        pos: _pos_or_default(pos);
        span: _span_or_default(span, pos);
        name_span: name_span
    };
}

class Assign {
    name: string;
    expr: IR;
    pos: SourcePos;
    span: SourceSpan;
    name_span: SourceSpan;
}
fn Assign(name, expr, pos, span, name_span) {
    return new Assign {
        name: name;
        expr: expr;
        pos: _pos_or_default(pos);
        span: _span_or_default(span, pos);
        name_span: name_span
    };
}

class FieldAssign {
    obj: IR;
    name: string;
    expr: IR;
    pos: SourcePos;
    span: SourceSpan;
}
fn FieldAssign(obj, name, expr, pos, span) {
    return new FieldAssign {
        obj: obj;
        name: name;
        expr: expr;
        pos: _pos_or_default(pos);
        span: _span_or_default(span, pos)
    };
}

class Print { exprs: Pointer; pos: SourcePos; span: SourceSpan; }
fn Print(exprs, pos, span) { return new Print { exprs: exprs; pos: _pos_or_default(pos); span: _span_or_default(span, pos) }; }

