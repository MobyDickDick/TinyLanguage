// TinyLanguage-Port von src/native_ir.py
// Lightweight intermediate representation for the native backend.

class Instruction {
    op: string;
    arg: any;
}

fn Instruction(op, arg) {
    return new Instruction { op: op; arg: arg };
}

class FunctionIR {
    name: string;
    params: Pointer;
    instructions: Pointer;
}

fn FunctionIR(name, params, instructions) {
    return new FunctionIR { name: name; params: params; instructions: instructions };
}

class ProgramIR {
    entry: Pointer;
    functions: any;
}

fn ProgramIR(entry, functions) {
    return new ProgramIR { entry: entry; functions: functions };
}

def OPCODE_PUSH_CONST = "PUSH_CONST";
def OPCODE_LOAD = "LOAD";
def OPCODE_STORE = "STORE";
def OPCODE_BINARY = "BINARY";
def OPCODE_PRINT = "PRINT";
def OPCODE_FLUSH = "FLUSH";
def OPCODE_JUMP = "JUMP";
def OPCODE_JUMP_IF_FALSE = "JUMP_IF_FALSE";
def OPCODE_CALL = "CALL";
def OPCODE_POP = "POP";
def OPCODE_RETURN = "RETURN";

// Python interop helpers for formatting

def PY_STR_ALLOW = new["str"];

def PY_REPR_ALLOW = new["repr"];

def PY_EXEC_ALLOW = new["exec"];

fn __to_str(value) {
    return Python.call("builtins", "str", new[value], PY_STR_ALLOW);
}

fn __to_repr(value) {
    return Python.call("builtins", "repr", new[value], PY_REPR_ALLOW);
}

fn __raise_runtime_error(msg) {
    def safe = Python.call("builtins", "repr", new[msg], PY_REPR_ALLOW);
    def stmt = "raise RuntimeError(" + safe + ")";
    return Python.call("builtins", "exec", new[stmt], PY_EXEC_ALLOW);
}

fn format_program(program) {
    if (program == Null) { return ""; }

    fn _fmt_index(idx) {
        if (idx < 10) { return "0" + __to_str(idx); }
        return __to_str(idx);
    }

    fn _fmt_block(label, instrs) {
        def lines = new[];
        def idx = 0;
        while (idx < len(instrs)) {
            def instr = heap_get(instrs, idx);
            def suffix = "";
            if (instr.arg != Null) {
                if (instr.op == OPCODE_CALL) {
                    def name = heap_get(instr.arg, 0);
                    def argc = heap_get(instr.arg, 1);
                    suffix = " (" + __to_repr(name) + ", " + __to_str(argc) + ")";
                } else {
                    suffix = " " + __to_str(instr.arg);
                }
            }
            def line = label + "[" + _fmt_index(idx) + "]: " + instr.op + suffix;
            def unused1 = Collections.push(lines, line);
            idx = idx + 1;
        }
        return lines;
    }

    def lines = _fmt_block("entry", program.entry);
    def keys = Map.keys(program.functions);
    def i = 0;
    while (i < len(keys)) {
        def name = heap_get(keys, i);
        def func = Map.get(program.functions, name);
        if (func == Null) {
            def unused2 = __raise_runtime_error("missing function " + __to_str(name));
        }
        def header = "function " + func.name + "(" + String.join(func.params, ", ") + ")";
        Collections.push(lines, header);
        def block = _fmt_block("  " + func.name, func.instructions);
        def j = 0;
        while (j < len(block)) {
            def unused3 = Collections.push(lines, heap_get(block, j));
            j = j + 1;
        }
        i = i + 1;
    }
    return String.join(lines, "\n");
}
