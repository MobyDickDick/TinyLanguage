// TinyLanguage wrapper for vscode-extension/python/vscode_helpers.py.
// Loads the helper module from disk for VS Code tooling parity.

def importlib = Python.import_module("importlib.util", new["spec_from_file_location", "module_from_spec"]);
def os = Python.import_module("os", new["getcwd", "getenv"]);
def os_path = Python.import_module("os.path", new["join", "exists"]);
def builtins = Python.import_module("builtins", new["exit"]);

fn __argv_from_env() {
    def raw = os.getenv("TINYLANG_ARGS", "");
    def payload = "[]";
    if (raw != Null && len(raw) > 0) { payload = raw; }
    return JSON.parse(payload);
}

fn __module_path(rel_path) {
    return os_path.join(os.getcwd(), rel_path);
}

fn __load_module(name, rel_path) {
    def path = __module_path(rel_path);
    if (!os_path.exists(path)) {
        print("Missing Python helper at", path);
        return Null;
    }
    def spec = importlib.spec_from_file_location(name, path);
    if (spec == Null) { return Null; }
    def module = importlib.module_from_spec(spec);
    def loader = spec.loader;
    if (loader == Null) { return Null; }
    loader.exec_module(module);
    return module;
}

fn run() {
    def module = __load_module("vscode_helpers", "vscode-extension/python/vscode_helpers.py");
    if (module == Null) { return 1; }
    def code = module.main(__argv_from_env());
    return code;
}

def code = run();
if (code == Null) { builtins.exit(0); }
else { builtins.exit(code); }
