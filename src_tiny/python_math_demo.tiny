// Python interop demo: math helpers
// Run with: python src/tiny_language.py src_tiny/python_math_demo.tiny

// Allowlist only the math attributes we need.
def math = Python.import_module("math", new["sqrt", "isfinite", "tau"]);

// Prepare a small heap array to feed Python.
def numbers = new[81, 144];

def root_a = math.sqrt(heap_get(numbers, 0));
def root_b = math.sqrt(heap_get(numbers, 1));

print("Square roots via Python math:");
print(root_a);
print(root_b);
print("tau constant from Python:");
print(math.tau);
print("isfinite(second root):");
print(math.isfinite(root_b));
