            b = b + 1;
        }
        a = a + 1;
    }
    return arr;
}

fn lint_import_style(stmts, source) {
    define imports = new[];
    define i = 0;
    define collecting = true;
    while (i < len(stmts) && collecting) {
        define st = heap_get(stmts, i);
        if (st.__tag__ == "Import") {
            define _ = Collections.push(imports, st);
            i = i + 1;
        } else {
            collecting = false;
