// TinyLanguage wrapper for src/tinyc_cli.py.
// Delegates TinyLanguage compiler CLI execution to Python.

def tinyc_cli = Python.import_module("tinyc_cli", new["run"]);
def os = Python.import_module("os", new["getenv"]);

def __PY_JSON_ALLOW = new["loads"];
def json = Python.import_module("json", __PY_JSON_ALLOW);

fn __argv_from_env() {
    def raw = os.getenv("TINYLANG_ARGS", "");
    def payload = "[]";
    if (raw != Null && len(raw) > 0) { payload = raw; }
    return json.loads(payload);
}

fn run(argv) {
    return tinyc_cli.run(argv);
}

fn main() {
    def code = tinyc_cli.run(__argv_from_env());
    return code;
}

def _ = main();
