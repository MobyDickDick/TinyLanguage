// TinyLanguage-Port von src/tiny_language_codegen_native.py
// Native Code Generator for a small stack-based bytecode.

// Opcode + IR definitions are expected from native_ir.tiny

def __PY_EXEC_ALLOW = new["exec"];
def __PY_REPR_ALLOW = new["repr"];
def __PY_FLOAT_ALLOW = new["float"];
def __PY_INT_ALLOW = new["int"];
def __PY_STR_ALLOW = new["str"];

fn __to_str(value) {
    return Python.call("builtins", "str", new[value], __PY_STR_ALLOW);
}

fn __raise_not_implemented(msg) {
    def safe = Python.call("builtins", "repr", new[msg], __PY_REPR_ALLOW);
    def stmt = "raise NotImplementedError(" + safe + ")";
    return Python.call("builtins", "exec", new[stmt], __PY_EXEC_ALLOW);
}

fn __parse_number(txt) {
    if (String.contains(txt, ".")) {
        return Python.call("builtins", "float", new[txt], __PY_FLOAT_ALLOW);
    }
    return Python.call("builtins", "int", new[txt], __PY_INT_ALLOW);
}

fn __tag_of(value) {
    if (value == Null) { return ""; }
    return Map.get(value, "__tag__", "");
}

fn __extend(target, items) {
    def i = 0;
    while (i < len(items)) {
        def _unused1 = Collections.push(target, heap_get(items, i));
        i = i + 1;
    }
    return target;
}

class NativeCodeGenerator {
    allow_heap: bool;
    tmp_index: number;

    fn compile_program(self, stmts) {
        def functions = Map.new();
        def entry = new[];

        def i = 0;
        while (i < len(stmts)) {
            def stmt = heap_get(stmts, i);
            if (stmt.__tag__ == "Fn") {
                def fn_ir = self._compile_function(stmt);
                def _unused2 = Map.set(functions, stmt.name, fn_ir);
            } else {
                def raw = self._compile_stmt(stmt);
                def shifted = self._shift_labels(raw, len(entry));
                def _ = __extend(entry, shifted);
            }
            i = i + 1;
        }

        def _unused4 = Collections.push(entry, Instruction(OPCODE_RETURN, Null));
        return ProgramIR(entry, functions);
    }

    fn _compile_function(self, fn_node) {
        def body = new[];
        def i = 0;
        while (i < len(fn_node.body)) {
            def stmt = heap_get(fn_node.body, i);
            def raw = self._compile_stmt(stmt);
            def shifted = self._shift_labels(raw, len(body));
            def _ = __extend(body, shifted);
            i = i + 1;
        }
        def _unused6 = Collections.push(body, Instruction(OPCODE_RETURN, Null));

        def params = new[];
        def j = 0;
        while (j < len(fn_node.params)) {
            def param = heap_get(fn_node.params, j);
            def _unused7 = Collections.push(params, param.name);
            j = j + 1;
        }
        return FunctionIR(fn_node.name, params, body);
    }

    fn _shift_labels(self, instructions, offset) {
        def shifted = new[];
        def i = 0;
        while (i < len(instructions)) {
            def instr = heap_get(instructions, i);
            if ((instr.op == OPCODE_JUMP || instr.op == OPCODE_JUMP_IF_FALSE) && instr.arg != Null) {
                def _unused8 = Collections.push(shifted, Instruction(instr.op, instr.arg + offset));
            } else {
                def _unused9 = Collections.push(shifted, instr);
            }
            i = i + 1;
        }
        return shifted;
    }

    fn _compile_stmt(self, stmt) {
        def result = new[];
        def handled = false;
        def tag = __tag_of(stmt);
        if (tag == "Let") {
            result = self._compile_binding(stmt.name, stmt.expr);
            handled = true;
        } else {
            if (tag == "Assign") {
                result = self._compile_binding(stmt.name, stmt.expr);
                handled = true;
            } else {
                if (tag == "Print") {
                    def instructions = new[];
                    def i = 0;
                    while (i < len(stmt.exprs)) {
                        def expr = heap_get(stmt.exprs, i);
                        def part = self._compile_expr(expr);
                        def _ = __extend(instructions, part);
                        i = i + 1;
                    }
                    def _unused11 = Collections.push(instructions, Instruction(OPCODE_PRINT, len(stmt.exprs)));
                    result = instructions;
                    handled = true;
                } else {
                    if (tag == "Flush") {
                        def instructions = new[];
                        def _unused12 = Collections.push(instructions, Instruction(OPCODE_FLUSH, Null));
                        result = instructions;
                        handled = true;
                    } else {
                        if (tag == "If") {
                            result = self._compile_if(stmt);
                            handled = true;
                        } else {
                            if (tag == "While") {
                                result = self._compile_while(stmt);
                                handled = true;
                            } else {
                                if (tag == "Return") {
                                    def instructions = self._compile_expr(stmt.expr);
                                    def _unused13 = Collections.push(instructions, Instruction(OPCODE_RETURN, Null));
                                    result = instructions;
                                    handled = true;
                                } else {
                                    if (tag == "CallStmt") {
                                        def instructions = self._compile_expr(Call(stmt.name, stmt.args, stmt.pos, stmt.span));
                                        def _unused14 = Collections.push(instructions, Instruction(OPCODE_POP, Null));
                                        result = instructions;
                                        handled = true;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if (!handled) {
            def __unsupported = __raise_not_implemented("native codegen does not yet support " + __to_str(tag));
        }
        return result;
    }

    fn _compile_if(self, stmt) {
        def instructions = self._compile_expr(stmt.cond);
        def jump_false_index = len(instructions);
        def _unused15 = Collections.push(instructions, Instruction(OPCODE_JUMP_IF_FALSE, Null));

        def then_block = new[];
        def i = 0;
        while (i < len(stmt.then)) {
            def inner = heap_get(stmt.then, i);
            def nested = self._compile_stmt(inner);
            def shifted = self._shift_labels(nested, len(instructions) + len(then_block));
            def _ = __extend(then_block, shifted);
            i = i + 1;
        }
        def _unused17 = Collections.push(then_block, Instruction(OPCODE_JUMP, Null));

        def else_block = new[];
        def j = 0;
        while (j < len(stmt.els)) {
            def inner = heap_get(stmt.els, j);
            def nested = self._compile_stmt(inner);
            def shifted = self._shift_labels(nested, len(instructions) + len(then_block) + len(else_block));
            def _ = __extend(else_block, shifted);
            j = j + 1;
        }

        def else_start = len(instructions) + len(then_block);
        def jump_status = heap_set(instructions, jump_false_index, Instruction(OPCODE_JUMP_IF_FALSE, else_start));
        if (jump_status.e.code != 0) { def _ = __raise_runtime_error(jump_status.e.msg); }

        def end_of_then = len(instructions) + len(then_block) + len(else_block);
        def end_status = heap_set(then_block, len(then_block) - 1, Instruction(OPCODE_JUMP, end_of_then));
        if (end_status.e.code != 0) { def _ = __raise_runtime_error(end_status.e.msg); }

        def _ = __extend(instructions, then_block);
        def _ = __extend(instructions, else_block);
        return instructions;
    }

    fn _compile_while(self, stmt) {
        def instructions = new[];
        def loop_start = 0;
        def cond_instrs = self._compile_expr(stmt.cond);
        def _ = __extend(instructions, cond_instrs);
        def jump_out_index = len(instructions);
        def _j = Collections.push(instructions, Instruction(OPCODE_JUMP_IF_FALSE, Null));

        def body_instrs = new[];
        def i = 0;
        while (i < len(stmt.body)) {
            def inner = heap_get(stmt.body, i);
            def nested = self._compile_stmt(inner);
            def shifted = self._shift_labels(nested, len(instructions) + len(body_instrs));
            def _ = __extend(body_instrs, shifted);
            i = i + 1;
        }
        def _unused24 = Collections.push(body_instrs, Instruction(OPCODE_JUMP, loop_start));

        def loop_exit = len(instructions) + len(body_instrs);
        def loop_status = heap_set(instructions, jump_out_index, Instruction(OPCODE_JUMP_IF_FALSE, loop_exit));
        if (loop_status.e.code != 0) { def _ = __raise_runtime_error(loop_status.e.msg); }

        def _ = __extend(instructions, body_instrs);
        return instructions;
    }

    fn _compile_binding(self, name, expr) {
        def instructions = self._compile_expr(expr);
        def _unused26 = Collections.push(instructions, Instruction(OPCODE_STORE, name));
        return instructions;
    }

    fn _compile_expr(self, expr) {
        def result = new[];
        def handled = false;
        def tag = __tag_of(expr);
        if (tag == "Num") {
            result = new[Instruction(OPCODE_PUSH_CONST, __parse_number(expr.txt))];
            handled = true;
        } else {
            if (tag == "Str") {
                result = new[Instruction(OPCODE_PUSH_CONST, expr.txt)];
                handled = true;
            } else {
                if (tag == "Bool") {
                    result = new[Instruction(OPCODE_PUSH_CONST, expr.value)];
                    handled = true;
                } else {
                    if (tag == "NullLit") {
                        result = new[Instruction(OPCODE_PUSH_CONST, Null)];
                        handled = true;
                    } else {
                        if (tag == "New") {
                            if (!self.allow_heap) {
                                def __unsupported = __raise_not_implemented("native codegen does not yet support heap allocations");
                            }
                            def instructions = self._compile_expr(expr.size);
                            def _unused27 = Collections.push(instructions, Instruction(OPCODE_CALL, new["__new", 1]));
                            result = instructions;
                            handled = true;
                        } else {
                            if (tag == "NewLit") {
                                if (!self.allow_heap) {
                                    def __unsupported = __raise_not_implemented("native codegen does not yet support heap allocations");
                                }
                                def temp_name = self._next_tmp();
                                def instructions = new[
                                    Instruction(OPCODE_PUSH_CONST, len(expr.items)),
                                    Instruction(OPCODE_CALL, new["__new", 1]),
                                    Instruction(OPCODE_STORE, temp_name)
                                ];
                                def i = 0;
                                while (i < len(expr.items)) {
                                    def item = heap_get(expr.items, i);
                                    def _l = Collections.push(instructions, Instruction(OPCODE_LOAD, temp_name));
                                    def _p = Collections.push(instructions, Instruction(OPCODE_PUSH_CONST, i));
                                    def part = self._compile_expr(item);
                                    def _ = __extend(instructions, part);
                                    def _c = Collections.push(instructions, Instruction(OPCODE_CALL, new["heap_set", 3]));
                                    def _d = Collections.push(instructions, Instruction(OPCODE_POP, Null));
                                    i = i + 1;
                                }
                                def _r = Collections.push(instructions, Instruction(OPCODE_LOAD, temp_name));
                                result = instructions;
                                handled = true;
                            } else {
                                if (tag == "Var") {
                                    result = new[Instruction(OPCODE_LOAD, expr.name)];
                                    handled = true;
                                } else {
                                    if (tag == "Bin") {
                                        def instructions = self._compile_expr(expr.a);
                                        def rhs = self._compile_expr(expr.b);
                                        def _ = __extend(instructions, rhs);
                                        def _b = Collections.push(instructions, Instruction(OPCODE_BINARY, expr.op));
                                        result = instructions;
                                        handled = true;
                                    } else {
                                        if (tag == "Call") {
                                            def instructions = new[];
                                            def i = 0;
                                            while (i < len(expr.args)) {
                                                def arg = heap_get(expr.args, i);
                                                def part = self._compile_expr(arg);
                                                def _ = __extend(instructions, part);
                                                i = i + 1;
                                            }
                                            def _unused31 = Collections.push(instructions, Instruction(OPCODE_CALL, new[expr.name, len(expr.args)]));
                                            result = instructions;
                                            handled = true;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if (!handled) {
            def __unsupported = __raise_not_implemented("native codegen does not yet support expression " + __to_str(tag));
        }
        return result;
    }

    fn _next_tmp(self) {
        self.tmp_index = self.tmp_index + 1;
        return "__tmp_heap_" + __to_str(self.tmp_index);
    }
}

fn NativeCodeGenerator() {
    return new NativeCodeGenerator { allow_heap: false; tmp_index: 0 };
}
