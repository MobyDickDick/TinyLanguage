// TinyLanguage stdlib: datetime module (Python-style subset)

fn datetime_isoformat(year, month, day, hour, minute, second) {
  def allow = new[
    "datetime_isoformat",
    "date_isoformat",
    "time_isoformat",
    "timedelta_total_seconds"
  ];
  def args = new[year, month, day, hour, minute, second];
  def result = Python.call(
    "stdlib_datetime",
    "datetime_isoformat",
    args,
    { allow: allow }
  );
  def _cleanup_args = delete(args);
  def _cleanup_allow = delete(allow);
  return result;
}

