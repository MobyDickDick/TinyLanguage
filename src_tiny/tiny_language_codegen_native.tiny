// TinyLanguage-Port von src/tiny_language_codegen_native.py
// Native Code Generator for a small stack-based bytecode.

// Opcode + IR definitions are expected from native_ir.tiny

define __PY_EXEC_ALLOW = new["exec"];
define __PY_REPR_ALLOW = new["repr"];
define __PY_FLOAT_ALLOW = new["float"];
define __PY_INT_ALLOW = new["int"];
define __PY_STR_ALLOW = new["str"];

fn __to_str(value) {
    return Python.call("builtins", "str", new[value], __PY_STR_ALLOW);
}

fn __raise_not_implemented(msg) {
    define safe = Python.call("builtins", "repr", new[msg], __PY_REPR_ALLOW);
    define stmt = "raise NotImplementedError(" + safe + ")";
    return Python.call("builtins", "exec", new[stmt], __PY_EXEC_ALLOW);
}

fn __parse_number(txt) {
    if (String.contains(txt, ".")) {
        return Python.call("builtins", "float", new[txt], __PY_FLOAT_ALLOW);
    }
    return Python.call("builtins", "int", new[txt], __PY_INT_ALLOW);
}

fn __tag_of(value) {
    if (value == Null) { return ""; }
    return Map.get(value, "__tag__", "");
}

fn __extend(target, items) {
    define i = 0;
    while (i < len(items)) {
        define _ = Collections.push(target, heap_get(items, i));
        i = i + 1;
    }
    return target;
}

class NativeCodeGenerator {
    fn compile_program(self, stmts) {
        define functions = Map.new();
        define entry = new[];

        define i = 0;
        while (i < len(stmts)) {
            define stmt = heap_get(stmts, i);
            if (stmt.__tag__ == "Fn") {
                define fn_ir = self._compile_function(stmt);
                define _ = Map.set(functions, stmt.name, fn_ir);
            } else {
                define raw = self._compile_stmt(stmt);
                define shifted = self._shift_labels(raw, len(entry));
                define _ = __extend(entry, shifted);
            }
            i = i + 1;
        }

        define _ = Collections.push(entry, Instruction(OPCODE_RETURN, Null));
        return ProgramIR(entry, functions);
    }

    fn _compile_function(self, fn_node) {
        define body = new[];
        define i = 0;
        while (i < len(fn_node.body)) {
            define stmt = heap_get(fn_node.body, i);
            define raw = self._compile_stmt(stmt);
            define shifted = self._shift_labels(raw, len(body));
            define _ = __extend(body, shifted);
            i = i + 1;
        }
        define _ = Collections.push(body, Instruction(OPCODE_RETURN, Null));

        define params = new[];
        define j = 0;
        while (j < len(fn_node.params)) {
            define param = heap_get(fn_node.params, j);
            define _ = Collections.push(params, param.name);
            j = j + 1;
        }
        return FunctionIR(fn_node.name, params, body);
    }

    fn _shift_labels(self, instructions, offset) {
        define shifted = new[];
        define i = 0;
        while (i < len(instructions)) {
            define instr = heap_get(instructions, i);
            if ((instr.op == OPCODE_JUMP || instr.op == OPCODE_JUMP_IF_FALSE) && instr.arg != Null) {
                define _ = Collections.push(shifted, Instruction(instr.op, instr.arg + offset));
            } else {
                define _ = Collections.push(shifted, instr);
            }
            i = i + 1;
        }
        return shifted;
    }

    fn _compile_stmt(self, stmt) {
        define result = new[];
        define handled = false;
        define tag = __tag_of(stmt);
        if (tag == "Let") {
            result = self._compile_binding(stmt.name, stmt.expr);
            handled = true;
        } else {
            if (tag == "Assign") {
                result = self._compile_binding(stmt.name, stmt.expr);
                handled = true;
            } else {
                if (tag == "Print") {
                    define instructions = new[];
                    define i = 0;
                    while (i < len(stmt.exprs)) {
                        define expr = heap_get(stmt.exprs, i);
                        define part = self._compile_expr(expr);
                        define _ = __extend(instructions, part);
                        i = i + 1;
                    }
                    define _ = Collections.push(instructions, Instruction(OPCODE_PRINT, len(stmt.exprs)));
                    result = instructions;
                    handled = true;
                } else {
                    if (tag == "Flush") {
                        define instructions = new[];
                        define _ = Collections.push(instructions, Instruction(OPCODE_FLUSH, Null));
                        result = instructions;
                        handled = true;
                    } else {
                        if (tag == "If") {
                            result = self._compile_if(stmt);
                            handled = true;
                        } else {
                            if (tag == "While") {
                                result = self._compile_while(stmt);
                                handled = true;
                            } else {
                                if (tag == "Return") {
                                    define instructions = self._compile_expr(stmt.expr);
                                    define _ = Collections.push(instructions, Instruction(OPCODE_RETURN, Null));
                                    result = instructions;
                                    handled = true;
                                } else {
                                    if (tag == "CallStmt") {
                                        define instructions = self._compile_expr(Call(stmt.name, stmt.args, stmt.pos, stmt.span));
                                        define _ = Collections.push(instructions, Instruction(OPCODE_POP, Null));
                                        result = instructions;
                                        handled = true;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if (!handled) {
            define _unsupported = __raise_not_implemented("native codegen does not yet support " + __to_str(tag));
        }
        return result;
    }

    fn _compile_if(self, stmt) {
        define instructions = self._compile_expr(stmt.cond);
        define jump_false_index = len(instructions);
        define _ = Collections.push(instructions, Instruction(OPCODE_JUMP_IF_FALSE, Null));

        define then_block = new[];
        define i = 0;
        while (i < len(stmt.then)) {
            define inner = heap_get(stmt.then, i);
            define nested = self._compile_stmt(inner);
            define shifted = self._shift_labels(nested, len(instructions) + len(then_block));
            define _ = __extend(then_block, shifted);
            i = i + 1;
        }
        define _ = Collections.push(then_block, Instruction(OPCODE_JUMP, Null));

        define else_block = new[];
        define j = 0;
        while (j < len(stmt.els)) {
            define inner = heap_get(stmt.els, j);
            define nested = self._compile_stmt(inner);
            define shifted = self._shift_labels(nested, len(instructions) + len(then_block) + len(else_block));
            define _ = __extend(else_block, shifted);
            j = j + 1;
        }

        define else_start = len(instructions) + len(then_block);
        heap_set(instructions, jump_false_index, Instruction(OPCODE_JUMP_IF_FALSE, else_start));

        define end_of_then = len(instructions) + len(then_block) + len(else_block);
        heap_set(then_block, len(then_block) - 1, Instruction(OPCODE_JUMP, end_of_then));

        define _ = __extend(instructions, then_block);
        define _b = __extend(instructions, else_block);
        return instructions;
    }

    fn _compile_while(self, stmt) {
        define instructions = new[];
        define loop_start = 0;
        define cond_instrs = self._compile_expr(stmt.cond);
        define _ = __extend(instructions, cond_instrs);
        define jump_out_index = len(instructions);
        define _j = Collections.push(instructions, Instruction(OPCODE_JUMP_IF_FALSE, Null));

        define body_instrs = new[];
        define i = 0;
        while (i < len(stmt.body)) {
            define inner = heap_get(stmt.body, i);
            define nested = self._compile_stmt(inner);
            define shifted = self._shift_labels(nested, len(instructions) + len(body_instrs));
            define _ = __extend(body_instrs, shifted);
            i = i + 1;
        }
        define _ = Collections.push(body_instrs, Instruction(OPCODE_JUMP, loop_start));

        define loop_exit = len(instructions) + len(body_instrs);
        heap_set(instructions, jump_out_index, Instruction(OPCODE_JUMP_IF_FALSE, loop_exit));

        define _b = __extend(instructions, body_instrs);
        return instructions;
    }

    fn _compile_binding(self, name, expr) {
        define instructions = self._compile_expr(expr);
        define _ = Collections.push(instructions, Instruction(OPCODE_STORE, name));
        return instructions;
    }

    fn _compile_expr(self, expr) {
        define result = new[];
        define handled = false;
        define tag = __tag_of(expr);
        if (tag == "Num") {
            result = new[Instruction(OPCODE_PUSH_CONST, __parse_number(expr.txt))];
            handled = true;
        } else {
            if (tag == "Str") {
                result = new[Instruction(OPCODE_PUSH_CONST, expr.txt)];
                handled = true;
            } else {
                if (tag == "Bool") {
                    result = new[Instruction(OPCODE_PUSH_CONST, expr.value)];
                    handled = true;
                } else {
                    if (tag == "Null") {
                        result = new[Instruction(OPCODE_PUSH_CONST, Null)];
                        handled = true;
                    } else {
                        if (tag == "Var") {
                            result = new[Instruction(OPCODE_LOAD, expr.name)];
                            handled = true;
                        } else {
                            if (tag == "Bin") {
                                define instructions = self._compile_expr(expr.a);
                                define rhs = self._compile_expr(expr.b);
                                define _ = __extend(instructions, rhs);
                                define _b = Collections.push(instructions, Instruction(OPCODE_BINARY, expr.op));
                                result = instructions;
                                handled = true;
                            } else {
                                if (tag == "Call") {
                                    define instructions = new[];
                                    define i = 0;
                                    while (i < len(expr.args)) {
                                        define arg = heap_get(expr.args, i);
                                        define part = self._compile_expr(arg);
                                        define _ = __extend(instructions, part);
                                        i = i + 1;
                                    }
                                    define _ = Collections.push(instructions, Instruction(OPCODE_CALL, new[expr.name, len(expr.args)]));
                                    result = instructions;
                                    handled = true;
                                }
                            }
                        }
                    }
                }
            }
        }

        if (!handled) {
            define _unsupported = __raise_not_implemented("native codegen does not yet support expression " + __to_str(tag));
        }
        return result;
    }
}

fn NativeCodeGenerator() {
    return new NativeCodeGenerator {};
}
