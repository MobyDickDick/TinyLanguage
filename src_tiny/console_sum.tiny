// Lese zwei Zahlen aus der Konsole, addiere sie und gib das Ergebnis aus.
print("Erste Zahl:");
define first_input = Console.read_line();

print("Zweite Zahl:");
define second_input = Console.read_line();

// Die Eingaben kommen als Strings; JSON.parse wandelt numerische Eingaben in Zahlen um.
define a = JSON.parse(first_input);
define b = JSON.parse(second_input);

print("Summe:", a + b);
