fn lint_return_signatures(stmts, fn_name, is_method, source, _pos) {
    define expected = Null;
    define hint = "Ensure every return statement uses the same tuple/record structure (fields and order).";

    fn visit(block) {
        define i = 0;
        while (i < len(block)) {
            define st = heap_get(block, i);
            define handled = false;
            if (!handled && st.__tag__ == "Return") {
                define sig = _return_signature(st.expr);
                if (expected == Null) { expected = sig; }
                else {
                    if (!__sig_equal(sig, expected)) {
                        define kind = "function";
                        if (is_method) { kind = "method"; }
                        define msg = "inconsistent return signature in " + kind + " " + fn_name + ": expected " + _format_signature(expected) + " but found " + _format_signature(sig);
                        if (source == Null) { __raise_runtime_error(msg); }
                        else { _lint_error(source, st, msg, "E007", hint); }
                    }
                }
                handled = true;
            }
            if (!handled && st.__tag__ == "If") { visit(st.then); visit(st.els); handled = true; }
            if (!handled && st.__tag__ == "While") { visit(st.body); handled = true; }
            if (!handled && st.__tag__ == "Switch") {
                define ci = 0;
                while (ci < len(st.cases)) { visit(heap_get(st.cases, ci).body); ci = ci + 1; }
                handled = true;
            }
            if (!handled && st.__tag__ == "TryCatch") { visit(st.body); visit(st.handler); }
            i = i + 1;
        }
    }

    visit(stmts);
}

fn lint_return_exhaustiveness(stmts, fn_name, expected_return, is_method, source, location) {
    if (expected_return == Null) { return Null; }
    if (_is_optional_annotation(expected_return)) { return Null; }
    if (_block_guarantees_return(stmts)) { return Null; }
    define kind = "function";
    if (is_method) { kind = "method"; }
    define msg = "not all paths in " + kind + " " + fn_name + " return a value for annotated type " + expected_return;
    if (source == Null) { __raise_runtime_error(msg); }
    else { _lint_error(source, location, msg, "E010", "Add return statements for every branch or provide a default return to satisfy the annotation."); }
}

fn lint_unreachable_code(stmts, source) {
    fn visit_block(block) {
        define terminated = false;
        define i = 0;
        while (i < len(block)) {
            define st = heap_get(block, i);
            if (terminated) {
                define msg = "unreachable statement after a return";
