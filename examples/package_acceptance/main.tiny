// Installed application: a locked dependency processes a JSON file in a worker.
import pkg.pricing.transform as transform;
import stdlib.fs;

fn calculate(value) { return transform.apply(value); }

def input = JSON.parse(fs.read_text(OS.getenv("TINY_APP_INPUT")));
def worker = spawn calculate(Map.get(input, "value"));
def result = join(worker);
def arguments = new[result];
def allow = new["sqrt"];
def root = Python.call("math", "sqrt", arguments, allow);
print(root > 0);
def _cleanup_arguments = delete(arguments);
def _cleanup_allow = delete(allow);
def output = Map.new();
def stored_value = Map.set(output, "value", result);
def stored_label = Map.set(output, "label", Map.get(input, "label"));
def written = fs.write_text(OS.getenv("TINY_APP_OUTPUT"), JSON.stringify(output));
def _cleanup_output = delete(output);
print(written && stored_value == result && stored_label == Map.get(input, "label"), result);
