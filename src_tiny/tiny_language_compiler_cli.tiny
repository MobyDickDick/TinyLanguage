// TinyLanguage wrapper for src/tiny_language_compiler_cli.py.
// Delegates compiler CLI handling to the Python implementation.

def tinyc_cli = Python.import_module("tiny_language_compiler_cli", new["main"]);
def os = Python.import_module("os", new["getenv"]);

def __PY_JSON_ALLOW = new["loads"];
def json = Python.import_module("json", __PY_JSON_ALLOW);

fn __argv_from_env() {
    def raw = os.getenv("TINYLANG_ARGS", "");
    def payload = "[]";
    if (raw != Null && len(raw) > 0) { payload = raw; }
    return json.loads(payload);
}

fn main(argv) {
    return tinyc_cli.main(argv);
}

fn run() {
    def code = tinyc_cli.main(__argv_from_env());
    return code;
}

run();
