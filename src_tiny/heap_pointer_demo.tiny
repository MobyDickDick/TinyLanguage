/// heap_pointer_demo.tiny - zeigt sichere Heap-Nutzung und typische Fehlerquellen.
/// Safe Patterns: Pointer taggen, Bounds pruefen bevor heap_get/heap_set, spaetestens nach der Nutzung delete aufrufen.

print("=== Sichere Heap-Nutzung ==="); // Überschrift für den sicheren Teil.

// 1) Pointer anlegen und mit Tag versehen, damit klar ist, was im Heap steckt.
define buffer = new(3); // Reserviert drei Slots auf dem Heap.
tag(buffer, Buffer); // Markiert den Pointer, damit der Typ klar ist.

// Werte setzen: erst Bounds pruefen, dann schreiben.
define buffer_len = Collections.len(buffer); // Fragt die Länge des Buffers ab.
if (buffer_len >= 3) { // Prüft, ob drei Positionen verfügbar sind.
    heap_set(buffer, 0, 10); // Speichert 10 an Position 0.
    heap_set(buffer, 1, 20); // Speichert 20 an Position 1.
    heap_set(buffer, 2, 30); // Speichert 30 an Position 2.
} else { // Falls die Länge nicht reicht ...
    print("Buffer zu klein, Schreiben uebersprungen"); // ... wird nichts geschrieben.
}

// Sicherer Lesezugriff: erst Bounds pruefen, dann lesen.
define read_index = 2; // Index, der gelesen werden soll.
if (read_index < buffer_len) { // Kontrolliert, ob der Index im gültigen Bereich liegt.
    define safe_value = heap_get(buffer, read_index); // Liest den Wert, wenn erlaubt.
    print("Lesewert fuer Index:"); // Überschrift für die folgende Ausgabe.
    print(read_index); // Zeigt den Index an.
    print(safe_value); // Zeigt den gelesenen Wert an.
} else { // Wenn der Index ungültig ist ...
    print("Index ausserhalb der Bounds, nichts zu tun"); // ... wird nur eine Meldung ausgegeben.
}

// Pointer wieder freigeben, wenn er nicht mehr gebraucht wird.
delete(buffer); // Gibt den Heap-Speicher zurück.

print("\n=== Typische Fehlerquellen ==="); // Überschrift für den Fehlertest.
print("Die folgenden Fehlermeldungen sind bewusst provoziert; das Programm laeuft trotzdem weiter und endet erfolgreich.\n"); // Hinweis an Leser:innen.

// 2) Fehlerfall: Out-of-Bounds-Zugriff demonstrieren.
define too_short = new[1, 2]; // Legt einen kurzen Array an.
define ignored_oob = heap_get(too_short, 5); // Runtime-Fehler wird aufgezeichnet
if (false) { print(ignored_oob); } // Zugriff auf das Ergebnis wird unterdrückt, um die Ausführung nicht zu stoppen.

// Fehlermeldung direkt zwischenspeichern, damit sie nicht erneut zusammengesetzt wird.
define oob_error = errorMessage;             // Zuletzt gemeldeter Fehler wird abgelegt
print("Aufgezeichnete Out-of-Bounds-Meldung:"); // Etikett für die Fehlermeldung.
print(oob_error);                            // "heap access error: index 5 out of range ..."

delete(too_short); // Nach Fehlern ebenfalls aufraeumen

// 3) Fehlerfall: Zugriff auf fehlendes Feld.
define record = { existing: 1; }; // Einfaches Objekt mit einem Feld.
define ignored_missing = record.missing; // Meldet "unknown field missing"
if (false) { print(ignored_missing); } // Unterdrückt die Ausgabe, damit der Fehler nur geloggt wird.

define missing_error = errorMessage;     // Nur die aktuellste Fehlermeldung ausgeben
print("Aufgezeichnete Missing-Field-Meldung:"); // Beschriftung für die nächste Ausgabe.
print(missing_error); // Gibt die gespeicherte Meldung aus.
