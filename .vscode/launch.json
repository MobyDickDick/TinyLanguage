 {
  "version": "0.2.0",
  "configurations": [
     {
      "name": "Run all_features.tiny",
      "type": "debugpy",
       "request": "launch",
       "program": "${workspaceFolder}/tiny_language.py",
      "args": ["${workspaceFolder}/all_features.tiny"],
      "console": "integratedTerminal"
    },
     {
       "name": "Python: pytest - tests/test_tiny_language.py",
       "type": "debugpy",
       "request": "launch",
       "module": "pytest",
       "console": "integratedTerminal",
       "args": [
         "tests/test_tiny_language.py",
         "-q"
       ]
    },
    {
      "name": "Python: TinyLanguage Rosetta Fibonacci",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tiny_language.py",
      "console": "integratedTerminal",
      "args": [
        "${workspaceFolder}/rosetta_fibonacci.tiny"
      ]
     }
   ]
 }
}