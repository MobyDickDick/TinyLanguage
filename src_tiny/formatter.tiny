// TinyLanguage wrapper for src/formatter.py.
// Delegates formatting helpers to the Python implementation.

def PY_ALLOW = new["format_source", "format_import"];

def PY = Python.import_module("formatter", PY_ALLOW);

def format_source = PY.format_source;
def format_import = PY.format_import;

def exports = new[format_source, format_import];
