fn __import_sort_key(imp) {
    define alias = "";
    if (imp.alias != Null) { alias = imp.alias; }
    return imp.module + "::" + alias;
}

fn __sorted_imports(imports) {
    define arr = new[];
    define i = 0;
    while (i < len(imports)) { define _ = Collections.push(arr, heap_get(imports, i)); i = i + 1; }
    define n = len(arr);
    define a = 0;
    fn _swap(list, idx_a, idx_b) {
        define out = new[];
        define si = 0;
        while (si < len(list)) {
            if (si == idx_a) {
                define _ = Collections.push(out, heap_get(list, idx_b));
            } else {
                if (si == idx_b) { define _ = Collections.push(out, heap_get(list, idx_a)); }
                else { define _ = Collections.push(out, heap_get(list, si)); }
            }
            si = si + 1;
        }
        return out;
    }
    while (a < n) {
        define b = a + 1;
        while (b < n) {
            define ia = heap_get(arr, a);
            define ib = heap_get(arr, b);
            if (__import_sort_key(ib) < __import_sort_key(ia)) {
                arr = _swap(arr, a, b);
