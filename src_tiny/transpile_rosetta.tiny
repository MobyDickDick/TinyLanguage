// TinyLanguage translation of examples/rosetta/transpile_rosetta.py
// Run with: python src/tiny_language.py src_tiny/from_python/transpile_rosetta.tiny [--dest DIR]

// Python helpers
def os_path = Python.import_module("os.path", new["abspath", "join", "exists"]);
def sys = Python.import_module("sys", new["path", "argv"]);
def builtins = Python.import_module("builtins", new["len", "list", "sorted"]);
def import_refs = new[os_path]; // mark imports as used

fn parse_args() {
    def argv = sys.argv;
    def argc = builtins.len(argv);
    def root = os_path.abspath(".");
    def opts = Map.from_entries(new[
        new["dest", os_path.join(root, "examples", "rosetta", "expected")]
    ]);

    def index = 1;
    while (index < argc) {
        def flag = heap_get(argv, index);
        if (flag == "--dest" && index + 1 < argc) {
            def updated_dest = Map.set(opts, "dest", os_path.abspath(heap_get(argv, index + 1)));
            index = index + 2;
        } else {
            print("Ignoring unknown or incomplete flag:", flag);
            index = index + 1;
        }
    }

    return opts;
}

fn transpile_all(destination) {
    print("Rosetta transpilation via TinyLanguage is not available here. Please run");
    print("python examples/rosetta/transpile_rosetta.py --dest", destination);
    return 0;
}

fn main() {
    def args = parse_args();
    def unused4 = transpile_all(Map.get(args, "dest"));
    return 0;
}

