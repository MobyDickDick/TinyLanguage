// TinyLanguage-Port des Linters aus src/tiny_language_linter.py.
// Aktueller Stand: Gerüst mit API-Signaturen und RuntimeError-Hinweisen, damit
// die Tiny-Selbsthosting-Pipeline frühzeitig nachvollziehbar bleibt. Die
// eigentliche Regel-Logik (Must-Use, Unreachable, Typwechsel usw.) wird
// schrittweise ergänzt und behält die Python-Fehlermeldungen bei.

define __PY_REPR_ALLOW = new["repr"];
define __PY_EXEC_ALLOW = new["exec"];

fn __raise_runtime_error(msg) {
    define safe = Python.call("builtins", "repr", new[msg], __PY_REPR_ALLOW);
    define stmt = "raise RuntimeError(" + safe + ")";
    // Rückgabewert ist irrelevant – der Aufruf löst eine Exception aus.
    return Python.call("builtins", "exec", new[stmt], __PY_EXEC_ALLOW);
}

fn __todo(feature) {
    __raise_runtime_error("Tiny linter port pending: " + feature);
}

