// TinyLanguage wrapper for src/tiny_language_codegen_llvm.py.
// Exposes the LLVM IR code generator via Python interop.

def PY_ALLOW = new["LLVMCodeGenerator"];

def PY = Python.import_module("tiny_language_codegen_llvm", PY_ALLOW);

def LLVMCodeGenerator = PY.LLVMCodeGenerator;

def exports = new[LLVMCodeGenerator];
