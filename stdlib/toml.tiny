// TinyLanguage stdlib: toml module (minimal subset with Python-backed parser)

fn loads(text) -> any {
  return TOML.parse(text);
}

fn dumps(value) -> string {
  return TOML.stringify(value);
}

fn load(path) -> any {
  return TOML.parse(File.read(path));
}

fn dump(path, value) -> string {
  return File.write(path, TOML.stringify(value));
}

fn parse(text) -> any {
  return loads(text);
}

fn stringify(value) -> string {
  return dumps(value);
}

fn validate(text) -> bool {
  return TOML.validate(text);
}
