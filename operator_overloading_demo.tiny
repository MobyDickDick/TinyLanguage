// Operator-Overloading mit einer kleinen Vektor-Klasse
class Point {
    x: number;
    y: number;

    fn to_tuple(self) {
        return new[self.x, self.y];
    }
}

fn Point(x, y) {
    return new Point { x: x; y: y };
}

operator + (a: Point, b: Point) -> Point {
    return Point(a.x + b.x, a.y + b.y);
}

operator == (left: Point, right: Point) -> Bool {
    return left.x == right.x && left.y == right.y;
}

define p = Point(1, 2);
define q = Point(3, 4);

define sum = p + q;
print(heap_get(sum.to_tuple(), 0)); // 4
print(heap_get(sum.to_tuple(), 1)); // 6
print(p == sum); // false
