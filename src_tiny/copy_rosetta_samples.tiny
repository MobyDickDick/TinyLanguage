// TinyLanguage translation of examples/rosetta/copy_rosetta_samples.py
// Run with: python src/tiny_language.py src_tiny/from_python/copy_rosetta_samples.tiny DEST [--source DIR] [--limit N] [--delay SECONDS]

// Python helpers
define os = Python.import_module("os", new["makedirs"]);
define os_path = Python.import_module("os.path", new["abspath", "join", "exists", "basename", "splitext"]);
define glob = Python.import_module("glob", new["glob"]);
define shutil = Python.import_module("shutil", new["copy2"]);
define time = Python.import_module("time", new["sleep"]);
define sys = Python.import_module("sys", new["argv"]);
define builtins = Python.import_module("builtins", new["list", "set", "sorted", "len", "int", "float"]);
define _import_refs = new[shutil, time, os, os_path, glob]; // mark Python helpers as used for the linter

fn list_missing(source_dir, dest_dir) {
    define source_files = builtins.list(glob.glob(os_path.join(source_dir, "*.py")));
    define dest_files = builtins.list(glob.glob(os_path.join(dest_dir, "*.py")));
    define dest_stems = Set.new();

    define i = 0;
    while (i < builtins.len(dest_files)) {
        define path = heap_get(dest_files, i);
        define stem = heap_get(os_path.splitext(os_path.basename(path)), 0);
        define _added_dest = Set.add(dest_stems, stem);
        i = i + 1;
    }

    define missing = builtins.list();
    i = 0;
    while (i < builtins.len(source_files)) {
        define path = heap_get(source_files, i);
        define stem = heap_get(os_path.splitext(os_path.basename(path)), 0);
        if (!Set.has(dest_stems, stem)) {
            define _added_missing = Collections.push(missing, path);
        }
        i = i + 1;
    }

    return builtins.sorted(missing);
}

fn copy_batch(files, dest_dir, limit, delay) {
    define total = builtins.len(files);
    define end = limit;
    if (end > total) { end = total; }

    define copied = builtins.list();
    define idx = 0;
    while (idx < end) {
        define source_path = heap_get(files, idx);
        define destination = os_path.join(dest_dir, os_path.basename(source_path));
        define _copy_result = shutil.copy2(source_path, destination);
        print("copied", os_path.basename(source_path), "->", destination);
        define _copied_entry = Collections.push(copied, source_path);

        if (idx + 1 < end) { time.sleep(delay); }
        idx = idx + 1;
    }

    return copied;
}

fn parse_args() {
    define argv = sys.argv;
    define argc = builtins.len(argv);

    if (argc < 2) {
        print("Usage: copy_rosetta_samples.tiny DEST [--source DIR] [--limit N] [--delay SECONDS]");
        return Map.new();
    }

    define root = os_path.abspath(".");
    define defaults = Map.from_entries(new[
        new["source", os_path.join(root, "examples", "rosetta", "python")],
        new["limit", 10],
        new["delay", 10.0]
    ]);

    define options = Map.new();
    define _set_dest = Map.set(options, "dest", os_path.abspath(heap_get(argv, 1)));
    define _set_source = Map.set(options, "source", Map.get(defaults, "source"));
    define _set_limit = Map.set(options, "limit", Map.get(defaults, "limit"));
    define _set_delay = Map.set(options, "delay", Map.get(defaults, "delay"));

    define index = 2;
    while (index < argc) {
        define flag = heap_get(argv, index);
        if (flag == "--source" && index + 1 < argc) {
            define _updated_source = Map.set(options, "source", os_path.abspath(heap_get(argv, index + 1)));
            index = index + 2;
        } else {
            if (flag == "--limit" && index + 1 < argc) {
                define _updated_limit = Map.set(options, "limit", builtins.int(heap_get(argv, index + 1)));
                index = index + 2;
            } else {
                if (flag == "--delay" && index + 1 < argc) {
                    define _updated_delay = Map.set(options, "delay", builtins.float(heap_get(argv, index + 1)));
                    index = index + 2;
                } else {
                    print("Ignoring unknown or incomplete flag:", flag);
                    index = index + 1;
                }
            }
        }
    }

    return options;
}

fn main() {
    define args = parse_args();
    if (Map.len(args) == 0) { return 1; }

    define dest = Map.get(args, "dest");
    define source = Map.get(args, "source");
    define limit = Map.get(args, "limit");
    define delay = Map.get(args, "delay");

    if (!os_path.exists(source)) {
        print("source directory does not exist:", source);
        return 1;
    }

    if (!os_path.exists(dest)) { define _created_dest = os.makedirs(dest); }
    define missing = list_missing(source, dest);

    if (builtins.len(missing) == 0) {
        print("No missing Python scripts detected; nothing to copy.");
        return 0;
    }

    define copied = copy_batch(missing, dest, limit, delay);
    define remaining = builtins.len(missing) - builtins.len(copied);
    print("Copied", builtins.len(copied), "file(s);", remaining, "still missing.");
    return 0;
}

define _ = main();
