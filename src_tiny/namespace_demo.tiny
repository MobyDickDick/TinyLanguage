// Namespaces group related functions; every line is annotated.
namespace Tools { // Begin namespace block.
    fn double(x) { return x * 2; } // Doubles the input and returns it.
    fn label(x) { return "#" + x; } // Prefixes a string with a hash symbol.
}

def value = Tools.double(5); // Call the namespaced function.
print(value); // Print the doubled result.
print(Tools.label("done")); // Show the label function inside the namespace.
