// Rosetta example computing the nth Fibonacci number iteratively and printing a sample.

fn fibonacci(n) {
    // Return the nth Fibonacci number using an iterative loop.
    if (n <= 1) {
        return n;
    }
    def a = 0;
    def b = 1;
    def i = 2;
    while (i <= n) {
        def temp = a + b;
        a = b;
        b = temp;
        i = i + 1;
    }
    return b;
}

print(fibonacci(6));
