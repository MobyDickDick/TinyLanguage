fn bubble_sort(values) {
    def n = len(values);
    def i = 0;
    while (i < n) {
        def j = 0;
        while (j < n - 1 - i) {
            def left = heap_get(values, j);
            def right = heap_get(values, j + 1);
            if (left > right) {
                heap_set(values, j, right);
                heap_set(values, j + 1, left);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return values;
}

fn print_list(values) {
    def i = 0;
    while (i < len(values)) {
        print(heap_get(values, i));
        i = i + 1;
    }
}

def numbers = new[5, 1, 4, 2, 8];
def sorted_numbers = bubble_sort(numbers);
def _ = print_list(sorted_numbers);
