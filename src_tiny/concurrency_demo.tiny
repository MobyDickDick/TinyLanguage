/// concurrency_demo.tiny - demonstrates spawn/join with String.split and String.join, explained line by line.
fn label(prefix, word) { // Helper that returns a labeled string.
    // Works without the stdlib so the task runs in its own thread.
    return prefix + "=" + word; // Joins prefix and word with an equals sign.
}

// process four parts in parallel
def keywords = String.split("spawn,join,string,interop", ","); // Splits the input string into an array.

def first = spawn label("first", heap_get(keywords, 0)); // Starts the task for the first word.
def second = spawn label("second", heap_get(keywords, 1)); // Starts the task for the second word.
def third = spawn label("third", heap_get(keywords, 2)); // Starts the task for the third word.
def fourth = spawn label("fourth", heap_get(keywords, 3)); // Starts the task for the fourth word.

def first_result = join(first); // Waits for the first task's result.
def second_result = join(second); // Waits for the second task's result.
def third_result = join(third); // Waits for the third task's result.
def fourth_result = join(fourth); // Waits for the fourth task's result.

def annotated = new(4); // Preallocate a fixed-size array for all results.
def _ = heap_set(annotated, 0, first_result);
def _ = heap_set(annotated, 1, second_result);
def _ = heap_set(annotated, 2, third_result);
def _ = heap_set(annotated, 3, fourth_result);

print("labels"); // Header for the output.
print(String.join(annotated, " | ")); // Joins the annotated strings and prints them.

// repeat split/join on the combined result
print("as list"); // Second header for clarity.
def parts_again = String.split(String.join(annotated, ";"), ";"); // Splits the combined string again.
print(String.join(parts_again, " -> ")); // Connects the second list with arrows between entries.
